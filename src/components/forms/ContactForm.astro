---
const {
    title = "SAY HELLO",
    subtitle = "Have a question, idea, or opportunity? Send us a message.",
} = Astro.props;
---

<div id="contact" class="contact-form-container">
    <div class="header-group">
        <h2 class="form-title">{title}</h2>
        <p class="form-subtitle" style="color: var(--color-accent);">
            {subtitle}
        </p>
    </div>

    <form id="contact-form" class="contact-form" action="#" method="POST">
        <div class="input-group">
            <div class="input-wrapper">
                <label for="name">NAME</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    class="input-shape-rounded"
                    required
                    placeholder=" "
                />
            </div>

            <div class="input-wrapper">
                <label for="email">EMAIL</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="input-shape-rounded"
                    required
                    placeholder=" "
                />
            </div>

            <div class="input-wrapper message-wrapper">
                <label for="message">MESSAGE</label>
                <textarea id="message" name="message" class="input-shape-rounded" required placeholder=" "
                ></textarea>
            </div>
        </div>

        <button type="submit" class="submit-btn">SEND</button>
    </form>
</div>

<style>
    .contact-form-container {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: clamp(24px, 4vw, 48px); /* Fluid padding */
        gap: 25px;
        width: 100%;
        max-width: 100%; /* Let parent control width */
        height: auto;
        background: var(--bg-card);
        border: 1px solid var(--text-main);
        box-shadow: var(--shadow-sm);
        border-radius: var(--radius-card);
        font-family: var(--font-body);
    }

    .header-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0px;
        gap: 4px;
        width: 100%;
        margin-bottom: 24px;
    }

    .form-title {
        font-family: var(--font-heading);
        font-style: normal;
        font-weight: var(--weight-regular);
        font-size: clamp(32px, 3vw, 48px); /* Fluid Title */
        line-height: 1.1;
        display: flex;
        align-items: center;
        text-align: center;
        color: var(--text-main);
        margin: 0;
        width: 100%;
        justify-content: flex-start;
    }

    .form-subtitle {
        font-size: clamp(14px, 1vw, 18px); /* Fluid Subtitle */
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0px;
        gap: 24px;
        width: 100%;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 0px;
        gap: 24px; /* Increased gap */
        width: 100%;
    }

    .input-wrapper {
        position: relative;
        width: 100%;
        height: auto; /* Allow natural height */
        display: flex;
        flex-direction: column;
        gap: 8px; /* Gap between label and input */
    }

    .message-wrapper {
        height: auto;
    }

    input,
    textarea {
        box-sizing: border-box;
        position: relative; /* Not absolute */
        width: 100%;
        height: clamp(46px, 4vw, 64px); /* Fluid Input Height */
        left: auto;
        top: auto;
        font-family: var(--font-body);
        font-size: clamp(16px, 1.2vw, 20px); /* Fluid Font */
        --field-padding-block: 10px;
        --field-padding-inline: 10px;
    }

    /* Message specific height */
    textarea {
        height: clamp(122px, 10vw, 200px); /* Fluid Textarea Height */
        resize: vertical;
    }

    label {
        position: relative; /* Not absolute */
        width: auto;
        height: auto;
        left: auto;
        top: auto;
        font-family: var(--font-body);
        font-style: normal;
        font-weight: var(--weight-regular);
        font-size: clamp(13px, 1vw, 16px); /* Fluid Label */
        line-height: 1.4;
        display: flex;
        align-items: center;
        text-align: left;
        color: var(--input-text);
        pointer-events: none;
    }

    .submit-btn {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 17px 29px;
        width: 130px;
        height: 55px;
        background: var(--btn-bg-primary);
        border-radius: var(--radius-pill);
        border: none;
        cursor: pointer;
        margin-top: 0px;
        align-self: flex-start;

        font-family: var(--font-body);
        font-style: normal;
        font-weight: var(--weight-semibold);
        font-size: 15px;
        line-height: 17px;
        text-align: center;
        letter-spacing: 2px;
        color: var(--btn-text-primary);
        white-space: nowrap;
        transition: transform 0.1s ease;
    }

    .submit-btn:hover {
        transform: scale(1.02);
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    @media (max-width: 480px) {
        .contact-form-container {
            padding: 24px;
        }

        .header-group,
        .form-title,
        .form-subtitle {
            align-items: center;
            text-align: center;
            width: 100%;
            justify-content: center;
        }

        .submit-btn {
            align-self: center;
        }
    }
</style>
