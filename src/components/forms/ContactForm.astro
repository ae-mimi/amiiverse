---
import BusinessContactForm from "./contact/BusinessContactForm.astro";

const {
    title = "SAY HELLO",
    subtitle = "Have a question, idea, or opportunity? Send us a message.",
    successRedirect = "/contact-success",
    subject = "Business Contact Inquiry",
} = Astro.props;
---

<BusinessContactForm
    title={title}
    subtitle={subtitle}
    successRedirect={successRedirect}
    subject={subject}
/>
