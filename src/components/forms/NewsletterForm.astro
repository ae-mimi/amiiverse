---

<section id="newsletter" class="form-section">
    <!-- Form Card -->
    <div class="form-card">
        <!-- Headline -->
        <div class="form-header">
            <h2 class="form-title">JOIN THE AMII-GOS</h2>
            <p class="form-subtitle">
                Get early access, updates, and behind-the-scenes
            </p>
        </div>

        <!-- Form -->
        <form class="newsletter-form">
            <!-- Name Input -->
            <div class="input-group">
                <label for="name">NAME</label>
                <input type="text" id="name" name="name" />
            </div>

            <!-- Email Input -->
            <div class="input-group">
                <label for="email">EMAIL</label>
                <input type="email" id="email" name="email" />
            </div>

            <!-- Button -->
            <button type="submit" class="submit-btn"> JOIN US </button>
        </form>
    </div>
</section>

<script>
    const forms = document.querySelectorAll("form.newsletter-form");

    forms.forEach((form) => {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formEl = e.target as HTMLFormElement;
            const input = formEl.querySelector(
                'input[name="email"]',
            ) as HTMLInputElement;
            // Privacy checkbox might not be in this specific form, but keeping logic generic
            const privacyCheckbox = formEl.querySelector(
                'input[name="privacy"]',
            ) as HTMLInputElement;
            const button = formEl.querySelector("button") as HTMLButtonElement;
            const originalText = button.innerText;

            if (!input || !button) return;

            if (privacyCheckbox && !privacyCheckbox.checked) {
                alert("Please agree to the Privacy Policy.");
                return;
            }

            button.disabled = true;
            button.innerText = "...";

            const formData = new FormData();
            formData.append("email", input.value);

            try {
                const response = await fetch("/api/subscribe", {
                    method: "POST",
                    body: formData,
                });

                const result = await response.json();

                if (response.ok) {
                    // Success!
                    window.location.href = "/newsletter-success";
                } else {
                    alert(result.message || "Subscription failed.");
                    button.disabled = false;
                    button.innerText = originalText;
                }
            } catch (error) {
                console.error("Error:", error);
                alert("Network error.");
                button.disabled = false;
                button.innerText = originalText;
            }
        });
    });
</script>
<style>
    .form-section {
        width: 100%;
        max-width: 2560px; /* Match global cap */
        margin: 0 auto;
        border-top: 2px solid var(--text-main);
        display: flex;
        justify-content: center;
        padding: 64px 0;
    }

    .form-card {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: clamp(48px, 5vw, 80px); /* More breathing room */
        gap: clamp(16px, 2vw, 32px); /* larger gap */
        width: 100%;
        max-width: clamp(640px, 40vw, 1000px); /* Fluid Card Width */
        background: var(--bg-card);
        border: 1px solid var(--text-main);
        box-shadow: var(--shadow-sm);
        border-radius: var(--radius-card);
        position: relative;
    }

    .form-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 4px;
    }

    .form-title {
        margin: 0;
        font-family: var(--font-heading), sans-serif;
        font-weight: var(--weight-black);
        font-size: clamp(36px, 3vw, 72px); /* Fluid Title */
        line-height: 1.1;
        color: var(--text-main);
    }

    .form-subtitle {
        margin: 0;
        font-family: var(--font-body), sans-serif;
        font-weight: var(--weight-regular);
        font-size: clamp(12px, 1vw, 20px); /* Fluid Subtitle */
        line-height: 1.5;
        color: var(--text-accent);
    }

    .newsletter-form {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(16px, 1.5vw, 24px); /* Fluid form gap */
        width: 100%;
        max-width: 80%; /* Allow form to be reasonably wide within card */
    }

    .input-group {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .input-group label {
        font-family: var(--font-body);
        font-size: clamp(12px, 1vw, 18px);
        color: var(--text-main);
        font-weight: var(--weight-regular);
    }

    .input-group input {
        width: 100%;
        height: clamp(44px, 4vw, 64px); /* Taller inputs */
        background: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: var(--radius-sm);
        padding: 0 1rem;
        font-family: var(--font-body);
        font-size: clamp(16px, 1.2vw, 24px); /* Fluid Input Text */
        color: var(--input-text);
        outline: none;
        box-sizing: border-box;
        transition: border-width 0.1s;
    }

    .input-group input:focus {
        border-width: 2px;
    }

    .submit-btn {
        display: flex;
        justify-content: center;
        align-items: center;
        width: clamp(130px, 10vw, 200px); /* Wider button */
        height: clamp(55px, 4vw, 70px); /* Taller button */
        background: var(--btn-bg-primary);
        border-radius: var(--radius-pill);
        border: none;
        cursor: pointer;
        margin-top: 10px;
        padding: 17px 29px;
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: 15px;
        letter-spacing: 2px;
        color: var(--btn-text-primary);
        text-transform: uppercase;
        white-space: nowrap;
        transition: transform 0.1s;
    }

    .submit-btn:hover {
        transform: scale(1.02);
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    @media (max-width: 768px) {
        .form-card {
            width: 90%;
            padding: 24px;
            min-height: auto;
        }
    }
</style>
