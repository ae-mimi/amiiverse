---
interface Props {
    class?: string;
    variant?: "default" | "primary" | "outline";
}

const { class: className, variant = "default" } = Astro.props;
---

<div class={`card variant-${variant} ${className}`}>
    <slot />
</div>

<style>
    .card {
        border-radius: var(--radius-card);
        padding: var(--space-md);
        background-color: var(--bg-card, transparent);
        border: 2px solid currentColor;
        /* Default behavior: transparent bg, border matches text color */
    }

    /* Variants if needed later */
    .variant-primary {
        background-color: var(--color-primary);
        color: var(--color-secondary);
        border: none;
    }
</style>
