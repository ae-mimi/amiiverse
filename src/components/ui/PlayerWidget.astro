---
import { Icon } from "astro-icon/components";

const { track: propTrack } = Astro.props;

// Fallback / Placeholder if no data provided from CMS
const defaultTrack = {
    title: "Ordinary People - amii",
    credits: {
        lyrics: "BASI",
        prod: "DeBola",
        performed: "MO, BASI, NINAH",
    },
    cover: "/assets/uploads/Ordinary_People_Cover_Art.png",
    spotify: "#",
    apple_music: "#",
    youtube_music: "#",
};

import { urlFor } from "../../utils/sanity";

// Map CMS data to component structure
const track = propTrack
    ? {
          title: propTrack.title || defaultTrack.title,
          credits: {
              lyrics: propTrack.lyrics || "",
              prod: propTrack.producer || "",
              performed: propTrack.performed_by || "",
          },
          cover: propTrack.cover ? urlFor(propTrack.cover) : defaultTrack.cover,
          spotify: propTrack.spotify || defaultTrack.spotify,
          apple_music: propTrack.apple_music || defaultTrack.apple_music,
          youtube_music: propTrack.youtube_music || defaultTrack.youtube_music,
      }
    : defaultTrack;
---

<div class="music-player-container">
    <div class="streaming-links">
        <a href={track.spotify} target="_blank" class="btn-spotify">
            <span>LISTEN ON SPOTIFY</span>
        </a>
        <a href="#" class="btn-platforms">
            <span>SEE ALL PLATFORMS</span>
        </a>
    </div>

    <div class="player-card">
        <div class="player-left">
            <div class="album-art">
                <img src={track.cover} alt={track.title} draggable="false" />
            </div>

            <div class="controls-wrapper">
                <div class="controls">
                    <button class="ctrl-btn prev" aria-label="Previous">
                        <Icon name="lucide:skip-back" />
                    </button>
                    <button class="ctrl-btn play" aria-label="Play">
                        <Icon name="lucide:play" />
                    </button>
                    <button class="ctrl-btn next" aria-label="Next">
                        <Icon name="lucide:skip-forward" />
                    </button>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: 30%"></div>
                    <div class="progress-thumb" style="left: 30%"></div>
                </div>
                <div class="timestamps">
                    <span>0:45</span>
                    <span>2:30</span>
                </div>
            </div>
        </div>

        <div class="player-info">
            <h3 class="track-title">{track.title}</h3>

            <div class="credits-section">
                <h4>Credits</h4>
                <div class="credits-text">
                    <p>Lyrics: {track.credits.lyrics}</p>
                    <p>Prod. by: {track.credits.prod}</p>
                    <p>Performed by: {track.credits.performed}</p>
                </div>
            </div>

            <div class="platform-icons">
                <a href={track.spotify} target="_blank" aria-label="Spotify">
                    <Icon name="simple-icons:spotify" />
                </a>
                <a
                    href={track.apple_music}
                    target="_blank"
                    aria-label="Apple Music"
                >
                    <Icon name="simple-icons:apple" />
                </a>
                <a
                    href={track.youtube_music}
                    target="_blank"
                    aria-label="YouTube Music"
                >
                    <Icon name="simple-icons:youtubemusic" />
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .music-player-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        width: 100%;
        max-width: 1280px;
        margin-inline: auto;
        padding-block: 2rem;
    }

    .streaming-links {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        justify-content: center;
    }

    .btn-spotify,
    .btn-platforms {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 17px 29px;
        height: 55px;
        border-radius: 13px;
        text-decoration: none;
        font-family: "Archivo", sans-serif;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 2px;
        text-transform: uppercase;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn-spotify {
        background: #15499d;
        color: #fdf38a;
        box-shadow: 0 4px 10px rgba(21, 73, 157, 0.3);
    }

    .btn-platforms {
        background: transparent;
        color: #15499d;
        border: 1px solid transparent;
    }

    .btn-spotify:hover,
    .btn-platforms:hover {
        transform: translateY(-2px);
    }

    .btn-spotify:active,
    .btn-platforms:active {
        transform: translateY(0);
    }

    .player-card {
        display: flex;
        flex-direction: column;
        gap: 40px;
        padding: 34px;
        background: rgba(136, 136, 136, 0.16);
        box-shadow: 0px 4px 4px rgba(0, 0, 0, 0.25);
        border-radius: 15px;
        backdrop-filter: blur(10px);
        width: 100%;
        width: 100%;
        max-width: 1000px; /* Increased for wider screens */
        align-items: center;
    }

    @media (min-width: 768px) {
        .player-card {
            flex-direction: row;
            align-items: flex-start;
            justify-content: center;
            gap: 50px;
        }
    }

    .player-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
        width: 100%;
        max-width: 300px;
    }

    .album-art {
        width: 100%;
        aspect-ratio: 1;
        border-radius: 15px;
        overflow: hidden;
        box-shadow:
            0px 6px 10px 4px rgba(0, 0, 0, 0.15),
            0px 2px 3px rgba(0, 0, 0, 0.3);
        background-color: #ddd;
    }

    .album-art img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .controls-wrapper {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 32px;
        position: relative;
        height: 48px;
    }

    .ctrl-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #15499d;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.1s;
        padding: 0;
    }

    .ctrl-btn:hover {
        transform: scale(1.1);
    }

    .ctrl-btn:active {
        transform: scale(0.95);
    }

    .ctrl-btn.prev,
    .ctrl-btn.next {
        font-size: 24px;
        width: 24px;
    }

    .ctrl-btn.play {
        font-size: 32px;
        width: 32px;
    }

    [data-icon] {
        width: 1em;
        height: 1em;
    }

    .progress-bar {
        width: 100%;
        height: 4px;
        background: #f5f3e9;
        border-radius: 8px;
        position: relative;
        cursor: pointer;
    }

    .progress-fill {
        height: 100%;
        background: #15499d;
        border-radius: 8px;
    }

    .progress-thumb {
        position: absolute;
        top: 50%;
        width: 12px;
        height: 12px;
        background: #15499d;
        border-radius: 50%;
        transform: translate(-50%, -50%);
    }

    .timestamps {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #15499d;
        font-weight: 600;
        opacity: 0.8;
    }

    .player-info {
        display: flex;
        flex-direction: column;
        gap: 24px;
        text-align: center;
        padding-top: 20px;
    }

    @media (min-width: 768px) {
        .player-info {
            text-align: left;
            padding-top: 40px;
        }
    }

    .track-title {
        font-family: "Archivo", sans-serif;
        font-weight: 600;
        font-size: 26px;
        line-height: 1.2;
        color: #15499d;
    }

    .credits-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .credits-section h4 {
        font-family: "Archivo", sans-serif;
        font-weight: 600;
        font-size: 19px;
        color: #15499d;
    }

    .credits-text {
        font-family: "Archivo", sans-serif;
        font-size: 15px;
        line-height: 1.6;
        color: #15499d;
    }

    .credits-text p {
        margin: 0;
    }

    .platform-icons {
        display: flex;
        gap: 16px;
        margin-top: auto;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .platform-icons {
            justify-content: flex-start;
        }
    }

    .platform-icons a {
        color: #15499d;
        font-size: 24px;
        transition:
            color 0.2s,
            transform 0.2s;
    }

    .platform-icons a:hover {
        color: #e44598;
        transform: translateY(-2px);
    }
</style>
