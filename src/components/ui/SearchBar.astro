---
---

<div class="header-search" data-search-root>
    <label class="srOnly" for="site-search-input">Search products</label>
    <input
        id="site-search-input"
        class="header-search-input input-shape-pill"
        type="search"
        placeholder="Search products"
        autocomplete="off"
    />
    <div class="header-search-results" data-search-results hidden></div>
</div>

<script>
    import typesenseClient from "../../lib/search/typesenseClient";
    import { PRODUCTS_COLLECTION } from "../../lib/search/collections";

    const root = document.querySelector("[data-search-root]") as HTMLElement | null;
    const input = document.getElementById(
        "site-search-input",
    ) as HTMLInputElement | null;
    const results = root?.querySelector(
        "[data-search-results]",
    ) as HTMLElement | null;

    let debounceTimer: number | null = null;

    function trackAnalyticsEvent(name: string, props: Record<string, unknown> = {}) {
        if (typeof window === "undefined") return;
        window.dispatchEvent(
            new CustomEvent("analytics:event", {
                detail: { name, props },
            }),
        );
    }

    function closeResults() {
        if (!results) return;
        results.innerHTML = "";
        results.hidden = true;
    }

    function formatPrice(value: number): string {
        const major = Number.isInteger(value) ? value / 100 : value;
        return `₦${major.toLocaleString()}`;
    }

    async function runSearch(query: string) {
        if (!results) return;
        trackAnalyticsEvent("search", { query });
        let items: any[] = [];
        try {
            const response = (await typesenseClient.search(PRODUCTS_COLLECTION, {
                q: query,
                query_by: "title,description,tags",
                per_page: "6",
            })) as any;
            items = Array.isArray(response?.hits)
                ? response.hits.map((hit: any) => hit?.document).filter(Boolean)
                : [];
        } catch (error) {
            console.error("[search] Typesense query failed", error);
            items = [];
        }

        if (!items.length) {
            results.innerHTML =
                '<p class="search-empty text-xs text-secondary mb-0">No products found.</p>';
            results.hidden = false;
            return;
        }

        results.innerHTML = items
            .map(
                (item) => `
                    <a class="search-item" href="/shop/${item.handle}">
                        <img src="${item.thumbnail || ""}" alt="${item.title}" />
                        <span class="search-item-copy">
                            <strong>${item.title}</strong>
                            <small>${formatPrice(item.price)}</small>
                        </span>
                    </a>
                `,
            )
            .join("");
        results.hidden = false;
    }

    if (input && results) {
        input.addEventListener("input", () => {
            const query = input.value.trim();
            if (!query) {
                closeResults();
                return;
            }

            if (debounceTimer) window.clearTimeout(debounceTimer);
            debounceTimer = window.setTimeout(() => {
                runSearch(query);
            }, 220);
        });

        document.addEventListener("click", (e) => {
            const target = e.target as Node;
            if (!root?.contains(target)) closeResults();
        });
    }
</script>

<style>
    .header-search {
        position: relative;
        min-width: 220px;
    }

    .header-search-input {
        width: 100%;
        font-size: 0.85rem;
        --field-padding-block: 8px;
        --field-padding-inline: 14px;
        --field-bg: transparent;
        --field-text-color: var(--text-nav);
        --field-border-color: var(--color-primary);
        --input-focus-ring-color: color-mix(in srgb, var(--color-primary), transparent 75%);
    }

    .header-search-results {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: var(--bg-header);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        padding: 6px;
        z-index: 1200;
        max-height: 320px;
        overflow-y: auto;
    }

    .search-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px;
        border-radius: 8px;
        text-decoration: none;
        color: inherit;
    }

    .search-item:hover {
        background: rgba(0, 0, 0, 0.04);
    }

    .search-item img {
        width: 36px;
        height: 36px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
    }

    .search-item-copy {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .search-item-copy strong {
        font-size: 0.78rem;
        line-height: 1.25;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-item-copy small {
        font-size: 0.72rem;
        opacity: 0.75;
    }

    .search-empty {
        padding: 8px;
    }

    @media (max-width: 1024px) {
        .header-search {
            display: none;
        }
    }
</style>
