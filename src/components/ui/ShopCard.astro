---
interface Props {
    title: string;
    price: string;
    image: string;
    url: string;
    productId: string;
}

const { title, price, image, url, productId } = Astro.props;
---

<div class="shop-card">
    <a href={url} class="card-link">
        <div class="image-wrapper">
            <img src={image} alt={title} class="shop-image" />
        </div>
        <div class="info">
            <h3 class="title">{title}</h3>
            <p class="price">
                {
                    typeof price === "number"
                        ? `₦${price.toLocaleString()}`
                        : price
                }
            </p>
        </div>
    </a>
    <button class="buy-now-btn" data-product-id={productId} data-title={title}>
        BUY NOW
    </button>
</div>

<script>
    const buyBtns = document.querySelectorAll(".buy-now-btn");

    buyBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const button = e.currentTarget as HTMLButtonElement;
            const productId = button.dataset.productId;
            const title = button.dataset.title;

            // Dispatch custom event to open CheckoutModal
            window.dispatchEvent(
                new CustomEvent("open-checkout", {
                    detail: { productId, title },
                }),
            );
        });
    });
</script>

<style>
    .shop-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: var(--text-main);
        transition:
            transform 0.2s ease,
            background-color 0.2s ease;
        background: rgba(255, 255, 255, 0.03);
        padding: 1.5rem;
        border-radius: var(--radius-card);
        border: 1px solid rgba(255, 255, 255, 0.05);
        height: 100%;
    }

    .card-link {
        text-decoration: none;
        color: inherit;
        flex-grow: 1;
    }

    .shop-card:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.06);
    }

    .image-wrapper {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: calc(var(--radius-card) - 8px);
        margin-bottom: 1.5rem;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .shop-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .shop-card:hover .shop-image {
        transform: scale(1.05);
    }

    .info {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .title {
        font-family: var(--font-heading);
        font-size: clamp(18px, 1.5vw, 24px);
        margin: 0 0 0.5rem 0;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        line-height: 1.2;
    }

    .price {
        font-family: var(--font-body);
        font-size: 1.1rem;
        opacity: 0.9;
        font-weight: 600;
        color: var(--color-accent);
    }

    .buy-now-btn {
        background: var(--btn-bg-primary);
        color: var(--btn-text-primary);
        border: none;
        padding: 1rem;
        border-radius: var(--radius-pill);
        font-family: var(--font-heading);
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        transition:
            transform 0.2s,
            filter 0.2s,
            opacity 0.2s;
        letter-spacing: 0.1em;
        width: 100%;
    }

    .buy-now-btn:hover:not(:disabled) {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .buy-now-btn:active:not(:disabled) {
        transform: translateY(0);
    }

    .buy-now-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
