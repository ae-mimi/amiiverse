---
import { getSanityContent } from "../../utils/sanity";
import { generateRamp } from "../../utils/colors";

// Sanity Query to fetch all themes
const THEMES_QUERY = `*[_type == "theme"] {
  name,
  "slug": slug.current,
  "colors": {
    "background": colors.background,
    "text": colors.text,
    "palette": colors.palette[] {
      name,
      hex
    }
  },
  "favicon": favicon.asset->url,
  fontHeading,
  fontBody,
  buttonStyle,
  isActive
}`;

const themes = await getSanityContent(THEMES_QUERY) || [];

// Fallback if no themes exist yet
const defaultThemes = [
    {
        name: "Default",
        slug: "default",
        colors: {
            background: "#FDF38A",
            text: "#15499D",
            accent: "#E44598",
        },
        fontHeading: '"Starbim", sans-serif',
        fontBody: '"Archivo", sans-serif',
        buttonStyle: '999px',
        isActive: true
    }
];

const allThemes = themes.length > 0 ? themes : defaultThemes;
---

<!-- Inject CSS Variables for each theme -->
<style is:global define:vars={{ themes: allThemes }}>
    /* Default Theme Variables (Fallback) */
    :root {
        --bg-page: #FDF38A;
        --color-navy-500: #15499D;
        --color-pink-500: #E44598;
    }

    {
        allThemes.map((theme) => (
            `[data-theme="${theme.slug}"] {
                --bg-page: ${theme.colors.background};
                --text-main: ${theme.colors.text};
                --color-navy-500: ${theme.colors.text}; /* Mapping text to main navy var for now */
                --color-pink-500: ${theme.colors.accent};
                --btn-bg-primary: ${theme.colors.text};
                --btn-text-primary: ${theme.colors.background};
                
                /* Dynamic Typography & Styles */
                --font-heading: ${theme.fontHeading || 'inherit'};
                --font-body: ${theme.fontBody || 'inherit'};
                --radius-pill: ${theme.buttonStyle || '999px'};

                /* Dynamic Palette Ramps */
                ${(() => {
                    if (!theme.colors.palette) return '';
                    
                    return theme.colors.palette.map((color: any) => {
                        const ramp = generateRamp(color.hex);
                        if (!ramp) return '';
                        
                        // Create slug from name (e.g., "Accent 1" -> "accent-1")
                        const slug = color.name.toLowerCase().replace(/\s+/g, '-');
                        
                        return Object.entries(ramp).map(([stop, hex]) => 
                            `--color-${slug}-${stop}: ${hex};`
                        ).join('\n');
                    }).join('\n\n');
                })()}
            }`
        ))
    }
</style>

<script define:vars={{ allThemes }}>
    // Client-side logic for theme switching
    const themeStorageKey = 'selected-theme';
    const defaultTheme = allThemes.find(t => t.isActive) || allThemes[0];
    
    function applyTheme(slug) {
        const theme = allThemes.find(t => t.slug === slug);
        if (!theme) return;

        // 1. Apply data attribute
        document.documentElement.setAttribute('data-theme', slug);

        // 2. Update Favicon
        if (theme.favicon) {
            updateFavicon(theme.favicon);
        }

        // 3. Save to storage
        localStorage.setItem(themeStorageKey, slug);
    }

    function updateFavicon(url) {
        // 1. Update/Add standard icon
        let link = document.querySelector("link[rel~='icon']");
        if (!link) {
            link = document.createElement('link');
            link.rel = 'icon';
            document.head.appendChild(link);
        }
        link.href = url;

        // 2. Remove conflicting hardcoded icons to force browser to use the new one
        // (Optional: You could also update them if you had resized versions)
        document.querySelectorAll("link[rel^='apple-touch-icon']").forEach(el => el.remove());
        document.querySelectorAll("link[rel='manifest']").forEach(el => el.remove());
        
        // 3. Force refresh?
        // Sometimes browsers cache favicons aggressively. 
        // We add a timestamp to force reload if needed, but Sanity URLs usually have versions.
    }

    // Initialize
    const savedTheme = localStorage.getItem(themeStorageKey);
    if (savedTheme) {
        applyTheme(savedTheme);
    } else {
        applyTheme(defaultTheme.slug);
    }

    // Expose switch function globally for the selector
    window.switchTheme = applyTheme;
</script>
