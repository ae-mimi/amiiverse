---
import { urlFor } from "../../lib/sanity/image";
import { Icon } from "astro-icon/components";

const { item } = Astro.props;
---

<div class="music-item">
    <div class="cover-art">
        <img src={urlFor(item.cover)} alt={item.title} loading="lazy" />
    </div>
    <div class="music-info">
        <h3 class="music-title">{item.title}</h3>
        <p class="music-date">
            {
                new Date(item.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                })
            }
        </p>
        {
            item.spotify && (
                <a href={item.spotify} target="_blank" class="spotify-link">
                    <Icon name="simple-icons:spotify" class="icon" />
                    <span>Listen on Spotify</span>
                </a>
            )
        }
    </div>
</div>

<style>
    .music-item {
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: center;
        text-align: center;
    }
    @media (min-width: 768px) {
        .music-item {
            flex-direction: row;
            text-align: left;
            gap: 40px;
        }
    }
    .cover-art img {
        width: 100%;
        max-width: clamp(300px, 30vw, 600px); /* Fluid Cover Art */
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }
    .music-title {
        font-family: var(--font-heading);
        font-size: clamp(32px, 3vw, 64px); /* Fluid Title */
        color: var(--text-main);
        margin: 0 0 10px 0;
    }
    .music-date {
        font-family: var(--font-body);
        font-size: clamp(16px, 1.2vw, 24px); /* Fluid Date */
        color: var(--text-main);
        opacity: 0.8;
        margin-bottom: 20px;
    }
    .spotify-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #1db954;
        color: white;
        padding: 12px 24px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: bold;
        font-size: clamp(16px, 1.2vw, 20px); /* Fluid Button Text */
        transition: transform 0.2s;
    }
    .spotify-link:hover {
        transform: scale(1.05);
    }
    .icon {
        width: 20px;
        height: 20px;
    }
</style>
