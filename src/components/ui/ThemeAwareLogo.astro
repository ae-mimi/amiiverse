---
import { fetchGlobalSettings } from "../../utils/global";

interface Props {
    className?: string;
    alt?: string;
}

const { className = "", alt = "amii Logo" } = Astro.props;
const settings = await fetchGlobalSettings();

const logoNavy =
    settings.site_info?.logo_navy || "/assets/uploads/amii-logo_op-navy.webp";
const logoYellow =
    settings.site_info?.logo_yellow ||
    "/assets/uploads/amii-logo_op-yellow.webp";
---

<div class={`theme-logo-wrapper ${className}`}>
    <img src={logoNavy} alt={alt} class="logo-navy" loading="eager" />
    <img src={logoYellow} alt={alt} class="logo-yellow" loading="eager" />
</div>

<style>
    .theme-logo-wrapper {
        position: relative;
        display: inline-block;
    }

    .theme-logo-wrapper img {
        display: block;
        width: 100%;
        height: auto;
        transition: opacity 0.3s ease;
    }

    /* Default (Sun Mode / Light) -> Show Navy */
    .logo-navy {
        opacity: 1;
    }
    .logo-yellow {
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
    }

    /* Dark Themes -> Show Yellow */
    :global([data-theme="night"]) .logo-navy,
    :global([data-theme="dark"]) .logo-navy {
        opacity: 0;
    }
    :global([data-theme="night"]) .logo-yellow,
    :global([data-theme="dark"]) .logo-yellow {
        opacity: 1;
    }
</style>
