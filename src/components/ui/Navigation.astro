---
const {
    links,
    layout = "row", // "row" | "column"
    theme = "default", // "default" | "inverse"
    class: className,
} = Astro.props;

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
---

<nav class:list={[className, `nav-layout-${layout}`, `nav-theme-${theme}`]}>
    <ul class="nav-list">
        {
            links.map((link: any) => (
                <li class="nav-item">
                    <a
                        href={link.href}
                        class:list={[
                            "nav-link",
                            link.is_special ? "special-link" : "",
                            link.disabled ? "disabled-link" : "",
                            normalizePath(currentPath) ===
                            normalizePath(link.href)
                                ? "active"
                                : "",
                        ]}
                        aria-disabled={link.disabled}
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    /* Base Styles */
    .nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
    }

    .nav-link {
        text-decoration: none;
        transition: all 0.3s ease;
        font-family: var(--font-body);
        font-weight: var(--weight-regular);
        letter-spacing: 2px;
        text-transform: uppercase;
        display: block; /* Ensure hit area */
    }

    .nav-link.disabled-link {
        opacity: 0.5;
        pointer-events: none;
        cursor: default;
    }

    /* Layout Modes */
    .nav-layout-row .nav-list {
        flex-direction: row;
        gap: 40px;
        justify-content: center;
        align-items: center;
    }

    @media (max-width: 1024px) {
        .nav-layout-row .nav-list {
            flex-direction: column;
            gap: 27px;
        }
    }

    .nav-layout-column .nav-list {
        flex-direction: column;
        gap: 27px;
        align-items: center;
        width: 100%;
    }

    /* Theme Modes */

    /* Default Theme (Navy Text, Pink Highlight) */
    .nav-theme-default .nav-link {
        color: var(--color-navy-500); /* Was --text-nav */
        font-size: clamp(12px, 1vw, 20px);
    }

    /* Column specific font size adjustment for mobile if needed */
    .nav-layout-column.nav-theme-default .nav-link {
        font-family: "Archivo", sans-serif; /* Mobile font stack preference */
        font-weight: 400;
        font-size: 14px;
    }

    .nav-theme-default .nav-link:hover {
        color: var(--color-navy-500);
        text-decoration: underline;
        text-decoration-color: var(--color-pink-500);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    .nav-theme-default .nav-link.active,
    .nav-theme-default .nav-link.special-link {
        font-weight: 600;
        color: var(--color-pink-500);
        text-decoration: none;
    }
    .nav-theme-default .nav-layout-column .nav-link.active {
        font-weight: 700; /* Bolder on mobile */
    }

    /* Inverse Theme (Yellow Text, Pink Highlight) - For Footer */
    .nav-theme-inverse .nav-link {
        color: var(--color-yellow-500);
        font-size: clamp(12px, 1vw, 20px);
    }

    .nav-theme-inverse .nav-link:hover {
        font-weight: 600;
        color: var(--color-yellow-500);
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
        text-decoration-color: var(--color-pink-500);
    }

    .nav-theme-inverse .nav-link.active,
    .nav-theme-inverse .nav-link.special-link {
        font-weight: 600;
        color: var(--color-pink-500);
        text-decoration: none;
    }
</style>
