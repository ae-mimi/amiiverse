---
const { links, mode = "header-desktop", class: className } = Astro.props;

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
---

<nav class:list={[className, `nav-${mode}`]}>
    <ul class="nav-list">
        {
            links.map((link: any) => (
                <li class="nav-item">
                    <a
                        href={link.href}
                        class:list={[
                            "nav-link",
                            link.is_special ? "special-link" : "",
                            normalizePath(currentPath) ===
                            normalizePath(link.href)
                                ? "active"
                                : "",
                        ]}
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        align-items: center;
    }

    .nav-link {
        text-decoration: none;
        transition: all 0.3s ease;
    }

    /* --- MODE: Header Desktop --- */
    .nav-header-desktop .nav-list {
        gap: 40px;
    }

    .nav-header-desktop .nav-link {
        font-family: var(--font-body);
        font-weight: var(--weight-regular);
        font-size: clamp(12px, 1vw, 20px);
        letter-spacing: 2px;
        color: var(--text-nav);
        text-transform: uppercase;
    }

    .nav-header-desktop .nav-link:hover,
    .nav-header-desktop .nav-link.active {
        font-weight: 600;
        color: var(--color-pink-500);
    }
    .nav-header-desktop .nav-link:hover {
        color: var(--text-nav);
        text-decoration: underline;
        text-decoration-color: var(--color-pink-500);
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
    }

    /* --- MODE: Header Mobile --- */
    .nav-header-mobile .nav-list {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 27px;
        width: 100%;
        max-width: none;
    }

    .nav-header-mobile .nav-link {
        font-family: "Archivo", sans-serif;
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 2px;
        color: var(--color-navy-500);
        text-transform: uppercase;
        display: flex;
        justify-content: center;
    }

    .nav-header-mobile .nav-link.active {
        font-weight: 700;
        color: var(--color-pink-500);
    }

    /* --- MODE: Footer --- */
    .nav-footer {
        display: contents;
    }

    .nav-footer .nav-list {
        display: contents;
    }

    :global(.footer-links-grid) .nav-footer,
    :global(.footer-links-grid) .nav-list {
        display: contents;
    }
    :global(.footer-links-grid) .nav-item {
        display: contents;
    }

    /* Footer Styles */
    .nav-footer .nav-link {
        font-family: var(--font-body);
        font-weight: var(--weight-regular);
        font-size: clamp(12px, 1vw, 20px);
        letter-spacing: 2px;
        color: var(--color-yellow-500); /* Op-Yellow */
        text-transform: uppercase;
        opacity: 1;
        transition: all 0.3s ease;
    }

    .nav-footer .nav-link:hover {
        font-weight: 600;
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 4px;
        text-decoration-color: var(--color-pink-500);
        color: var(--color-yellow-500);
    }

    .nav-footer .nav-link.active {
        font-weight: 600;
        text-decoration: none;
        color: var(--color-pink-500);
    }

    .nav-footer .nav-link.special-link {
        color: var(--color-pink-500);
    }
</style>
