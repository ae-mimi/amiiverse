---
import { Icon } from "astro-icon/components";
import HeaderBrand from "../navigation/HeaderBrand.astro";
import HeaderSocials from "../navigation/HeaderSocials.astro";
import MobileMenuOverlay from "../navigation/MobileMenuOverlay.astro";
import Navigation from "../navigation/Navigation.astro";
import { fetchGlobalSettings } from "../../lib/siteSettings";

const settings = await fetchGlobalSettings();

const links = (settings.navigationItems || [])
    .filter((item) => item.showInHeader)
    .slice(0, 6)
    .map((item) => {
        const { link, is_special, disabled } = item;
        let href = "#";
        if (link?.type === "internal") href = `/${link.internalRef?.slug || ""}`;
        else if (link?.type === "external") href = link.url || "#";
        else if (link?.type === "email") href = `mailto:${link.url || ""}`;

        return {
            label: link?.label || "Untitled",
            href,
            is_special,
            disabled,
        };
    });

const socials = settings.socials || [];
---

<header class="site-header">
    <div class="header-inner">
        <HeaderBrand logoSrc={settings.site_info?.logo_navy || ""} />

        <div class="main-nav-wrapper">
            <Navigation links={links} layout="row" theme="default" />
        </div>

        <div class="header-actions">
            <HeaderSocials socials={socials} class="header-socials" />

            <button
                id="menu-toggle"
                aria-label="Open Menu"
                aria-expanded="false"
            >
                <div class="icon-container">
                    <Icon name="lucide:menu" class="icon-menu" />
                    <Icon name="lucide:x" class="icon-close" />
                </div>
            </button>
        </div>
    </div>
</header>

<MobileMenuOverlay links={links} socials={socials} />

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        min-height: 84px;
        background-color: var(--bg-header);
        padding: 24px 34px;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        z-index: 1000;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .header-inner {
        width: 100%;
        max-width: 2560px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

    .main-nav-wrapper {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    :global(.logo-link) {
        display: block;
        line-height: 0;
    }

    :global(.header-logo) {
        width: clamp(98px, 6vw, 140px);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    :global(.header-socials) {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    :global(.header-social-links a),
    :global(.mobile-socials a) {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 33px;
        height: 33px;
        color: var(--text-nav, var(--color-primary));
        transition: transform 0.2s, opacity 0.2s;
    }

    :global(.icon-social) {
        width: auto;
        height: 20px;
        transition: transform 0.2s;
    }

    :global(.icon-social:hover) {
        transform: scale(1.2);
    }

    .icon-container {
        position: relative;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-menu,
    .icon-close {
        width: 24px;
        height: 24px;
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: center;
        transition:
            opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
            transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .icon-menu {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }

    .icon-close {
        opacity: 0;
        transform: rotate(-90deg) scale(0.7);
        pointer-events: none;
    }

    #menu-toggle {
        display: none;
        z-index: 1001;
        position: relative;
        background: none;
        border: none;
        padding: 0;
        color: var(--color-primary);
        cursor: pointer;
        transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    #menu-toggle.is-open .icon-menu {
        opacity: 0;
        transform: rotate(90deg) scale(0.7);
    }

    #menu-toggle.is-open .icon-close {
        opacity: 1;
        transform: rotate(0deg) scale(1);
    }

    :global(#mobile-menu-overlay) {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100dvh;
        background-color: var(--color-bg);
        opacity: 0;
        pointer-events: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 27px;
        z-index: 999;
        transition: opacity 0.25s ease;
    }

    :global(#mobile-menu-overlay.is-open) {
        opacity: 1;
        pointer-events: all;
    }

    :global(.mobile-socials) {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }

    @media (max-width: 1024px) {
        :global(.header-socials) {
            display: none;
        }

        .site-header {
            min-height: 54px;
            padding: 16px 8px;
            background-color: var(--color-bg);
        }

        .main-nav-wrapper {
            display: none;
        }

        .header-actions {
            gap: 16px;
        }

        #menu-toggle {
            display: block;
        }
    }
</style>

<script>
    import { initOnAstroPageLoad } from "../../lib/client/init";
    import { initSiteHeader } from "../../lib/client/navigation";

    initOnAstroPageLoad(initSiteHeader);
</script>
