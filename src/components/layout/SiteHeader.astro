---
import { Icon } from "astro-icon/components";

import { fetchGlobalSettings } from "../../utils/global";
const settings = await fetchGlobalSettings();
const links = settings.nav || [];

import Navigation from "../ui/Navigation.astro";
import ThemeAwareLogo from "../ui/ThemeAwareLogo.astro";
---

<header class="site-header">
    <div class="header-inner">
        <!-- Left: Logo -->
        <a href="/" class="logo-link" aria-label="amii Home">
            <ThemeAwareLogo className="header-logo" />
        </a>
    </div>

    <!-- Center: Navbar -->
    <div class="main-nav-wrapper">
        <Navigation links={links} layout="row" theme="default" />
    </div>

    <!-- Right: Actions -->
    <div class="header-actions">
        <!-- Social Icons (Desktop) -->
        <div class="header-socials">
            {
                settings.socials?.map((social) => (
                    <a
                        href={social.url}
                        aria-label={social.platform}
                        target="_blank"
                    >
                        <Icon
                            name={`simple-icons:${social.icon}`}
                            class={`icon-social icon-${social.icon}`}
                        />
                    </a>
                ))
            }
        </div>

        <!-- Mobile Menu Toggle (Contains both icons for perfect alignment) -->
        <button id="menu-toggle" aria-label="Toggle Menu">
            <div class="icon-container">
                <Icon name="lucide:menu" class="icon-menu" />
                <Icon name="lucide:x" class="icon-close" />
            </div>
        </button>
    </div>
</header>

<!-- Mobile Navigation Overlay -->
<div id="mobile-menu-overlay">
    <!-- Close Button Removed (Reused Toggle) -->

    <Navigation
        links={links}
        layout="column"
        theme="default"
        class="mobile-nav"
    />

    <div class="mobile-socials">
        {
            settings.socials?.map((social) => (
                <a
                    href={social.url}
                    aria-label={social.platform}
                    target="_blank"
                >
                    <Icon
                        name={`simple-icons:${social.icon}`}
                        class={`icon-social icon-${social.icon}`}
                    />
                </a>
            ))
        }
    </div>
</div>

<style>
    /* Header Light Mode Layer */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        min-height: 84px;
        background-color: var(--bg-header);
        padding: 24px 34px;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        z-index: 1000;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .site-header.is-hidden {
        transform: translateY(-100%);
    }

    .header-inner {
        width: 100%;
        max-width: 2560px; /* Increased for 4K */
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
    }

    .main-nav-wrapper {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
    }

    .logo-link {
        display: block;
        line-height: 0;
    }

    :global(.header-logo) {
        width: clamp(98px, 6vw, 140px);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .header-socials {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 1024px) {
        .header-socials {
            display: none;
        }
    }

    .header-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 33px;
        height: 33px;
        color: var(--text-nav);
        transition:
            transform 0.2s,
            opacity 0.2s;
    }

    .icon-social {
        width: auto;
        height: 20px;
        transition: transform 0.2s;
    }

    .icon-youtube {
        height: 22px;
        transform: scale(1.1);
    }

    .icon-social:hover {
        transform: scale(1.2);
    }

    .icon-container {
        position: relative;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-menu,
    .icon-close {
        width: 24px;
        height: 24px;
        position: absolute;
        top: 0;
        left: 0;
        transition: opacity 0.3s ease;
    }

    .icon-close {
        opacity: 0;
    }

    /* Mobile Menu Toggle */
    #menu-toggle {
        display: none;
        z-index: 1001;
        position: relative;
    }

    /* Responsive Mobile & Tablet */
    @media (max-width: 1024px) {
        .site-header {
            height: auto;
            min-height: 54px;
            padding: 16px 8px;
            background-color: var(--color-yellow-500);
            border-bottom: none;
        }

        .main-nav-wrapper {
            display: none;
        }

        .header-actions {
            gap: 16px;
        }

        /* 3. Hamburger/Close Toggle */
        #menu-toggle {
            display: block;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            color: var(--color-navy-500);
        }
    }

    /* Mobile Overlay Styles (Global) */
    #mobile-menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--color-yellow-500);
        opacity: 0;
        pointer-events: none;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 27px;
        z-index: 999;
    }

    .mobile-socials {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }

    .mobile-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 33px;
        height: 33px;
        color: var(--color-navy-500);
        transition: transform 0.2s;
    }

    .mobile-socials a:hover {
        transform: scale(1.1);
    }
</style>

<script>
    import { gsap } from "gsap";

    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu-overlay");
    const mobileLinks = document.querySelectorAll(".mobile-nav li");
    const mobileSocials = document.querySelector(".mobile-socials");

    const iconMenu = document.querySelector(".icon-menu");
    const iconClose = document.querySelector(".icon-close");

    let isMenuOpen = false;

    if (menuToggle && mobileMenu) {
        // Create GSAP Timeline
        const tl = gsap.timeline({ paused: true, reversed: true });

        // Animation Definition
        tl.to(mobileMenu, {
            duration: 0.4,
            opacity: 1,
            pointerEvents: "all",
            ease: "power2.inOut",
            display: "flex", // Ensure it's visible for animation
        })
            .to(
                iconMenu,
                {
                    opacity: 0,
                    rotation: 90,
                    duration: 0.2,
                },
                "<",
            )
            .to(
                iconClose,
                {
                    opacity: 1,
                    rotation: 0,
                    duration: 0.2,
                },
                "<",
            )
            .from(
                [mobileLinks, mobileSocials],
                {
                    y: 20,
                    opacity: 0,
                    duration: 0.4,
                    stagger: 0.05,
                    ease: "power2.out",
                },
                "-=0.2",
            );

        // Toggle Logic
        menuToggle.addEventListener("click", () => {
            if (!isMenuOpen) {
                tl.play();
                document.body.style.overflow = "hidden"; // Prevent scrolling
                isMenuOpen = true;
                menuToggle.setAttribute("aria-label", "Close Menu");
            } else {
                tl.reverse();
                document.body.style.overflow = ""; // Restore scrolling
                isMenuOpen = false;
                menuToggle.setAttribute("aria-label", "Open Menu");
            }
        });
    }

    // Smart Sticky Header Logic
    const header = document.querySelector(".site-header") as HTMLElement | null;
    let lastScrollY = window.scrollY;
    let isHeaderHidden = false;

    if (header) {
        const handleScroll = () => {
            const currentScrollY = window.scrollY;

            // Show header if scrolling up or at the very top
            if (currentScrollY < lastScrollY || currentScrollY < 50) {
                if (isHeaderHidden) {
                    header.classList.remove("is-hidden");
                    isHeaderHidden = false;
                }
            }
            // Hide header if scrolling down and past the top threshold
            // AND ensure menu is not open
            else if (
                currentScrollY > lastScrollY &&
                currentScrollY > 100 &&
                !isMenuOpen
            ) {
                if (!isHeaderHidden) {
                    header.classList.add("is-hidden");
                    isHeaderHidden = true;
                }
            }

            lastScrollY = currentScrollY;
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
    }

    // Dynamic Header Height Calculation
    if (header) {
        const updateHeaderHeight = () => {
            const height = header.offsetHeight;
            document.documentElement.style.setProperty(
                "--header-height",
                `${height}px`,
            );
        };

        // Initial calculation
        updateHeaderHeight();

        // Observe resize events
        const resizeObserver = new ResizeObserver(() => {
            updateHeaderHeight();
        });

        resizeObserver.observe(header);
    }
</script>
