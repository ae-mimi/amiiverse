---
import { Icon } from "astro-icon/components";
import { fetchGlobalSettings } from "../../lib/siteSettings";

const settings = await fetchGlobalSettings();
const { businessName, contactEmail, copyright } = settings.footer;

// Process footer links from unified navigationItems
const footerLinks = (settings.navigationItems || [])
    .filter((item) => item.showInFooter)
    .map((item) => {
        const { link, is_special, disabled } = item;
        let href = "#";
        if (link?.type === "internal")
            href = `/${link.internalRef?.slug || ""}`;
        else if (link?.type === "external") href = link.url || "#";
        else if (link?.type === "email") href = `mailto:${link.url || ""}`;

        return {
            label: link?.label || "Untitled",
            href,
            is_special,
            disabled,
        };
    });

const currentYear = new Date().getFullYear();
const copyrightText = (copyright || "© {currentYear} amii<br/>Operated by MAPDY LTD").replace(
    "{currentYear}",
    currentYear.toString(),
);

import Navigation from "../navigation/Navigation.astro";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-main">
            <!-- Logo Section -->
            <div class="footer-brand">
                <a href="/" aria-label="amii Home">
                    {
                        settings.site_info?.logo_yellow && (
                            <img
                                class="logo-img"
                                src={settings.site_info.logo_yellow}
                                alt="amii Logo"
                                loading="lazy"
                                width="120"
                                height="72"
                            />
                        )
                    }
                </a>
            </div>

            <!-- Navigation Section -->
            <Navigation
                links={footerLinks}
                layout="row"
                theme="inverse"
                class="footer-nav"
            />

            <!-- Socials Section -->
            <div class="footer-socials">
                {
                    settings.socials?.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            aria-label={social.platform}
                        >
                            <Icon
                                name={`simple-icons:${social.icon}`}
                                class={`social-icon icon-${social.icon}`}
                            />
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Compliance & Copyright -->
        <div class="footer-bottom">
            <div class="footer-compliance">
                {businessName && <span class="biz-name">{businessName}</span>}
                {
                    contactEmail && (
                        <a href={`mailto:${contactEmail}`} class="biz-email">
                            {contactEmail}
                        </a>
                    )
                }
            </div>
            <div class="footer-copyright">
                <p set:html={copyrightText} />
            </div>
        </div>
    </div>
</footer>

<style is:global>
    /* Base Styles */
    .site-footer {
        width: 100%;
        background-color: var(--bg-footer);
        color: var(--text-footer);
        display: flex;
        justify-content: center;
        padding: 54px 27px;
        box-sizing: border-box;
        transition:
            background-color 0.4s ease,
            color 0.4s ease;
    }

    .site-footer * {
        box-sizing: border-box;
    }

    .site-footer .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 64px;
        width: 100%;
        max-width: 100%;
    }

    .site-footer .footer-main {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
        max-width: 450px;
        margin: 0 auto;
    }

    .site-footer .logo-img {
        width: 60px;
        height: auto;
        aspect-ratio: 98 / 59;
        display: block;
    }

    /* Navigation */
    .site-footer .footer-nav {
        margin-bottom: 0;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .site-footer .footer-links-grid {
        display: flex !important;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 24px;
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100%;
    }

    .site-footer .footer-link-item:nth-child(n) {
        grid-area: auto !important;
        margin: 0;
    }

    .site-footer .footer-nav li {
        margin: 0;
        padding: 0;
    }

    .site-footer .footer-nav li::before {
        content: none !important;
    }

    /* Socials (Base Mobile/Tablet) */
    .site-footer .footer-socials {
        display: flex;
        flex-direction: row;
        gap: 8px;
        justify-content: center;
        align-items: center;
    }

    .site-footer .footer-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 33px;
        height: 33px;
        color: var(--color-secondary); /* was yellow-500 */
        transition:
            transform 0.2s,
            opacity 0.2s;
    }

    .site-footer .footer-socials a:hover {
        transform: scale(1.1);
    }

    .site-footer .social-icon {
        width: 20px;
        height: 20px;
        color: inherit;
    }

    /* Copyright & Compliance */
    .site-footer .footer-bottom {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding-top: 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .site-footer .footer-compliance {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        font-size: 0.85rem;
        opacity: 0.6;
    }

    .site-footer .biz-name {
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .site-footer .biz-email {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s;
    }

    .site-footer .biz-email:hover {
        color: var(--color-accent);
    }

    .site-footer .footer-copyright p {
        font-family: var(--font-body, sans-serif);
        font-weight: 600;
        font-size: clamp(14px, 0.9vw, 18px);
        line-height: 1.4;
        letter-spacing: 1px;
        color: var(--color-secondary);
        opacity: 0.8;
        text-align: center;
        margin: 0;
        transition: color 0.4s ease;
    }

    @media (min-width: 1025px) {
        .site-footer {
            padding: 61px 30px;
        }

        .site-footer .footer-inner {
            max-width: 2560px;
        }

        .site-footer .footer-main {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            border-bottom: none;
            max-width: none;
            position: relative;
        }

        .site-footer .footer-logo {
            margin-bottom: 0;
        }

        .site-footer .logo-img {
            width: clamp(88px, 5vw, 130px);
            height: auto;
        }

        .site-footer .footer-nav {
            margin-bottom: 0;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: auto;
        }

        .site-footer .footer-links-grid {
            flex-direction: row;
            gap: 50px;
            max-width: none;
        }

        .site-footer .footer-socials {
            justify-content: flex-end;
        }

        .site-footer .social-icon {
            width: auto;
            height: 24px;
        }

        .site-footer .icon-youtube {
            height: 26px;
        }
    }

    @media (min-width: 1200px) {
        .site-footer {
            padding: 64px 32px;
        }

        .site-footer .footer-inner {
            max-width: 2560px;
        }

        .site-footer .logo-img {
            width: clamp(120px, 6vw, 160px);
        }

        .site-footer .footer-links-grid {
            gap: 48px;
        }
    }
</style>
