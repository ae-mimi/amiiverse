---
import { Icon } from "astro-icon/components";
import { fetchGlobalSettings } from "../../utils/global";
import "../../styles/components/site-footer.css";

const settings = await fetchGlobalSettings();
const footerLinks = settings.footer.links || [];

const currentYear = new Date().getFullYear();
const copyrightText = settings.footer.copyright.replace(
    "{currentYear}",
    currentYear.toString(),
);

import Navigation from "../ui/Navigation.astro";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-main">
            <!-- Logo Section -->
            <div class="footer-logo">
                <a href="/" aria-label="Amii Home">
                    <img
                        class="logo-img"
                        src={settings.site_info?.logo_yellow ||
                            "/assets/uploads/amii-logo_op-yellow.webp"}
                        alt="Amii Logo"
                        loading="lazy"
                        width="120"
                        height="72"
                    />
                </a>
            </div>

            <!-- Navigation Section -->
            <Navigation
                links={footerLinks}
                layout="row"
                theme="inverse"
                class="footer-nav"
            />

            <!-- Socials Section -->
            <div class="footer-socials">
                {
                    settings.socials?.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            aria-label={social.platform}
                        >
                            <Icon
                                name={`simple-icons:${social.icon}`}
                                class={`social-icon icon-${social.icon}`}
                            />
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copyright">
            <p set:html={copyrightText} />
        </div>
    </div>
</footer>
