---
import { Icon } from "astro-icon/components";
import { getGlobalSettings } from "../../utils/global";

const settings = getGlobalSettings();
const rawFooterLinks = settings.footer.links || [];
const footerLinks = rawFooterLinks.filter((link: any) => {
    if (link.label === "FOLLOW" && !settings.enable_follow_link) {
        return false;
    }
    return true;
});

const currentYear = new Date().getFullYear();
const copyrightText = settings.footer.copyright.replace(
    "{currentYear}",
    currentYear.toString(),
);

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-main">
            <!-- Logo Section -->
            <div class="footer-logo">
                <a href="/" aria-label="Amii Home">
                    <img
                        class="logo-img"
                        src={settings.site_info?.logo_yellow ||
                            "/assets/uploads/amii-logo_op-yellow.webp"}
                        alt="Amii Logo"
                        loading="lazy"
                        width="120"
                        height="72"
                    />
                    <style
                        define:vars={{
                            footerLogoYellow: `url(${settings.site_info?.logo_yellow})`,
                            footerLogoNavy: `url(${settings.site_info?.logo_navy})`,
                        }}
                    ></style>
                </a>
            </div>

            <!-- Navigation Section -->
            <nav class="footer-nav">
                <div class="footer-links-grid">
                    {
                        footerLinks.map((link) => (
                            <div class="footer-link-item">
                                <a
                                    href={link.href}
                                    class:list={[
                                        link.is_special ? "special-link" : "",
                                        normalizePath(currentPath) ===
                                        normalizePath(link.href)
                                            ? "active"
                                            : "",
                                    ]}
                                >
                                    {link.label}
                                </a>
                            </div>
                        ))
                    }
                </div>
            </nav>

            <!-- Socials Section -->
            <div class="footer-socials">
                {
                    settings.socials?.map((social) => (
                        <a
                            href={social.url}
                            target="_blank"
                            aria-label={social.platform}
                        >
                            <Icon
                                name={`simple-icons:${social.icon}`}
                                class={`social-icon icon-${social.icon}`}
                            />
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copyright">
            <p set:html={copyrightText} />
        </div>
    </div>
</footer>

<style is:global>
    /* Base Styles */
    .site-footer {
        width: 100%;
        background-color: var(--bg-footer);
        color: var(--text-footer);
        display: flex;
        justify-content: center;
        padding: 54px 27px;
        box-sizing: border-box;
        transition:
            background-color 0.4s ease,
            color 0.4s ease;
    }

    .site-footer * {
        box-sizing: border-box;
    }

    .footer-copyright p {
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: 15px;
        line-height: 16px;
        letter-spacing: 2px;
        color: var(--text-footer);
        opacity: 0.8;
        text-align: center;
        margin: 0;
        transition: color 0.4s ease;
    }

    .site-footer * {
        box-sizing: border-box;
    }

    .site-footer .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 64px;
        width: 100%;
        max-width: 100%; /* Allow it to fill the container, restricted by footer-main logic */
    }

    .site-footer .footer-main {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 450px; /* Base mobile max-width */
        margin: 0 auto;
    }

    /* Logo */
    .site-footer .footer-logo {
        margin-bottom: 27px;
    }

    .site-footer .logo-img {
        width: 60px;
        height: auto;
        aspect-ratio: 98 / 59;
        display: block;
        /* Sun Mode: Footer is Navy -> Use Yellow Logo */
        content: url("/assets/uploads/amii-logo_op-yellow.webp");
    }

    /* Dark Mode Override: Footer is Yellow -> Use Navy Logo */
    :global([data-theme="deep-dive"]) .site-footer .logo-img {
        content: url("/assets/uploads/amii-logo_op-navy.webp");
    }

    /* Navigation */
    .site-footer .footer-nav {
        margin-bottom: 40px;
        width: 100%;
    }

    .site-footer .footer-links-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr; /* 2 Columns */
        column-gap: 20px;
        row-gap: 32px;
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;
        text-align: center;
        justify-items: center;
    }

    /* Explicit Grid Area Positioning (Mobile/Tablet) */
    .site-footer .footer-link-item:nth-child(1) {
        grid-area: 1 / 1 / 2 / 3; /* Row 1, spans both cols */
        margin-bottom: 8px;
    }
    .site-footer .footer-link-item:nth-child(2) {
        grid-area: 2 / 1 / 3 / 2;
    } /* Col 1, Row 2 */
    .site-footer .footer-link-item:nth-child(3) {
        grid-area: 3 / 1 / 4 / 2;
    } /* Col 1, Row 3 */
    .site-footer .footer-link-item:nth-child(4) {
        grid-area: 4 / 1 / 5 / 2;
    } /* Col 1, Row 4 */
    .site-footer .footer-link-item:nth-child(5) {
        grid-area: 2 / 2 / 3 / 3;
    } /* Col 2, Row 2 */
    .site-footer .footer-link-item:nth-child(6) {
        grid-area: 3 / 2 / 4 / 3;
    } /* Col 2, Row 3 */
    .site-footer .footer-link-item:nth-child(7) {
        grid-area: 4 / 2 / 5 / 3;
    } /* Col 2, Row 4 */

    .site-footer .footer-nav li {
        margin: 0;
        padding: 0;
    }

    .site-footer .footer-nav li::before {
        content: none !important;
    }

    .site-footer .footer-nav a {
        font-family: "Archivo", sans-serif;
        font-weight: 400;
        font-size: 12px;
        line-height: 13px;
        letter-spacing: 2px;
        color: inherit !important;
        text-decoration: none;
        text-transform: uppercase;
        transition: opacity 0.2s;
    }

    .site-footer .footer-nav a.special-link {
        color: #9e9856 !important; /* Keep hardcoded olive */
    }

    .site-footer .social-icon {
        width: 20px;
        height: 20px;
        color: #eae8d4; /* Beige */
        transition:
            color 0.4s ease,
            transform 0.2s;
    }

    .site-footer .icon-youtube {
        height: 22px;
        transform: scale(1.1);
    }

    /* Deep Dive Overrides for Icons - Handled by Global Swap */

    /* Socials (Base Mobile/Tablet) */
    .site-footer .footer-socials {
        display: flex;
        flex-direction: row;
        gap: 8px; /* Match Header gap */
        justify-content: center;
        align-items: center;
    }

    .site-footer .footer-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 33px;
        height: 33px;
        color: var(--text-footer); /* Ensure inherits correct color */
        transition:
            transform 0.2s,
            opacity 0.2s;
    }

    .site-footer .footer-socials a:hover {
        transform: scale(1.1);
    }

    /* Copyright */
    .site-footer .footer-copyright p {
        font-family: "Archivo", sans-serif;
        font-weight: 600;
        font-size: 15px;
        line-height: 16px;
        letter-spacing: 2px;
        color: #eae8d4;
        opacity: 0.8; /* Slight dim for copyright */
        text-align: center;
        margin: 0;
        transition: color 0.4s ease;
    }

    /* Override Copyright for Deep Dive - Handled by Global Swap */

    @media (min-width: 1025px) {
        .site-footer {
            padding: 61px 30px;
        }

        .site-footer .footer-inner {
            max-width: 1200px;
        }

        .site-footer .footer-main {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            border-bottom: none;
            max-width: none; /* Remove mobile squishing restriction */
        }

        .site-footer .footer-logo {
            margin-bottom: 0;
            order: 1;
            flex: 1;
        }

        .site-footer .logo-img {
            width: 88px;
            height: auto;
        }

        .site-footer .footer-nav {
            margin-bottom: 0;
            order: 2;
            flex: 2;
            display: flex;
            justify-content: center;
        }

        /* DESKTOP: Switch to Flex Row */
        .site-footer .footer-links-grid {
            display: flex !important;
            flex-direction: row;
            column-gap: 50px;
            row-gap: 0;
            margin: 0; /* Reset margin from mobile centering */
            max-width: none; /* Reset max-width from mobile */
        }

        .site-footer .footer-link-item {
            grid-column: auto !important;
            grid-row: auto !important;
        }

        .site-footer .footer-socials {
            order: 3;
            flex: 1;
            justify-content: flex-end;
        }

        .site-footer .social-icon {
            width: auto;
            height: 24px;
        }

        .site-footer .icon-youtube {
            height: 26px;
        }
    }

    @media (min-width: 1200px) {
        .site-footer {
            padding: 64px 32px;
        }

        .site-footer .footer-inner {
            max-width: 1800px;
        }

        .site-footer .logo-img {
            width: 120px;
            height: auto;
        }

        .site-footer .footer-links-grid {
            column-gap: 48px;
        }

        .nav-cols {
            gap: 48px;
        }
    }
</style>
