    }

    @media (max-width: 480px) {
        .contact-form-container {
            padding: 24px;
        }

        .header-group,
        .form-title,
        .form-subtitle {
            align-items: center;
            text-align: center;
            width: 100%;
            justify-content: center;
        }

        .submit-btn {
            align-self: center;
        }
    }
</style>
