---
import { fetchGlobalSettings } from "../../utils/global";

const settings = await fetchGlobalSettings();
const siteUrl = Astro.site ? Astro.site.toString() : "https://amiiverse.com";

// Structured Data for "MusicGroup" (Perfect for amii)
const schema = {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    name: settings.title || "amii",
    url: siteUrl,
    logo: settings.logo_navy
        ? settings.logo_navy
        : `${siteUrl}/favicon-96x96.png`,
    image: [
        `${siteUrl}/android-icon-192x192.png`,
        `${siteUrl}/apple-touch-icon.png`,
    ],
    description:
        settings.description ||
        "amii is a Nigerian girl group re-defining the sound of Afropop.",
    sameAs: settings.socials?.map((s: any) => s.url) || [],
    genre: ["Afropop", "Alté", "Nigerian Pop"],
    location: {
        "@type": "Place",
        name: "Nigeria",
    },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
