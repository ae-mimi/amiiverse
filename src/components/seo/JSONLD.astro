---
import { fetchGlobalSettings } from "../../utils/global";

const settings = await fetchGlobalSettings();
const siteUrl = Astro.site ? Astro.site.toString() : "https://weareamii.com";

// Structured Data for "MusicGroup" (Perfect for amii)
const schema = {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    name: settings.title || "amii",
    url: siteUrl,
    logo:
        settings.site_info?.logo_navy || settings.site_info?.logo_yellow || "",
    image: settings.seo?.og_image ? [settings.seo.og_image] : [],
    description:
        settings.site_info?.description ||
        "amii is a Nigerian girl group re-defining the sound of Afropop.",
    sameAs: settings.socials?.map((s: any) => s.url) || [],
    genre: ["Afropop", "Alté", "Nigerian Pop"],
    location: {
        "@type": "Place",
        name: "Nigeria",
    },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
