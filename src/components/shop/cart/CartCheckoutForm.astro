---
import { fetchGlobalSettings } from "../../../lib/siteSettings";

const settings = await fetchGlobalSettings();
const deliveryOptions =
    settings.shop?.deliveryOptions?.length
        ? settings.shop.deliveryOptions
        : [
              {
                  code: "standard",
                  label: "Standard",
                  priceNgn: 2500,
                  estimate: "3-5 business days",
                  description: "Best value for most orders.",
                  isDefault: true,
              },
              {
                  code: "express",
                  label: "Express",
                  priceNgn: 5500,
                  estimate: "1-2 business days",
                  description: "Priority handling and faster delivery.",
              },
              {
                  code: "free",
                  label: "Free",
                  priceNgn: 0,
                  estimate: "5-7 business days",
                  description: "Available during promo periods or eligible orders.",
              },
          ];
const defaultDelivery =
    deliveryOptions.find((option) => option.isDefault)?.code ||
    deliveryOptions[0]?.code ||
    "standard";
---

<section class="cartDrawerSection cartDrawerCheckoutSection">
    <div class="cartSectionIntro">
        <h5 class="font-weight-bold mb-4">Checkout details</h5>
        <p class="cartSectionCopy">Collect contact details, delivery destination, and your preferred shipping method before secure checkout.</p>
    </div>

    <form id="checkout-form" class="checkoutForm" autocomplete="on">
        <input type="hidden" id="modal-product-id" name="productId" />
        <input type="hidden" id="modal-quantity" name="quantity" />
        <input type="hidden" id="delivery-label" name="deliveryLabel" value={deliveryOptions.find((option) => option.code === defaultDelivery)?.label || "Standard"} />
        <input type="hidden" id="delivery-price-ngn" name="deliveryPriceNgn" value={String(deliveryOptions.find((option) => option.code === defaultDelivery)?.priceNgn ?? 0)} />
        <input type="hidden" id="delivery-estimate" name="deliveryEstimate" value={deliveryOptions.find((option) => option.code === defaultDelivery)?.estimate || ""} />

        <div class="checkoutFieldset">
            <div class="checkoutSectionHeader">
                <h6>Contact</h6>
            </div>

            <div class="checkoutGrid checkoutGridTwo">
                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">FIRST NAME</label>
                    <input
                        type="text"
                        id="first-name"
                        name="firstName"
                        class="formControl input-shape-rect"
                        placeholder="Amii"
                        autocomplete="given-name"
                        required
                    />
                </div>

                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">LAST NAME</label>
                    <input
                        type="text"
                        id="last-name"
                        name="lastName"
                        class="formControl input-shape-rect"
                        placeholder="Fan"
                        autocomplete="family-name"
                        required
                    />
                </div>
            </div>

            <div class="mb-3">
                <label class="text-xs font-weight-bold text-secondary mb-1">EMAIL</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="formControl input-shape-rect"
                    placeholder="name@example.com"
                    autocomplete="email"
                    inputmode="email"
                    required
                />
            </div>

            <div id="phone-field-wrap" class="mb-0">
                <label class="text-xs font-weight-bold text-secondary mb-1">PHONE NUMBER (OPTIONAL)</label>
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="formControl input-shape-rect"
                    placeholder="+234 ..."
                    autocomplete="tel"
                    inputmode="tel"
                />
            </div>
        </div>

        <div class="checkoutFieldset">
            <div class="checkoutSectionHeader">
                <h6>Shipping Address</h6>
            </div>

            <div class="mb-3">
                <label class="text-xs font-weight-bold text-secondary mb-1">ADDRESS LINE 1</label>
                <input
                    type="text"
                    id="address-line-1"
                    name="addressLine1"
                    class="formControl input-shape-rect"
                    placeholder="Street address"
                    autocomplete="address-line1"
                    required
                />
            </div>

            <div class="mb-3">
                <label class="text-xs font-weight-bold text-secondary mb-1">ADDRESS LINE 2</label>
                <input
                    type="text"
                    id="address-line-2"
                    name="addressLine2"
                    class="formControl input-shape-rect"
                    placeholder="Apartment, suite, unit"
                    autocomplete="address-line2"
                />
            </div>

            <div class="mb-3">
                <label class="text-xs font-weight-bold text-secondary mb-1">LANDMARK</label>
                <input
                    type="text"
                    id="landmark"
                    name="landmark"
                    class="formControl input-shape-rect"
                    placeholder="Nearby bus stop or notable location"
                />
            </div>

            <div class="checkoutGrid checkoutGridTwo">
                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">CITY</label>
                    <input
                        type="text"
                        id="city"
                        name="city"
                        class="formControl input-shape-rect"
                        placeholder="Lagos"
                        autocomplete="address-level2"
                        required
                    />
                </div>

                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">POSTCODE</label>
                    <input
                        type="text"
                        id="postcode"
                        name="postcode"
                        class="formControl input-shape-rect"
                        placeholder="100001"
                        autocomplete="postal-code"
                    />
                </div>
            </div>

            <div class="checkoutGrid checkoutGridTwo">
                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">PROVINCE / STATE</label>
                    <input
                        type="text"
                        id="region"
                        name="region"
                        class="formControl input-shape-rect"
                        placeholder="Lagos"
                        autocomplete="address-level1"
                        required
                    />
                </div>

                <div class="mb-3">
                    <label class="text-xs font-weight-bold text-secondary mb-1">COUNTRY</label>
                    <input
                        type="text"
                        id="country"
                        name="country"
                        class="formControl input-shape-rect"
                        placeholder="NG"
                        maxlength="2"
                        autocomplete="country"
                        value="NG"
                        required
                    />
                </div>
            </div>
        </div>

        <div class="checkoutFieldset">
            <div class="checkoutSectionHeader">
                <h6>Delivery</h6>
                <p class="checkoutSectionHint">Delivery options are CMS-managed. Live carrier rating can be added in a later shipping integration phase.</p>
            </div>

            <div class="deliveryOptions" role="radiogroup" aria-label="Delivery methods">
                {
                    deliveryOptions.map((option) => (
                        <label class="deliveryOption">
                            <input
                                type="radio"
                                name="deliveryMethod"
                                value={option.code}
                                data-delivery-option
                                data-delivery-default={option.code === defaultDelivery ? "true" : "false"}
                                data-delivery-label={option.label}
                                data-delivery-price-ngn={option.priceNgn ?? 0}
                                data-delivery-estimate={option.estimate || ""}
                                checked={option.code === defaultDelivery}
                            />
                            <span class="deliveryOptionBody">
                                <span class="deliveryOptionTop">
                                    <strong>{option.label}</strong>
                                    <strong>₦{Number(option.priceNgn ?? 0).toLocaleString()}</strong>
                                </span>
                                <span class="deliveryOptionMeta">
                                    {option.estimate || "Estimate available soon"}
                                </span>
                                {
                                    option.description && (
                                        <span class="deliveryOptionCopy">{option.description}</span>
                                    )
                                }
                            </span>
                        </label>
                    ))
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="text-xs font-weight-bold text-secondary mb-1"
                >CURRENCY</label
            >
            <select id="currency" name="currency" class="formControl input-shape-rect">
                <option value="NGN">NGN</option>
                <option value="USD">USD</option>
                <option value="GBP">GBP</option>
            </select>
        </div>

        <div
            class="errorState mb-3 text-danger text-xs font-weight-bold"
            id="modal-error"
            hidden
        ></div>

        <button
            type="submit"
            class="btn btn-dark btn-lg w-100 mb-3"
            id="checkout-submit"
        >
            Secure Checkout
        </button>

        <button
            type="button"
            class="btn btn-outline-dark w-100 mb-3"
            id="continue-shopping"
        >
            Continue Shopping
        </button>

        <p class="text-center text-xs text-secondary mb-0">
            Secure 256-bit encrypted checkout.<br />
            Final shipping charges are confirmed during payment initialization.
        </p>
    </form>
</section>

<style>
    .checkoutForm {
        display: grid;
        gap: 1rem;
    }

    .checkoutFieldset {
        display: grid;
        gap: 0.85rem;
        padding: 1rem;
        border-radius: 1rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
        background: color-mix(in srgb, var(--color-bg) 97%, var(--color-secondary) 3%);
    }

    .checkoutSectionHeader {
        display: grid;
        gap: 0.25rem;
    }

    .checkoutSectionHeader h6 {
        margin: 0;
        font-size: 0.92rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-primary);
    }

    .checkoutSectionHint {
        margin: 0;
        font-size: 0.76rem;
        line-height: 1.45;
        color: var(--color-text-muted);
    }

    .checkoutGrid {
        display: grid;
        gap: 0.85rem;
    }

    .checkoutGridTwo {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .deliveryOptions {
        display: grid;
        gap: 0.75rem;
    }

    .deliveryOption {
        display: block;
        cursor: pointer;
    }

    .deliveryOption input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .deliveryOptionBody {
        display: grid;
        gap: 0.2rem;
        padding: 0.9rem 1rem;
        border-radius: 1rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
        background: color-mix(in srgb, var(--color-bg) 100%, transparent);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .deliveryOption input:checked + .deliveryOptionBody {
        border-color: var(--color-primary);
        background: color-mix(in srgb, var(--color-secondary) 10%, var(--color-bg) 90%);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--color-primary) 10%, transparent);
    }

    .deliveryOptionTop {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        align-items: baseline;
        color: var(--color-primary);
    }

    .deliveryOptionMeta,
    .deliveryOptionCopy {
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--color-text-muted);
    }

    @media (max-width: 720px) {
        .checkoutGridTwo {
            grid-template-columns: 1fr;
        }
    }
</style>
