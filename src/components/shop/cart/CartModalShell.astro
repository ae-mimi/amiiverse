<div id="checkout-modal" class="checkoutOverlay" aria-hidden="true">
    <button
        type="button"
        class="checkoutScrim"
        id="close-modal-scrim"
        aria-label="Close shopping cart"
    ></button>
    <aside
        class="checkoutModal card shadow-lg border-0"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cart-drawer-title"
    >
        <div class="cartDrawerHeader">
            <div>
                <p class="cartDrawerEyebrow">Shop cart</p>
                <h3 id="cart-drawer-title" class="cartDrawerTitle">
                    Your picks <span id="modal-cart-count" class="cartDrawerCount">(0)</span>
                </h3>
            </div>
            <button
                type="button"
                class="modalClose"
                id="close-modal"
                aria-label="Close shopping cart"
            >
                &times;
            </button>
        </div>
        <div class="card-body p-0 cartDrawerBody">
            <slot />
        </div>
    </aside>
</div>
