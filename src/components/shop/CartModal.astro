---
---

<div id="checkout-modal" class="checkoutOverlay" aria-hidden="true">
    <div class="checkoutModal card shadow-lg border-0">
        <button
            type="button"
            class="modalClose modalCloseFloating"
            id="close-modal"
            aria-label="Close checkout"
        >
            &times;
        </button>
        <div class="card-body p-0">
            <div class="row g-0">
                <!-- Left Side: Order Review (Astro Ecommerce Shopping Cart UI) -->
                <div class="col-12 col-lg-7 p-4 p-md-5">
                    <div class="d-flex align-items-center mb-4">
                        <h4 class="font-weight-bold mb-0">Review Order</h4>
                    </div>

                    <div id="modal-cart-items"></div>

                    <hr class="horizontal dark" />

                    <div class="order-summary mt-4">
                        <div class="orderSummaryRow">
                            <span class="text-secondary">Subtotal</span>
                            <span id="modal-subtotal" class="font-weight-bold"
                            ></span>
                        </div>
                        <div class="orderSummaryRow">
                            <span class="text-secondary">Delivery</span>
                            <span id="modal-delivery" class="text-sm"></span>
                        </div>
                        <div class="orderSummaryRow mt-3">
                            <span class="font-weight-bold">Total</span>
                            <span
                                id="modal-total"
                                class="font-weight-bold text-lg"
                                style="color: var(--color-accent);"></span>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Contact & Payment (Astro Ecommerce Checkout UI) -->
                <div class="col-12 col-lg-5 bg-gray-100 p-4 p-md-5">
                    <h5 class="font-weight-bold mb-4">Finalize Checkout</h5>

                    <form id="checkout-form" class="checkoutForm" autocomplete="on">
                        <input
                            type="hidden"
                            id="modal-product-id"
                            name="productId"
                        />
                        <input
                            type="hidden"
                            id="modal-quantity"
                            name="quantity"
                        />

                        <div class="mb-3">
                            <label
                                class="text-xs font-weight-bold text-secondary mb-1"
                                >EMAIL ADDRESS</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="formControl input-shape-rect"
                                placeholder="name@example.com"
                                autocomplete="email"
                                inputmode="email"
                                required
                            />
                        </div>

                        <div id="phone-field-wrap" class="mb-4">
                            <label
                                class="text-xs font-weight-bold text-secondary mb-1"
                                >PHONE NUMBER (OPTIONAL)</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="formControl input-shape-rect"
                                placeholder="+234 ..."
                                autocomplete="tel"
                                inputmode="tel"
                            />
                        </div>

                        <div class="mb-3">
                            <label class="text-xs font-weight-bold text-secondary mb-1"
                                >CURRENCY</label
                            >
                            <select
                                id="currency"
                                name="currency"
                                class="formControl input-shape-rect"
                            >
                                <option value="NGN">NGN</option>
                                <option value="USD">USD</option>
                                <option value="GBP">GBP</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="text-xs font-weight-bold text-secondary mb-1"
                                >COUNTRY (ISO2)</label
                            >
                            <input
                                type="text"
                                id="country"
                                name="country"
                                class="formControl input-shape-rect"
                                placeholder="NG"
                                maxlength="2"
                                value="NG"
                            />
                        </div>

                        <div class="mb-4">
                            <label class="text-xs font-weight-bold text-secondary mb-1"
                                >REGION (OPTIONAL)</label
                            >
                            <input
                                type="text"
                                id="region"
                                name="region"
                                class="formControl input-shape-rect"
                                placeholder="Lagos"
                            />
                        </div>

                        <div
                            class="errorState mb-3 text-danger text-xs font-weight-bold"
                            id="modal-error"
                            hidden
                        >
                        </div>

                        <button
                            type="submit"
                            class="btn btn-dark btn-lg w-100 mb-3"
                            id="checkout-submit"
                        >
                            Continue to Payment
                        </button>

                        <p class="text-center text-xs text-secondary mb-0">
                            Secure 256-bit encrypted checkout.<br />
                            Prices in NGN (₦).
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { cartStore, type ClientCart, type ClientCartItem } from "../../lib/cart/cartStore";

    function trackAnalyticsEvent(name: string, props: Record<string, unknown> = {}) {
        if (typeof window === "undefined") return;
        window.dispatchEvent(
            new CustomEvent("analytics:event", {
                detail: { name, props },
            }),
        );
    }

    class CheckoutManager {
        modal: HTMLElement;
        form: HTMLFormElement;
        submitBtn: HTMLButtonElement;
        cartItemsWrap: HTMLElement;
        cart: ClientCart | null = null;

        constructor() {
            this.modal = document.getElementById("checkout-modal")!;
            this.form = document.getElementById(
                "checkout-form",
            ) as HTMLFormElement;
            this.submitBtn = document.getElementById(
                "checkout-submit",
            ) as HTMLButtonElement;
            this.cartItemsWrap = document.getElementById("modal-cart-items")!;

            if (this.modal) this.init();
        }

        init() {
            cartStore.initCart().then((cart) => this.renderCart(cart));

            window.addEventListener("open-checkout", (e: any) => this.open(e.detail));
            window.addEventListener("cart:updated", (e: Event) => {
                const customEvent = e as CustomEvent<ClientCart | null>;
                this.renderCart(customEvent.detail ?? null);
            });
            document
                .getElementById("close-modal")
                ?.addEventListener("click", () => this.close());
            this.modal.addEventListener("click", (e) => {
                if (e.target === this.modal) this.close();
            });
            document.addEventListener("keydown", (e) => {
                if (
                    e.key === "Escape" &&
                    this.modal.classList.contains("isOpen")
                )
                    this.close();
            });
            this.cartItemsWrap.addEventListener("click", (e) =>
                this.handleCartActions(e),
            );
            this.form.addEventListener("submit", (e) => this.handleSubmit(e));
        }

        formatNgn(value: number): string {
            return `₦${value.toLocaleString()}`;
        }

        getLineItemTitle(item: ClientCartItem): string {
            return (
                (item.title as string) ||
                "Product"
            );
        }

        getLineItemType(item: ClientCartItem): string {
            const rawType =
                (item.metadata as Record<string, unknown> | undefined)?.productType ||
                (item.metadata as Record<string, unknown> | undefined)?.type ||
                "physical";
            return String(rawType).toUpperCase();
        }

        getLineItemImage(item: ClientCartItem): string {
            const itemMetadata = item.metadata as Record<string, unknown> | undefined;
            const product = itemMetadata?.product as Record<string, unknown> | undefined;
            return (
                (item.thumbnail as string) ||
                (product?.thumbnail as string) ||
                ""
            );
        }

        getLineItemUnitPrice(item: ClientCartItem): number {
            const quantity = Number(item.quantity || 1);
            const total = Number((item.total as number) ?? 0);
            const unit = Number(
                (item.unit_price as number) ?? (item.unit_price_minor as number) ?? 0,
            );
            if (unit > 0) return unit;
            if (total > 0 && quantity > 0) return Math.round(total / quantity);
            return 0;
        }

        getLineItemTotal(item: ClientCartItem): number {
            const total = Number((item.total as number) ?? 0);
            if (total > 0) return total;
            return this.getLineItemUnitPrice(item) * Number(item.quantity || 1);
        }

        getCartItems(cart: ClientCart | null): ClientCartItem[] {
            if (!cart?.items?.length) return [];
            return cart.items as ClientCartItem[];
        }

        getSubtotal(cart: ClientCart | null): number {
            const fromCart = Number((cart?.subtotal as number) ?? 0);
            if (fromCart > 0) return fromCart;
            return this.getCartItems(cart).reduce(
                (sum, item) => sum + this.getLineItemTotal(item),
                0,
            );
        }

        getTotal(cart: ClientCart | null): number {
            const fromCart = Number((cart?.total as number) ?? 0);
            if (fromCart > 0) return fromCart;
            return this.getSubtotal(cart);
        }

        renderCart(cart: ClientCart | null) {
            this.cart = cart;
            const items = this.getCartItems(cart);

            if (items.length === 0) {
                this.cartItemsWrap.innerHTML =
                    '<p class="text-sm text-secondary mb-0">Your cart is empty.</p>';
            } else {
                this.cartItemsWrap.innerHTML = items
                    .map((item) => {
                        const image = this.getLineItemImage(item);
                        const qty = Number(item.quantity || 1);
                        return `
                            <div class="d-flex gap-4 align-items-center mb-4" data-line-item-id="${item.id}">
                                <img
                                    src="${image}"
                                    alt="${this.getLineItemTitle(item)}"
                                    class="productCartThumb shadow-xs"
                                />
                                <div class="flex-grow-1">
                                    <h6 class="font-weight-bold mb-1">${this.getLineItemTitle(item)}</h6>
                                    <p class="text-xs text-secondary mb-1">Type: ${this.getLineItemType(item)}</p>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2 mb-0" data-cart-dec="${item.id}">-</button>
                                        <span class="text-xs text-secondary">Qty: ${qty}</span>
                                        <button type="button" class="btn btn-sm btn-outline-dark py-1 px-2 mb-0" data-cart-inc="${item.id}">+</button>
                                        <button type="button" class="btn btn-sm btn-link text-danger py-0 px-1 mb-0" data-cart-remove="${item.id}">Remove</button>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <p class="font-weight-bold mb-0">${this.formatNgn(this.getLineItemTotal(item))}</p>
                                </div>
                            </div>
                        `;
                    })
                    .join("");
            }

            (this.modal.querySelector("#modal-subtotal") as HTMLElement).innerText =
                this.formatNgn(this.getSubtotal(cart));
            (this.modal.querySelector("#modal-delivery") as HTMLElement).innerText =
                "Calculated at payment";
            (this.modal.querySelector("#modal-total") as HTMLElement).innerText =
                this.formatNgn(this.getTotal(cart));

            const firstItem = items[0];
            (
                this.modal.querySelector("#modal-product-id") as HTMLInputElement
            ).value = String((firstItem?.id as string) || "");
            (
                this.modal.querySelector("#modal-quantity") as HTMLInputElement
            ).value = String(Number(firstItem?.quantity || 1));

            const phoneField = document.getElementById("phone-field-wrap");
            if (phoneField) phoneField.hidden = false;
        }

        async handleCartActions(e: Event) {
            const target = e.target as HTMLElement;
            if (!target) return;

            const removeId = target.getAttribute("data-cart-remove");
            if (removeId) {
                const updated = await cartStore.removeLineItem(removeId);
                this.renderCart(updated);
                return;
            }

            const incId = target.getAttribute("data-cart-inc");
            if (incId) {
                const item = this.getCartItems(this.cart).find((entry) => entry.id === incId);
                if (!item) return;
                const nextQty = Number(item.quantity || 1) + 1;
                const updated = await cartStore.updateQuantity(incId, nextQty);
                this.renderCart(updated);
                return;
            }

            const decId = target.getAttribute("data-cart-dec");
            if (decId) {
                const item = this.getCartItems(this.cart).find((entry) => entry.id === decId);
                if (!item) return;
                const nextQty = Number(item.quantity || 1) - 1;
                const updated = await cartStore.updateQuantity(decId, nextQty);
                this.renderCart(updated);
            }
        }

        async open(data: any) {
            const variantId = data?.variantId || data?.productId;
            const quantity = Number(data?.quantity || 1);

            const updatedCart = variantId
                ? await cartStore.addToCart(String(variantId), quantity)
                : await cartStore.getCart();
            this.renderCart(updatedCart);

            if (variantId) {
                trackAnalyticsEvent("cart_add", {
                    variantId: String(variantId),
                    quantity,
                });
            }

            this.modal.classList.add("isOpen");
            this.modal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            setTimeout(
                () => (document.getElementById("email") as HTMLElement).focus(),
                100,
            );
        }

        close() {
            this.modal.classList.remove("isOpen");
            this.modal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            this.resetState();
        }

        resetState() {
            this.submitBtn.disabled = false;
            this.submitBtn.innerText = "Continue to Payment";
            (document.getElementById("modal-error") as HTMLElement).hidden =
                true;
            (document.getElementById("email") as HTMLInputElement).value = "";
            (document.getElementById("phone") as HTMLInputElement).value = "";
        }

        async handleSubmit(e: Event) {
            e.preventDefault();
            this.submitBtn.disabled = true;
            this.submitBtn.innerText = "Redirecting...";
            const errorEl = document.getElementById(
                "modal-error",
            ) as HTMLElement;
            errorEl.hidden = true;

            const formData = new FormData(this.form);

            try {
                const cart = await cartStore.getCart();
                if (!cart?.id) {
                    throw new Error("No active cart found.");
                }

                const payload = {
                    cartId: cart.id,
                    email: String(formData.get("email") || ""),
                    phone: String(formData.get("phone") || ""),
                    currency: String(formData.get("currency") || "NGN").toUpperCase(),
                    country: String(formData.get("country") || "NG")
                        .trim()
                        .toUpperCase(),
                    region: String(formData.get("region") || "").trim(),
                };

                trackAnalyticsEvent("checkout_start", {
                    cartId: cart.id,
                });

                const quoteRes = await fetch("/api/checkout/quote", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        cartId: payload.cartId,
                        currency: payload.currency,
                        country: payload.country,
                        region: payload.region,
                    }),
                });
                const quoteData = await quoteRes.json();
                if (!quoteRes.ok || !quoteData?.quoteHash) {
                    throw new Error(quoteData?.error || "Unable to refresh totals");
                }

                const controller = new AbortController();
                const timeoutId = window.setTimeout(
                    () => controller.abort(),
                    20000,
                );

                let res: Response;
                try {
                    const idempotencyKey =
                        crypto?.randomUUID?.() ||
                        `idem_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
                    res = await fetch("/api/checkout/initialize", {
                        signal: controller.signal,
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "Idempotency-Key": idempotencyKey,
                        },
                        body: JSON.stringify({
                            ...payload,
                            quoteHash: String(quoteData.quoteHash),
                        }),
                    });
                } finally {
                    window.clearTimeout(timeoutId);
                }

                const data = await res.json();
                if (res.ok && data.authorization_url) {
                    window.location.href = data.authorization_url;
                } else {
                    throw new Error(data.error || "Payment could not start.");
                }
            } catch (err: any) {
                errorEl.innerText =
                    "Payment failed. Please check your connection and try again.";
                errorEl.hidden = false;
                this.submitBtn.disabled = false;
                this.submitBtn.innerText = "Continue to Payment";
            }
        }
    }

    new CheckoutManager();
</script>
