---
import CartCheckoutForm from "./cart/CartCheckoutForm.astro";
import CartLineItems from "./cart/CartLineItems.astro";
import CartModalShell from "./cart/CartModalShell.astro";
import CartSummary from "./cart/CartSummary.astro";
---

<CartModalShell>
    <CartLineItems>
        <CartSummary />
    </CartLineItems>
    <CartCheckoutForm />
</CartModalShell>

<script>
    import { initCheckoutModal } from "../../lib/client/cartModal";

    initCheckoutModal();
    document.addEventListener("astro:page-load", initCheckoutModal);
</script>
