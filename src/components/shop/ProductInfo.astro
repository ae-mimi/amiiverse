---
/**
 * ProductInfo Component
 * Displays product metadata, pricing, buy button, and expandable details.
 */
import ProductAccordion from "./ProductAccordion.astro";
import ProductPurchasePanel from "./pdp/ProductPurchasePanel.astro";

interface Props {
    title: string;
    price: number;
    productType: string;
    image: string;
    productId: string;
    variantId?: string;
    stock?: number;
    accordionData?: Record<string, string>;
}

const {
    title,
    price,
    productType,
    image,
    productId,
    variantId = "",
    stock,
    accordionData = {},
} = Astro.props;

const isSoldOut = stock !== undefined && stock !== null && stock <= 0;
---

<div class="product-info-panel h-100 d-flex flex-column py-4">
    <ProductPurchasePanel
        title={title}
        price={price}
        productType={productType}
        image={image}
        productId={productId}
        variantId={variantId}
        stock={stock}
    />

    <!-- Expandable Details (Accordion) -->
    {
        Object.keys(accordionData).length > 0 && (
            <ProductAccordion data={accordionData} />
        )
    }

    <p class="text-xs text-secondary mt-5 opacity-7">
        Secure checkout. You will be redirected to complete
        payment.
    </p>
</div>
