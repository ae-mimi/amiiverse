---
import ProductAccordion from "./ProductAccordion.astro";
import ProductPurchasePanel from "./pdp/ProductPurchasePanel.astro";

interface VariantOption {
    id: string;
    title?: string;
    price_ngn: number;
    stock?: { available: number; is_in_stock: boolean };
}

interface Props {
    title: string;
    description?: string;
    price: number;
    productType: string;
    image: string;
    productId: string;
    variantId?: string;
    stock?: number;
    variants?: VariantOption[];
    totalVariants?: number;
    accordionData?: Record<string, string>;
}

const {
    title,
    description = "",
    price,
    productType,
    image,
    productId,
    variantId = "",
    stock,
    variants = [],
    totalVariants = 0,
    accordionData = {},
} = Astro.props;
---

<div class="product-info-panel">
    <ProductPurchasePanel
        title={title}
        description={description}
        price={price}
        productType={productType}
        image={image}
        productId={productId}
        variantId={variantId}
        stock={stock}
        variants={variants}
        totalVariants={totalVariants}
    />

    {
        Object.keys(accordionData).length > 0 && (
            <div class="productAccordionWrap">
                <ProductAccordion data={accordionData} />
            </div>
        )
    }

    <p class="productCheckoutNote">
        Secure checkout. You will be redirected to complete payment.
    </p>
</div>

<style>
    .product-info-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .productAccordionWrap {
        border-radius: 1.5rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
        background: color-mix(in srgb, var(--color-bg) 96%, var(--color-secondary) 4%);
        padding: 0 1.25rem;
    }

    .productCheckoutNote {
        margin: 0;
        font-size: 0.82rem;
        line-height: 1.55;
        color: var(--color-text-muted);
    }
</style>
