---
/**
 * ProductAccordion Component
 * Renders an expandable accordion for product details.
 */
interface Props {
    data: Record<string, string>;
}

const { data } = Astro.props;
const entries = Object.entries(data);
---

<div class="accordion mt-5" id="productAccordion">
    {
        entries.map(([title, content], index) => (
            <div class="accordion-item border-bottom">
                <h5 class="accordion-header" id={`heading${index}`}>
                    <button
                        class={`accordion-button ${index !== 0 ? "collapsed" : ""} font-weight-bold py-4`}
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target={`#collapse${index}`}
                        aria-expanded={index === 0 ? "true" : "false"}
                        aria-controls={`collapse${index}`}
                    >
                        {title}
                        <i class="collapse-icon fa fa-plus text-xs pt-1 position-absolute end-0 me-3" />
                    </button>
                </h5>
                <div
                    id={`collapse${index}`}
                    class={`accordion-collapse collapse ${index === 0 ? "show" : ""}`}
                    aria-labelledby={`heading${index}`}
                    data-bs-parent="#productAccordion"
                >
                    <div class="accordion-body text-body text-sm opacity-8 pb-4">
                        <div class="accordionRichContent" set:html={content}></div>
                    </div>
                </div>
            </div>
        ))
    }
</div>

<style>
    .accordion-button {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        box-shadow: none;
        padding-right: 2.5rem;
        cursor: pointer;
        color: var(--color-primary);
        font-family: var(--font-heading);
    }

    .collapse-icon {
        transition: transform 0.3s ease;
    }

    .accordion-button:not(.collapsed) .collapse-icon {
        transform: rotate(45deg); /* Simple plus-to-cross transformation */
    }

    .accordion-collapse {
        height: auto;
        overflow: hidden;
        transition: height 0.3s ease;
    }

    .accordion-collapse.collapse:not(.show) {
        display: none;
    }

    .accordionRichContent {
        display: grid;
        gap: 0.9rem;
        color: var(--color-text-muted);
    }

    .accordionRichContent p,
    .accordionRichContent ul,
    .accordionRichContent ol,
    .accordionRichContent blockquote,
    .accordionRichContent h2,
    .accordionRichContent h3 {
        margin: 0;
    }

    .accordionRichContent p,
    .accordionRichContent li,
    .accordionRichContent blockquote {
        line-height: 1.7;
    }

    .accordionRichContent ul,
    .accordionRichContent ol {
        padding-left: 1.15rem;
    }

    .accordionRichContent h2,
    .accordionRichContent h3 {
        color: var(--color-primary);
        line-height: 1.15;
    }
</style>

<script>
    // Simple Vanilla JS toggle logic in case Bootstrap JS isn't initialized
    const accordionButtons = document.querySelectorAll(
        "#productAccordion .accordion-button",
    );

    accordionButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const targetId = button.getAttribute("data-bs-target");
            const target = document.querySelector(targetId!);
            const isExpanded = button.getAttribute("aria-expanded") === "true";

            // Close others (Optional, for true accordion behavior)
            const allButtons = document.querySelectorAll(
                "#productAccordion .accordion-button",
            );
            const allCollapses = document.querySelectorAll(
                "#productAccordion .accordion-collapse",
            );

            allButtons.forEach((btn) => {
                if (btn !== button) {
                    btn.classList.add("collapsed");
                    btn.setAttribute("aria-expanded", "false");
                }
            });
            allCollapses.forEach((coll) => {
                if (coll !== target) {
                    coll.classList.remove("show");
                }
            });

            // Toggle current
            if (isExpanded) {
                button.classList.add("collapsed");
                button.setAttribute("aria-expanded", "false");
                target?.classList.remove("show");
            } else {
                button.classList.remove("collapsed");
                button.setAttribute("aria-expanded", "true");
                target?.classList.add("show");
            }
        });
    });
</script>
