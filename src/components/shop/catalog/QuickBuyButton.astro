---
interface Props {
    productId?: string;
    variantId?: string;
    title: string;
    price: number;
    image?: string;
    productType?: string;
    quantity?: number;
    disabled?: boolean;
    label?: string;
    class?: string;
}

const {
    productId = "",
    variantId = "",
    title,
    price,
    image = "",
    productType = "physical",
    quantity = 1,
    disabled = false,
    label = "Quick Buy",
    class: className,
} = Astro.props;
---

<button
    class:list={["btn btn-dark", className]}
    data-quickbuy
    data-product-id={productId}
    data-variant-id={variantId}
    data-quantity={quantity}
    data-title={title}
    data-price={price}
    data-image={image}
    data-type={productType}
    disabled={disabled}
>
    {label}
</button>
