<div
    id="shop-preview-modal"
    class="shopPreviewOverlay"
    aria-hidden="true"
    hidden
>
    <button
        type="button"
        class="shopPreviewScrim"
        data-shop-preview-close
        aria-label="Close quick preview"
    ></button>

    <section
        class="shopPreviewDialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="shop-preview-title"
    >
        <button
            type="button"
            class="modalClose shopPreviewClose"
            data-shop-preview-close
            aria-label="Close quick preview"
        >
            x
        </button>

        <div class="shopPreviewLayout">
            <div class="shopPreviewMediaWrap">
                <img
                    id="shop-preview-image"
                    class="shopPreviewImage"
                    src=""
                    alt=""
                />
            </div>

            <div class="shopPreviewContent">
                <h3 id="shop-preview-title" class="shopPreviewTitle"></h3>
                <div class="shopPreviewMetaRow">
                    <p id="shop-preview-type" class="shopPreviewType"></p>
                    <p id="shop-preview-price" class="shopPreviewPrice"></p>
                </div>
                <p id="shop-preview-description" class="shopPreviewDescription"></p>

                <div class="shopPreviewActions">
                    <button
                        type="button"
                        class="btn btn-dark"
                        id="shop-preview-add"
                        data-quickbuy
                    >
                        Add to cart
                    </button>
                    <a
                        id="shop-preview-link"
                        href="/shop"
                        class="btn btn-outline-dark"
                    >
                        View details
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
