---
import ProductCard from "../ProductCard.astro";

interface ShopProduct {
    id: string;
    product_id?: string;
    variant_id?: string;
    slug: string;
    title: string;
    price_ngn: number;
    product_type: "physical" | "digital";
    cover_image_url: string;
}

interface Props {
    items: ShopProduct[];
}

const { items } = Astro.props;
---

{
    items.length > 0 ? (
        <div class="row" data-grid>
            {
                items.map((item) => (
                    <div
                        class="col-12 col-md-6 col-lg-4 mb-4"
                        data-grid-item
                        data-type={item.product_type}
                        data-price={item.price_ngn}
                    >
                        <ProductCard
                            url={`/shop/${item.slug}`}
                            title={item.title}
                            price={item.price_ngn}
                            image={item.cover_image_url}
                            productId={item.product_id || item.id}
                            variantId={item.variant_id || item.id}
                            productType={item.product_type}
                        />
                    </div>
                ))
            }
        </div>
    ) : (
        <div class="row" data-grid></div>
    )
}

<p class="shopEmptyState" data-empty hidden>
    No products match your search.
</p>
