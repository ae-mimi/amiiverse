---
import { urlFor } from "../../lib/sanity/image";

interface Props {
    title: string;
    price: number;
    image: any;
    url: string;
    productId: string;
    productType?: string;
    stock?: number;
    badges?: string[];
}

const {
    title,
    price,
    image,
    url,
    productId,
    productType = "physical",
    stock,
} = Astro.props;

const imageUrl = urlFor(image, (builder) =>
    builder.width(600).height(600).fit("crop"),
);

const isSoldOut = stock !== undefined && stock !== null && stock <= 0;
const isDigital = productType === "digital";
---

<div class="card card-product card-plain" data-title={title} data-price={price}>
    <div class="card-header">
        <a href={url} class="d-block">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={title}
                        class="img-fluid border-radius-lg"
                        loading="lazy"
                    />
                ) : (
                    <div
                        class="shopCardImagePlaceholder"
                        style="background: #eee; aspect-ratio: 1/1; border-radius: 12px;"
                    />
                )
            }
        </a>
    </div>
    <div class="card-body pb-0">
        <p class="text-sm mb-1 text-secondary">
            {isDigital ? "Digital Asset" : "Physical Product"}
        </p>
        <a href={url} style="text-decoration: none;">
            <h5 class="font-weight-bold">{title}</h5>
        </a>
        <div class="d-flex align-items-center justify-content-between mb-3">
            <p class="mb-0 text-sm font-weight-bold">
                ₦{price.toLocaleString()}
            </p>
        </div>

        <div class="shopCardActions d-flex gap-2 mb-3">
            <button
                class="btn btn-dark w-100"
                data-quickbuy
                data-product-id={productId}
                data-title={title}
                data-price={price}
                data-image={imageUrl}
                data-type={productType}
                disabled={isSoldOut}
            >
                {isSoldOut ? "Sold Out" : "Quick Buy"}
            </button>
            <a href={url} class="btn btn-outline-dark">View</a>
        </div>
    </div>
</div>

<script>
    const quickBuyBtns = document.querySelectorAll("[data-quickbuy]");

    quickBuyBtns.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const button = e.currentTarget as HTMLButtonElement;
            const { productId, title, price, image, type } = button.dataset;

            window.dispatchEvent(
                new CustomEvent("open-checkout", {
                    detail: {
                        productId,
                        title,
                        price: parseFloat(price || "0"),
                        image,
                        productType: type,
                        quantity: 1,
                    },
                }),
            );
        });
    });
</script>
