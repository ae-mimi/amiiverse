---
import { urlFor } from "../../lib/sanity/image";
import QuickBuyButton from "./catalog/QuickBuyButton.astro";

interface Props {
    title: string;
    price: number;
    image: any;
    url: string;
    productId: string;
    variantId?: string;
    productType?: string;
    stock?: number;
    badges?: string[];
}

const {
    title,
    price,
    image,
    url,
    productId,
    variantId = "",
    productType = "physical",
    stock,
} = Astro.props;

const imageUrl = urlFor(image, (builder) =>
    builder.width(600).height(600).fit("crop"),
);

const isSoldOut = stock !== undefined && stock !== null && stock <= 0;
const isDigital = productType === "digital";
const metaLabel = isDigital ? "Instant delivery" : "Ships from the official shop";
---

<article class="card card-product card-plain" data-title={title} data-price={price}>
    <div class="shopCardBadgeRow">
        <span class={`shopProductTag ${isDigital ? "isDigital" : "isPhysical"}`}>
            {isDigital ? "Digital" : "Physical"}
        </span>
        {
            isSoldOut ? (
                <span class="shopProductTag isMuted">Sold out</span>
            ) : (
                <span class="shopProductTag isAccent">Ready to ship</span>
            )
        }
    </div>
    <div class="card-header">
        <a href={url} class="d-block">
            {
                imageUrl ? (
                    <img
                        src={imageUrl}
                        alt={title}
                        class="img-fluid border-radius-lg"
                        loading="lazy"
                    />
                ) : (
                    <div
                        class="shopCardImagePlaceholder"
                        style="background: #eee; aspect-ratio: 1/1; border-radius: 12px;"
                    />
                )
            }
        </a>
    </div>
    <div class="card-body pb-0">
        <p class="shopCardMeta">{metaLabel}</p>
        <a href={url} style="text-decoration: none;">
            <h5 class="font-weight-bold shopCardTitle">{title}</h5>
        </a>
        <div class="shopCardPriceRow">
            <p class="mb-0 text-sm font-weight-bold shopCardPrice">
                ₦{price.toLocaleString()}
            </p>
            <span class="shopCardAssistText">
                {isDigital ? "Download after payment" : "Checkout for delivery estimate"}
            </span>
        </div>

        <div class="shopCardActions d-flex gap-2 mb-3">
            <QuickBuyButton
                productId={productId}
                variantId={variantId}
                title={title}
                price={price}
                image={imageUrl}
                productType={productType}
                quantity={1}
                disabled={isSoldOut}
                label={isSoldOut ? "Sold Out" : "Add to Cart"}
                class="w-100"
            />
            <a href={url} class="btn btn-outline-dark">Details</a>
        </div>
    </div>
</article>
