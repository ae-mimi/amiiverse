---
import { urlFor } from "../../lib/sanity/image";

interface Props {
    images: any[];
    title: string;
}

const { images, title } = Astro.props;

if (!images || images.length === 0) {
    return null;
}

const mainImage = urlFor(images[0], (builder) =>
    builder.width(1200).height(1200).fit("crop"),
);
---

<section class="pdpGalleryShell">
    <div class="pdpGalleryStage">
        <img
            id="pdp-main-image"
            src={mainImage}
            alt={title}
            class="pdpMainImage"
        />
        <div class="pdpImageMeta">
            <span class="pdpImageBadge">Official product photo</span>
            <span class="pdpImageHint">Tap thumbnails to explore</span>
        </div>
    </div>

    {
        images.length > 1 && (
            <div class="pdpThumbRail">
                {images.map((img, idx) => {
                    const thumbUrl = urlFor(img, (builder) =>
                        builder.width(240).height(240).fit("crop"),
                    );
                    const fullUrl = urlFor(img, (builder) =>
                        builder.width(1200).height(1200).fit("crop"),
                    );

                    return (
                        <button
                            type="button"
                            class={`pdpThumbButton ${idx === 0 ? "active" : ""}`}
                            data-full={fullUrl}
                            aria-label={`Show image ${idx + 1} for ${title}`}
                        >
                            <img
                                src={thumbUrl}
                                alt={`${title} thumb ${idx + 1}`}
                                class="pdp-thumb"
                                loading="lazy"
                            />
                        </button>
                    );
                })}
            </div>
        )
    }
</section>

<style>
    .pdpGalleryShell {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pdpGalleryStage {
        position: relative;
        overflow: hidden;
        border-radius: 2rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
        background: color-mix(in srgb, var(--color-bg) 92%, var(--color-secondary) 8%);
        box-shadow: 0 22px 52px color-mix(in srgb, var(--color-primary) 10%, transparent);
    }

    .pdpMainImage {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        display: block;
    }

    .pdpImageMeta {
        position: absolute;
        left: 1rem;
        right: 1rem;
        bottom: 1rem;
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .pdpImageBadge,
    .pdpImageHint {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.45rem 0.8rem;
        background: color-mix(in srgb, var(--color-bg) 82%, var(--color-secondary) 18%);
        border: 1px solid color-mix(in srgb, var(--color-primary) 12%, transparent);
        backdrop-filter: blur(10px);
        font-size: 0.78rem;
        color: var(--color-primary);
    }

    .pdpThumbRail {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(84px, 1fr));
        gap: 0.8rem;
    }

    .pdpThumbButton {
        border: 1px solid color-mix(in srgb, var(--color-primary) 10%, transparent);
        border-radius: 1rem;
        background: color-mix(in srgb, var(--color-bg) 95%, var(--color-secondary) 5%);
        padding: 0.35rem;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .pdpThumbButton:hover {
        transform: translateY(-1px);
        border-color: color-mix(in srgb, var(--color-primary) 28%, transparent);
    }

    .pdpThumbButton.active {
        border-color: var(--color-primary);
        box-shadow: 0 12px 28px color-mix(in srgb, var(--color-primary) 10%, transparent);
    }

    .pdp-thumb {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 0.7rem;
        display: block;
    }
</style>

<script>
    const mainImage = document.getElementById(
        "pdp-main-image",
    ) as HTMLImageElement | null;
    const thumbnails = document.querySelectorAll(".pdpThumbButton");

    thumbnails.forEach((thumb) => {
        thumb.addEventListener("click", () => {
            const fullUrl = (thumb as HTMLElement).dataset.full;
            if (fullUrl && mainImage) {
                mainImage.src = fullUrl;
                thumbnails.forEach((t) => t.classList.remove("active"));
                thumb.classList.add("active");
            }
        });
    });
</script>
