---
interface Props {
    floating?: boolean;
}

const { floating = false } = Astro.props;
---

<button
    type="button"
    class:list={["shopCartButton", floating && "isFloating"]}
    data-shop-cart-button
    aria-label="Open shopping cart"
>
    <span class="shopCartButtonIcon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="20" r="1.25"></circle>
            <circle cx="18" cy="20" r="1.25"></circle>
            <path d="M3 4h2l2.2 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H7.4"></path>
        </svg>
    </span>
    <span class="shopCartButtonCount" data-shop-cart-count hidden>0</span>
</button>

<style>
    .shopCartButton {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        border: 1px solid color-mix(in srgb, var(--color-primary) 22%, transparent);
        background:
            linear-gradient(
                135deg,
                color-mix(in srgb, var(--color-bg) 92%, var(--color-secondary) 8%),
                color-mix(in srgb, var(--color-bg) 96%, transparent)
            );
        color: var(--color-primary);
        border-radius: 999px;
        padding: 0.7rem 1rem;
        line-height: 1;
        cursor: pointer;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .shopCartButton:hover {
        transform: translateY(-1px);
        border-color: color-mix(in srgb, var(--color-primary) 40%, transparent);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--color-primary) 16%, transparent);
    }

    .shopCartButtonIcon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.25rem;
        height: 1.25rem;
    }

    .shopCartButtonIcon svg {
        width: 100%;
        height: 100%;
    }

    .shopCartButtonCount {
        min-width: 1.5rem;
        height: 1.5rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: var(--color-primary);
        color: var(--color-button-text, #fff);
        font-size: 0.78rem;
        padding: 0 0.35rem;
    }

    @media (max-width: 1024px) {
        .shopCartButton {
            padding: 0.65rem 0.85rem;
        }
    }

    .shopCartButton.isFloating {
        position: fixed;
        top: calc(var(--header-height, 100px) + 1rem);
        right: clamp(0.9rem, 2vw, 1.5rem);
        z-index: 90;
        box-shadow: 0 18px 34px color-mix(in srgb, var(--color-primary) 18%, transparent);
    }

    @media (max-width: 720px) {
        .shopCartButton.isFloating {
            top: calc(var(--header-height, 88px) + 0.75rem);
            right: 0.85rem;
        }
    }
</style>

<script>
    import { initOnAstroPageLoad } from "../../lib/client/init";
    import { initShopCartButton } from "../../lib/client/shopCartButton";

    initOnAstroPageLoad(initShopCartButton);
</script>
