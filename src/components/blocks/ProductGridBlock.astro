---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import { ALL_SHOP_QUERY } from "../../lib/sanity/queries";
import ShopCard from "../ui/ShopCard.astro";

const { title, limit } = Astro.props;

// Fetch shop items from Sanity
const shopItems = await getSanityContent(ALL_SHOP_QUERY);
const items = shopItems || [];

const displayedItems = limit ? items.slice(0, limit) : items;
---

<section class="product-grid-block">
    <div class="container">
        {title && <h2 class="section-title uppercase">{title}</h2>}
        <div class="grid">
            {
                displayedItems.map((item: any) => (
                    <ShopCard
                        url={item.url}
                        title={item.title}
                        price={item.price}
                        image={urlFor(item.image)}
                        productId={item.productId}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .product-grid-block {
        padding-block: var(--space-xl);
        background-color: var(--bg-page);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: clamp(40px, 4vw, 80px);
        justify-items: center;
    }

    @media (max-width: 640px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }
</style>
