---
/**
 * MediaTextBlock — Image + text side-by-side with configurable layout.
 */
import { urlFor } from "../../lib/sanity/image";
import {
    cropPresetToAspectRatio,
    imageEditStyleVars,
    resolveImageSource,
} from "../../lib/utils/mediaLayout";

interface Props {
    heading?: string;
    content?: string;
    image?: any;
    layout?: "imageLeft" | "imageRight" | "imageTop" | "imageBottom";
    mediaWidth?: "contained" | "wide" | "full";
    imageCropPreset?: any;
}

const {
    heading,
    content,
    image,
    layout = "imageLeft",
    mediaWidth = "contained",
    imageCropPreset = "natural",
} = Astro.props;
const imageDisplayStyle = Astro.props.imageDisplayStyle || "boxed";
const aspectRatio = cropPresetToAspectRatio(imageCropPreset);
const displayImage = resolveImageSource(
    image,
    Astro.props.backgroundRemovedImage,
    Astro.props.useBackgroundRemovedImage,
);
const imageStyles = [
    aspectRatio ? `--media-aspect-ratio: ${aspectRatio}` : "",
    displayImage ? `--media-background-image: url(${urlFor(displayImage)})` : "",
    imageEditStyleVars(Astro.props),
].filter(Boolean).join("; ");
---

<section
    class={`media-text media-text--${layout} media-text--${mediaWidth} media-text--display-${imageDisplayStyle}`}
    aria-label={heading || "Media and text"}
>
    <div class="media-text__inner">
        {
            displayImage && (
                <div class="media-text__media">
                    <img
                        src={urlFor(displayImage)}
                        alt={heading || ""}
                        loading="lazy"
                        style={imageStyles || undefined}
                    />
                    <span class="media-text__overlay" aria-hidden="true"></span>
                    <span class="media-text__vignette" aria-hidden="true"></span>
                    {Astro.props.imageMarkupText && (
                        <span class="media-text__markup">{Astro.props.imageMarkupText}</span>
                    )}
                </div>
            )
        }
        <div class="media-text__content">
            {heading && <h2 class="media-text__heading">{heading}</h2>}
            {content && <p class="media-text__body">{content}</p>}
        </div>
    </div>
</section>

<style>
    .media-text {
        padding: clamp(2rem, 5vw, 4rem) 0;
    }
    .media-text__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        align-items: center;
    }
    .media-text--wide .media-text__inner {
        max-width: 1440px;
    }
    .media-text--full .media-text__inner {
        max-width: none;
        padding-inline: 0;
    }
    .media-text--display-fullWidthBleed .media-text__inner {
        max-width: none;
        padding-inline: 0;
    }
    .media-text--display-fullScreen {
        min-height: 100dvh;
        display: grid;
        align-items: center;
    }
    .media-text--display-fullScreen .media-text__inner {
        min-height: 100dvh;
    }
    .media-text--display-asymmetric .media-text__inner {
        grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    }
    .media-text--display-fixedBackground .media-text__media img {
        opacity: 0;
    }
    .media-text--display-fixedBackground .media-text__media {
        min-height: min(70vh, 720px);
        background-image: var(--media-background-image);
        background-size: cover;
        background-position: var(--image-object-position, center center);
        background-attachment: fixed;
    }
    @media (min-width: 768px) {
        .media-text__inner {
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }
        .media-text--imageRight .media-text__media {
            order: 2;
        }
    }
    .media-text__media img {
        width: 100%;
        aspect-ratio: var(--media-aspect-ratio, auto);
        object-fit: cover;
        object-position: var(--image-object-position, center center);
        border-radius: inherit;
        transform: var(--image-transform, none);
        filter: var(--image-filter, none);
        display: block;
    }
    .media-text__media {
        position: relative;
        overflow: hidden;
        border-radius: var(--image-frame-radius, 0.75rem);
        border: var(--image-frame-border-width, 0) solid var(--image-frame-border-color, transparent);
        padding: var(--image-frame-padding, 0);
        background: var(--image-frame-background, transparent);
        box-shadow: var(--image-frame-shadow, none);
    }
    .media-text__overlay,
    .media-text__vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
        border-radius: inherit;
    }
    .media-text__overlay {
        background: var(--image-overlay-color, #000);
        opacity: var(--image-overlay-opacity, 0);
    }
    .media-text__vignette {
        opacity: var(--image-vignette-opacity, 0);
        background: radial-gradient(circle, transparent 48%, rgba(0, 0, 0, 0.74) 100%);
    }
    .media-text__markup {
        position: absolute;
        inset: auto 1rem 1rem auto;
        z-index: 2;
        max-width: min(24rem, 75%);
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.62);
        color: #fff;
        padding: 0.45rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 700;
    }
    .media-text--imageTop .media-text__inner,
    .media-text--imageBottom .media-text__inner {
        grid-template-columns: 1fr;
        max-width: 960px;
    }
    .media-text--imageBottom .media-text__media {
        order: 2;
    }
    .media-text__heading {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 800;
        margin-bottom: 0.75rem;
    }
    .media-text__body {
        line-height: 1.7;
        opacity: 0.85;
    }
</style>
