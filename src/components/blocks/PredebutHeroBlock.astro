---
import { Icon } from "astro-icon/components";
import { urlFor } from "../../utils/sanity";

const {
    top_text = "we are amii",
    image,
    status_text = "LOADING...",
    cta_text = "JOIN THE QUEUE",
    cta_link = "#",
} = Astro.props;

// Image swapping removed per request
---

<section class="predebut-hero">
    <!-- Top Text -->
    <div class="top-text">{top_text}</div>

    <!-- Main Image -->
    {
        image && (
            <div class="hero-image">
                <img src={urlFor(image)} alt="Amii Avatars" />
            </div>
        )
    }

    <!-- Welcome Banner Container -->
    <predebut-hero class="welcome-banner">
        <!-- Loading Text -->
        <h1 class="loading-text" data-status={status_text}>
            {status_text}
        </h1>

        <!-- Join Queue CTA -->
        <a href={cta_link} class="cta-queue">
            {cta_text}
        </a>

        <!-- Down Arrow SVG -->
        <svg
            class="down-arrow-svg"
            width="14"
            height="48"
            viewBox="0 0 14 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M7 0V46M7 46L1 40M7 46L13 40"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </predebut-hero>
</section>

<style>
    /* Predebut Hero Structure */
    .predebut-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: var(--space-lg);
        padding-bottom: 40px;
        gap: 32px;
        width: 100%;
        background: var(--bg-page);
        color: var(--text-main);
        height: auto; /* Flexible height */
        transition:
            background-color 0.4s ease,
            color 0.4s ease;
    }

    /* Top Text */
    .top-text {
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: clamp(18px, 1.5vw, 32px); /* Fluid Top Text */
        line-height: 20px;
        text-align: center;
        text-transform: lowercase;
        order: 0;
    }

    /* Hero Image */
    .hero-image {
        order: 1;
        width: 100%;
        width: 100%;
        max-width: 90vw; /* Scales with viewport width */
        display: flex;
        justify-content: center;
        position: relative;
    }

    .hero-image img {
        width: 100%;
        height: auto;
        object-fit: contain;
        display: block;
    }

    /* Welcome Banner Group */
    .welcome-banner {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
        gap: 24px;
        order: 2;
        width: 100%;
        width: 100%;
        max-width: 100%; /* Allow text to expand fully */
    }

    /* Loading Text - Starbim */
    .loading-text {
        font-family: var(--font-heading);
        font-weight: var(--weight-regular);
        font-size: clamp(
            2rem,
            10vw,
            180px
        ); /* Reduced from 12vw/240px to prevent overflow on 2K/150% */
        line-height: 1.1;
        text-align: center;
        color: var(--text-main);
        text-shadow: none; /* Ensure clean look */
        margin: 0;
        white-space: nowrap; /* Prevent wrapping */
        visibility: hidden; /* Hide until JS splits it to prevent FOUC */
    }

    .loading-text.visible {
        visibility: visible;
    }

    :global(.loading-char),
    :global(.dot) {
        display: inline-block;
        white-space: pre;
    }

    /* Join Queue CTA */
    .cta-queue {
        font-family: var(--font-body);
        font-weight: var(--weight-bold);
        font-size: 20px;
        line-height: 22px;
        text-align: center;
        color: var(--text-main);
        text-decoration: none;
        text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.25);
        cursor: pointer;
        padding-bottom: 10px; /* Slight gap before arrow */
    }

    .cta-queue:hover {
        text-decoration: underline;
    }

    .down-arrow-svg {
        display: block;
        color: var(--text-main); /* Controlled by currentColor */
    }
</style>

<script>
    import { gsap } from "gsap";

    class PredebutHero extends HTMLElement {
        constructor() {
            super();
            this.init();
        }

        init() {
            const loadingText = this.querySelector(".loading-text");
            if (loadingText) {
                // Get text and clear content
                const originalText =
                    loadingText.getAttribute("data-status") || "LOADING...";
                loadingText.textContent = "";

                // Split text into lines/chars logic
                // Separate trailing dots for consistency
                const match = originalText.match(/^(.*?)(\.*)$/);
                const mainText = match ? match[1] : originalText;
                const dots = match ? match[2] : "";

                // Create fragment to hold new nodes
                const fragment = document.createDocumentFragment();

                // Add main chars
                mainText.split("").forEach((char) => {
                    const span = document.createElement("span");
                    span.className = "loading-char";
                    span.textContent = char;
                    fragment.appendChild(span);
                });

                // Add dots
                if (dots) {
                    const dotsWrapper = document.createElement("span");
                    dotsWrapper.className = "dots-wrapper";
                    dots.split("").forEach((dot) => {
                        const span = document.createElement("span");
                        span.className = "dot";
                        span.textContent = dot;
                        dotsWrapper.appendChild(span);
                    });
                    fragment.appendChild(dotsWrapper);
                }

                loadingText.appendChild(fragment);
                loadingText.classList.add("visible");

                // Animate
                const chars = this.querySelectorAll(".loading-char, .dot");
                if (chars.length > 0) {
                    gsap.to(chars, {
                        y: -15,
                        duration: 0.5,
                        ease: "sine.inOut",
                        repeat: -1,
                        yoyo: true,
                        stagger: 0.1,
                    });
                }
            }

            // Down Arrow Animation
            const arrow = this.querySelector(".down-arrow-svg");
            if (arrow) {
                gsap.to(arrow, {
                    y: 10,
                    duration: 1.5,
                    ease: "power1.inOut",
                    repeat: -1,
                    yoyo: true,
                });
            }
        }
    }

    customElements.define("predebut-hero", PredebutHero);
</script>
