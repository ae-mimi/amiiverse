---
import { Icon } from "astro-icon/components";
import { urlFor } from "../../utils/sanity";

const {
    top_text = "we are amii",
    image,
    status_text = "LOADING...",
    cta_text = "JOIN THE QUEUE",
    cta_link = "#",
} = Astro.props;

// Image swapping removed per request
---

<section class="predebut-hero">
    <!-- Top Text -->
    <div class="top-text">{top_text}</div>

    <!-- Main Image -->
    {
        image && (
            <div class="hero-image">
                <img src={urlFor(image)} alt="Amii Avatars" />
            </div>
        )
    }

    <!-- Welcome Banner Container -->
    <predebut-hero class="welcome-banner">
        <!-- Loading Text -->
        <h1 class="loading-text" aria-label={status_text}>
            {
                status_text
                    .replace(/\.+$/, "")
                    .split("")
                    .map((char: string) => (
                        <span class="loading-char" aria-hidden="true">
                            {char}
                        </span>
                    ))
            }
            <span class="dots-wrapper" aria-hidden="true">
                <span class="dot">.</span><span class="dot">.</span><span
                    class="dot">.</span
                >
            </span>
        </h1>

        <!-- Join Queue CTA -->
        <a href={cta_link} class="cta-queue">
            {cta_text}
        </a>

        <!-- Down Arrow SVG -->
        <svg
            class="down-arrow-svg"
            width="14"
            height="48"
            viewBox="0 0 14 48"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M7 0V46M7 46L1 40M7 46L13 40"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </predebut-hero>
</section>

<style>
    /* Predebut Hero Structure */
    .predebut-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 0;
        padding-bottom: 40px;
        gap: 32px;
        width: 100%;
        background: var(--bg-page);
        color: var(--text-main);
        min-height: 100vh; /* Ensure it takes up full screen */
        transition:
            background-color 0.4s ease,
            color 0.4s ease;
    }

    /* Top Text */
    .top-text {
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: 18px;
        line-height: 20px;
        text-align: center;
        text-transform: lowercase;
        order: 0;
    }

    /* Hero Image */
    .hero-image {
        order: 1;
        width: 100%;
        width: 100%;
        max-width: 1400px; /* Increased from 871px for 4K */
        display: flex;
        justify-content: center;
        position: relative;
    }

    .hero-image img {
        width: 100%;
        height: auto;
        object-fit: contain;
        display: block;
    }

    /* Welcome Banner Group */
    .welcome-banner {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px;
        gap: 24px;
        order: 2;
        width: 100%;
        width: 100%;
        max-width: 100%; /* Allow text to expand fully */
    }

    /* Loading Text - Starbim */
    .loading-text {
        font-family: var(--font-heading);
        font-weight: var(--weight-regular);
        font-size: clamp(
            2rem,
            8vw,
            120px
        ); /* Decreased lower bound for mobile */
        line-height: 1.1;
        text-align: center;
        color: var(--text-main);
        text-shadow: none; /* Ensure clean look */
        margin: 0;
        white-space: nowrap; /* Prevent wrapping */
    }

    .loading-char,
    .dot {
        display: inline-block;
        white-space: pre;
    }

    /* Join Queue CTA */
    .cta-queue {
        font-family: var(--font-body);
        font-weight: var(--weight-bold);
        font-size: 20px;
        line-height: 22px;
        text-align: center;
        color: var(--text-main);
        text-decoration: none;
        text-shadow: 0px 1px 4px rgba(0, 0, 0, 0.25);
        cursor: pointer;
        padding-bottom: 10px; /* Slight gap before arrow */
    }

    .cta-queue:hover {
        text-decoration: underline;
    }

    .down-arrow-svg {
        display: block;
        color: var(--text-main); /* Controlled by currentColor */
    }
</style>

<script>
    import { gsap } from "gsap";

    class PredebutHero extends HTMLElement {
        constructor() {
            super();

            // Scope selectors to this specific component instance
            const chars = this.querySelectorAll(".loading-char, .dot");

            if (chars.length > 0) {
                // Continuous Wave Animation
                gsap.to(chars, {
                    y: -15, // Jump up 15px
                    duration: 0.5,
                    ease: "sine.inOut",
                    repeat: -1,
                    yoyo: true,
                    stagger: 0.1,
                });
            }

            // Down Arrow Animation
            const arrow = this.querySelector(".down-arrow-svg");
            if (arrow) {
                gsap.to(arrow, {
                    y: 10, // Move down 10px
                    duration: 1.5,
                    ease: "power1.inOut",
                    repeat: -1,
                    yoyo: true,
                    stagger: 0.1, // Stagger irrelevant for single element but harmless
                });
            }
        }
    }

    customElements.define("predebut-hero", PredebutHero);
</script>
