---
/**
 * DownloadsCenterBlock — Grid of downloadable assets (EPK, logos, etc.)
 */
import { fetchSanity } from "../../lib/sanity/client";
import { ALL_DOWNLOADS_QUERY } from "../../lib/sanity/queries";
import { urlFor } from "../../lib/sanity/image";
import type { DownloadableAsset } from "../../lib/sanity/types";

interface Props {
    title?: string;
    assets?: DownloadableAsset[];
    epkProfile?: { featuredAssets?: DownloadableAsset[] };
    showCategoryFilters?: boolean;
    visibleCategories?: DownloadableAsset["category"][];
    mediaWidth?: "contained" | "wide" | "full";
}

const {
    title = "Downloads",
    assets: passedAssets,
    epkProfile,
    showCategoryFilters = false,
    visibleCategories = [],
    mediaWidth = "contained",
} = Astro.props;

const allAssets =
    (passedAssets?.length ? passedAssets : undefined) ||
    (epkProfile?.featuredAssets?.length ? epkProfile.featuredAssets : undefined) ||
    (await fetchSanity<DownloadableAsset[]>(ALL_DOWNLOADS_QUERY)) ||
    [];

const activeCategorySet = new Set((visibleCategories || []).filter(Boolean));
const assets =
    activeCategorySet.size > 0
        ? allAssets.filter((asset) => asset.category && activeCategorySet.has(asset.category))
        : allAssets;

const categoryLabels: Record<string, string> = {
    epkPdf: "EPK PDF",
    bioPdf: "Bio PDF",
    pressPhoto: "Press Photos",
    albumArt: "Album Art",
    logo: "Logos",
    rider: "Rider",
    stagePlot: "Stage Plot",
    promoClip: "Promo Clips",
    misc: "Misc",
    epk: "EPK",
    photo: "Photos",
};

const categories = Array.from(
    new Set(assets.map((asset) => asset.category).filter(Boolean)),
) as string[];
---

<section class={`downloads-center downloads-center--${mediaWidth}`} aria-label={title}>
    <div class="downloads-center__inner">
        <h2 class="downloads-center__title">{title}</h2>

        {
            assets.length === 0 ? (
                <p class="downloads-center__empty">
                    No downloads available yet.
                </p>
            ) : (
                <>
                    {showCategoryFilters && categories.length > 1 && (
                        <div class="downloads-center__filters" aria-label="Download categories">
                            <button type="button" class="downloads-center__filter is-active" data-download-filter="all">
                                All
                            </button>
                            {categories.map((category) => (
                                <button type="button" class="downloads-center__filter" data-download-filter={category}>
                                    {categoryLabels[category] || category}
                                </button>
                            ))}
                        </div>
                    )}

                    <div class="downloads-center__grid" data-download-grid>
                        {assets.map((a) => (
                            <a
                                href={a.fileUrl || "#"}
                                class="download-card"
                                data-download-category={a.category || ""}
                                download
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label={`Download ${a.title}`}
                            >
                                {a.previewImage && (
                                    <img
                                        src={urlFor(a.previewImage)}
                                        alt={a.title}
                                        loading="lazy"
                                        class="download-card__img"
                                    />
                                )}
                                <div class="download-card__info">
                                    {a.category && (
                                        <span class="download-card__cat">
                                            {categoryLabels[a.category] ||
                                                a.category}
                                        </span>
                                    )}
                                    <h3 class="download-card__title">{a.title}</h3>
                                    {a.usageRights && (
                                        <p class="download-card__rights">
                                            {a.usageRights}
                                        </p>
                                    )}
                                </div>
                            </a>
                        ))}
                    </div>
                </>
            )
        }
    </div>
</section>

{
    showCategoryFilters && (
        <script>
            document.querySelectorAll(".downloads-center").forEach((section) => {
                const filters = Array.from(section.querySelectorAll("[data-download-filter]"));
                const cards = Array.from(section.querySelectorAll("[data-download-category]"));
                filters.forEach((filter) => {
                    filter.addEventListener("click", () => {
                        const value = filter.dataset.downloadFilter || "all";
                        filters.forEach((button) => button.classList.toggle("is-active", button === filter));
                        cards.forEach((card) => {
                            const matches = value === "all" || card.dataset.downloadCategory === value;
                            card.hidden = !matches;
                        });
                    });
                });
            });
        </script>
    )
}

<style>
    .downloads-center {
        padding: clamp(2rem, 5vw, 4rem) 0;
    }
    .downloads-center__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .downloads-center--wide .downloads-center__inner {
        max-width: 1440px;
    }
    .downloads-center--full .downloads-center__inner {
        max-width: none;
        padding-inline: 0;
    }
    .downloads-center__title {
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 800;
        margin-bottom: 2rem;
        text-align: center;
    }
    .downloads-center__empty {
        text-align: center;
        opacity: 0.6;
        padding: 3rem 0;
    }
    .downloads-center__filters {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }
    .downloads-center__filter {
        border: 1px solid color-mix(in srgb, var(--color-primary), transparent 70%);
        border-radius: 999px;
        background: transparent;
        color: var(--color-primary);
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .downloads-center__filter.is-active,
    .downloads-center__filter:hover {
        background: var(--color-primary);
        color: var(--color-secondary);
    }
    .downloads-center__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
        gap: 1.5rem;
    }
    .download-card {
        text-decoration: none;
        color: inherit;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 0.75rem;
        overflow: hidden;
        transition:
            transform 0.2s,
            box-shadow 0.2s;
    }
    .download-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
    }
    .download-card__img {
        width: 100%;
        aspect-ratio: 4/3;
        object-fit: cover;
    }
    .download-card__info {
        padding: 1rem;
    }
    .download-card__cat {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.5;
    }
    .download-card__title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0.15rem 0 0.25rem;
    }
    .download-card__rights {
        font-size: 0.75rem;
        opacity: 0.5;
        margin: 0;
    }
</style>
