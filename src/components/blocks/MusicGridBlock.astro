---
import MusicCard from "../ui/MusicCard.astro";
import { formatDateLong } from "../../lib/utils/format";

interface MusicItem {
    id: string;
    slug: string;
    title: string;
    description?: string;
    date?: string;
    cover_image_url?: string;
    spotify?: string;
    apple_music?: string;
    youtube_music?: string;
    audio_url?: string;
}

const { title } = Astro.props;
let initialItems: MusicItem[] = [];
const isMusicPage = Astro.url.pathname === "/music" || Astro.url.pathname.startsWith("/music/");

try {
    const apiUrl = new URL("/api/music/search", Astro.url);
    const response = await fetch(apiUrl.toString());
    if (response.ok) {
        const data = (await response.json()) as { items?: MusicItem[] };
        initialItems = Array.isArray(data.items) ? data.items : [];
    }
} catch (error) {
    console.error("[MusicGridBlock] Failed to load initial music items", error);
}
---

<section class="music-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}

        {
            isMusicPage && (
                <div class="music-search-wrap">
                    <label class="srOnly" for="music-search">Search music</label>
                    <input
                        id="music-search"
                        class="music-search-input input-shape-pill"
                        type="search"
                        placeholder="Search songs"
                        autocomplete="off"
                    />
                </div>
            )
        }

        <div class="music-list" data-music-list>
            {initialItems.map((item: any) => <MusicCard item={item} />)}
        </div>

        {isMusicPage && <p class="music-empty-state" data-music-empty hidden>
            No music results found.
        </p>}
    </div>
</section>

{
    isMusicPage && (
<script>
    import { initOnAstroPageLoad } from "../../lib/client/init";
    interface MusicItem {
        id: string;
        slug: string;
        title: string;
        description?: string;
        date?: string;
        cover_image_url?: string;
        spotify?: string;
        apple_music?: string;
        youtube_music?: string;
        audio_url?: string;
    }

    function initMusicSearch() {
        const searchInput = document.getElementById(
            "music-search",
        ) as HTMLInputElement | null;
        const list = document.querySelector("[data-music-list]") as HTMLElement | null;
        const emptyState = document.querySelector(
            "[data-music-empty]",
        ) as HTMLElement | null;

        if (!searchInput || !list || !emptyState) return;

        let timer: number | null = null;

        function escapeHtml(value: string): string {
            return value
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#39;");
        }

        function render(items: MusicItem[]) {
            if (!items.length) {
                if (list) list.innerHTML = "";
                if (emptyState) emptyState.hidden = false;
                return;
            }

            if (emptyState) emptyState.hidden = true;
            if (list) list.innerHTML = items
                .map((item) => {
                    const title = escapeHtml(item.title || "Untitled");
                    const cover = escapeHtml(item.cover_image_url || "");
                    const spotify = escapeHtml(item.spotify || "");
                    const date = formatDateLong(item.date || "");
                    return `
                        <div class="music-item">
                            <div class="cover-art">
                                <img src="${cover}" alt="${title}" loading="lazy" />
                            </div>
                            <div class="music-info">
                                <h3 class="music-title">${title}</h3>
                                <p class="music-date">${date}</p>
                                ${
                                    spotify
                                        ? `<a href="${spotify}" target="_blank" class="spotify-link" rel="noopener noreferrer">
                                            <span>Listen on Spotify</span>
                                          </a>`
                                        : ""
                                }
                            </div>
                        </div>
                    `;
                })
                .join("");
        }

        async function runSearch(query: string) {
            try {
                const response = await fetch(
                    `/api/music/search?query=${encodeURIComponent(query)}`,
                );
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = (await response.json()) as { items?: MusicItem[] };
                render(Array.isArray(data.items) ? data.items : []);
            } catch (error) {
                console.error("[music-search] failed", error);
                render([]);
            }
        }

        searchInput.addEventListener("input", (e) => {
            const value = (e.target as HTMLInputElement).value.trim();
            if (timer) window.clearTimeout(timer);
            timer = window.setTimeout(() => runSearch(value), 250);
        });
    }

    initOnAstroPageLoad(initMusicSearch);
        </script>
    )
}

<style>
    .music-grid-block {
        height: auto;
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .music-search-wrap {
        max-width: 560px;
        margin: 0 auto 2rem;
    }

    .music-search-input {
        width: 100%;
        --field-padding-block: 0.85rem;
        --field-padding-inline: 1.1rem;
        --field-bg: color-mix(in srgb, var(--color-bg), var(--color-white) 4%);
        --field-text-color: var(--text-main);
        --field-border-color: color-mix(in srgb, var(--input-border), transparent 75%);
    }

    .music-list {
        display: flex;
        flex-direction: column;
        gap: clamp(40px, 4vw, 80px);
        max-width: 1280px;
        margin: 0 auto;
    }

    .music-empty-state {
        text-align: center;
        opacity: 0.7;
        margin-top: 1rem;
    }
</style>
