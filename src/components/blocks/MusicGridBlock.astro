---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import { LEGACY_MUSIC_QUERY } from "../../lib/sanity/queries";
import MusicCard from "../ui/MusicCard.astro";

const { title } = Astro.props;
const musicItems = await getSanityContent(LEGACY_MUSIC_QUERY);
const sortedMusic = musicItems || [];
---

<section class="music-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="music-list">
            {sortedMusic.map((item: any) => <MusicCard item={item} />)}
        </div>
    </div>
</section>

<style>
    .music-grid-block {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .music-list {
        display: flex;
        flex-direction: column;
        gap: clamp(40px, 4vw, 80px); /* Fluid gap */
        max-width: 1280px; /* Keep list constrained reasonably within container */
        margin: 0 auto;
    }
</style>
