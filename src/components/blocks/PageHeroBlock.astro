---
const {
    title,
    subtitle,
    backgroundColor = "transparent",
    borderColor = "none",
    subtitleColor = "#666666",
} = Astro.props;
---

<section
    class="page-hero"
    style={{
        backgroundColor: backgroundColor,
        border: borderColor !== "none" ? `1px solid ${borderColor}` : "none",
    }}
>
    <div class="hero-content">
        <h1 class="hero-title" set:html={title} />
        <p class="hero-subtitle" style={{ color: subtitleColor }}>{subtitle}</p>
    </div>
</section>

<style>
    .page-hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: var(--space-md) var(--space-sm);
        width: 100%;
        max-width: 2560px; /* Match global container cap */
        margin: 0 auto;
        height: auto; /* Ensure it fits content */
        box-sizing: border-box; /* Ensure padding doesn't add to width */
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: var(--space-xs);
        width: 100%;
    }

    .hero-title {
        font-family: "Starbim", sans-serif;
        font-style: normal;
        font-weight: 400;
        font-size: clamp(48px, 6vw, 140px); /* Fluid 4K scaling */
        line-height: 1.1;
        display: flex;
        align-items: center;
        text-align: center;
        color: #15499d;
        margin: 0;
    }

    .hero-subtitle {
        font-family: "Archivo", sans-serif;
        font-style: normal;
        font-weight: 400;
        font-size: clamp(16px, 1.5vw, 32px); /* Fluid 4K scaling */
        line-height: 17px;
        display: flex;
        align-items: center;
        text-align: center;
        /* Color set via inline style for override */
        margin: 0;
    }

    @media (max-width: 768px) {
        .hero-title {
            font-size: 48px;
            line-height: 1.1;
        }
        .hero-subtitle {
            font-size: 16px;
        }
    }
</style>
