---
import { urlFor } from "../../lib/sanity/image";
import type { Gallery } from "../../lib/sanity/types";
import { cropPresetToAspectRatio, imageEditStyleVars } from "../../lib/utils/mediaLayout";

interface Props {
    title?: string;
    gallery?: Gallery;
    columns?: 2 | 3 | 4;
    mediaWidth?: "contained" | "wide" | "full";
    imageCropPreset?: any;
    teaserLimit?: number;
    showGalleryLink?: boolean;
    galleryLinkText?: string;
}

const {
    title,
    gallery,
    columns = 3,
    mediaWidth = "contained",
    imageCropPreset = "landscape43",
    teaserLimit,
    showGalleryLink = false,
    galleryLinkText = "View the gallery",
} = Astro.props;
const allItems = gallery?.items || [];
const items = typeof teaserLimit === "number" && teaserLimit > 0
    ? allItems.slice(0, teaserLimit)
    : allItems;
const hasMore = allItems.length > items.length;
const heading = title || gallery?.title;
const aspectRatio = cropPresetToAspectRatio(imageCropPreset) || "4 / 3";
const imageStyles = imageEditStyleVars(Astro.props);
---

<section
    class={`library-gallery library-gallery--${columns} library-gallery--${mediaWidth}`}
    aria-label={heading || "Gallery"}
    style={`--gallery-aspect-ratio: ${aspectRatio}; ${imageStyles}`}
>
    <div class="library-gallery__inner">
        {heading && <h2 class="library-gallery__title">{heading}</h2>}

        {
            items.length === 0 ? (
                <p class="library-gallery__empty">No gallery photos yet.</p>
            ) : (
                <div class="library-gallery__grid">
                    {items.map((item) => (
                        <figure class="library-gallery__item">
                            <img
                                src={urlFor(item.image)}
                                alt={item.alt || item.caption || gallery?.title || "Gallery image"}
                                loading="lazy"
                                class="library-gallery__image"
                            />
                            {(item.caption || item.credit) && (
                                <figcaption class="library-gallery__caption">
                                    {item.caption}
                                    {item.credit && <span>{item.caption ? " · " : ""}{item.credit}</span>}
                                </figcaption>
                            )}
                        </figure>
                    ))}
                    {showGalleryLink && hasMore && (
                        <a href="/gallery" class="library-gallery__more">
                            <span>{galleryLinkText}</span>
                        </a>
                    )}
                </div>
            )
        }
    </div>
</section>

<style>
    .library-gallery {
        padding: clamp(2rem, 5vw, 4rem) 0;
    }

    .library-gallery__inner {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .library-gallery--wide .library-gallery__inner {
        max-width: 1440px;
    }

    .library-gallery--full .library-gallery__inner {
        max-width: none;
        padding-inline: 0;
    }

    .library-gallery__title {
        margin: 0 0 2rem;
        text-align: center;
        font-family: var(--font-heading);
        font-size: clamp(1.8rem, 4vw, 3rem);
        color: var(--text-main);
    }

    .library-gallery__empty {
        text-align: center;
        color: var(--text-muted);
    }

    .library-gallery__grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(1, minmax(0, 1fr));
    }

    @media (min-width: 640px) {
        .library-gallery--2 .library-gallery__grid,
        .library-gallery--3 .library-gallery__grid,
        .library-gallery--4 .library-gallery__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 980px) {
        .library-gallery--3 .library-gallery__grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .library-gallery--4 .library-gallery__grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }

    .library-gallery__item {
        margin: 0;
        overflow: hidden;
        border-radius: var(--image-frame-radius, 0.75rem);
        border: var(--image-frame-border-width, 0) solid var(--image-frame-border-color, transparent);
        padding: var(--image-frame-padding, 0);
        background: var(--image-frame-background, transparent);
        box-shadow: var(--image-frame-shadow, none);
    }

    .library-gallery__image {
        width: 100%;
        aspect-ratio: var(--gallery-aspect-ratio, 4 / 3);
        object-fit: cover;
        object-position: var(--image-object-position, center center);
        transform: var(--image-transform, none);
        filter: var(--image-filter, none);
        border-radius: inherit;
        display: block;
    }

    .library-gallery__caption {
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.4;
    }

    .library-gallery__more {
        min-height: 12rem;
        border: 2px solid var(--color-primary);
        border-radius: var(--image-frame-radius, 0.75rem);
        color: var(--color-primary);
        display: grid;
        place-items: center;
        padding: 1.5rem;
        text-align: center;
        text-decoration: none;
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 3vw, 2rem);
        background: color-mix(in srgb, var(--color-primary), transparent 94%);
    }

    .library-gallery__more:hover {
        background: var(--color-primary);
        color: var(--color-secondary);
    }
</style>
