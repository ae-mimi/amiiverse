---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import MemberCard from "../ui/MemberCard.astro";

const { title } = Astro.props;
const members = (await getSanityContent(`*[_type == "member"]`)) || [];
---

<section class="members-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="members-grid">
            {members.map((member: any) => <MemberCard member={member} />)}
        </div>
    </div>
</section>

<style>
    .members-grid-block {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .members-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: clamp(40px, 4vw, 80px); /* Fluid gap */
        justify-items: center;
    }
</style>
