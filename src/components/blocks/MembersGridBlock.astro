---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { ALL_MEMBERS_QUERY } from "../../lib/sanity/queries";
import { cropPresetToAspectRatio, imageEditStyleVars } from "../../lib/utils/mediaLayout";
import MemberCard from "../ui/MemberCard.astro";

const { title, members: selectedMembers, imageCropPreset = "square" } = Astro.props;
const members = selectedMembers?.length
    ? selectedMembers
    : (await getSanityContent(ALL_MEMBERS_QUERY)) || [];
const aspectRatio = cropPresetToAspectRatio(imageCropPreset) || "1 / 1";
const imageStyles = [
    `--member-image-aspect-ratio: ${aspectRatio}`,
    imageEditStyleVars(Astro.props),
].join("; ");
---

<section class="members-grid-block">
    <div class="container" style={imageStyles}>
        {title && <h2 class="section-title">{title}</h2>}
        <div class="members-grid">
            {members.map((member: any) => <MemberCard member={member} />)}
        </div>
    </div>
</section>

<style>
    .members-grid-block {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .members-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: clamp(40px, 4vw, 80px); /* Fluid gap */
        justify-items: center;
    }
</style>
