---
import { getCollection } from "astro:content";

const { title } = Astro.props;
const members = await getCollection("members");
---

<section class="members-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="members-grid">
            {
                members.map((member) => (
                    <div class="member-card">
                        <div class="member-image">
                            <img
                                src={member.data.image}
                                alt={member.data.name}
                                loading="lazy"
                            />
                        </div>
                        <h3 class="member-name">{member.data.name}</h3>
                        <p class="member-role">{member.data.role}</p>
                        <p class="member-fact">{member.data.fact}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .members-grid-block {
        padding: 60px 20px;
        background-color: var(--bg-page);
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }
    .section-title {
        font-family: var(--font-heading);
        font-size: 40px;
        color: var(--text-main);
        text-align: center;
        margin-bottom: 40px;
    }
    .members-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 40px;
        justify-items: center;
    }
    .member-card {
        text-align: center;
        max-width: 300px;
    }
    .member-image img {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 20px;
        border: 4px solid var(--text-main);
    }
    .member-name {
        font-family: var(--font-heading);
        font-size: 24px;
        color: var(--text-main);
        margin: 0 0 5px 0;
    }
    .member-role {
        font-family: var(--font-body);
        font-weight: bold;
        color: var(--text-main);
        opacity: 0.8;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .member-fact {
        font-family: var(--font-body);
        color: var(--text-main);
        font-style: italic;
    }
</style>
