---
import { urlFor } from "../../lib/sanity/image";
import { mediaWidthClass } from "../../lib/utils/mediaLayout";

const {
    title,
    subtitle,
    description,
    image,
    mediaWidth = "contained",
    contentOrder = ["image", "title", "subtitle", "description", "buttons"],
    cta_primary,
    cta_primary_link,
    cta_secondary,
    cta_secondary_link,
} = Astro.props;

const order = (key: string) => {
    const index = Array.isArray(contentOrder) ? contentOrder.indexOf(key) : -1;
    return index === -1 ? 99 : index + 1;
};
const copyKeys = ["title", "subtitle", "description", "buttons"];
const copyOrder = Math.min(...copyKeys.map(order));
---

<section
    class={mediaWidthClass("hero-section", mediaWidth)}
>
    {
        image && (
            <div class="hero-graphic" style={`order: ${order("image")}`}>
                <img src={urlFor(image)} alt={title} />
            </div>
        )
    }

    <div class="hero-copy" style={`order: ${copyOrder}`}>
        {title && <h1 class="hero-title" style={`order: ${order("title")}`}>{title}</h1>}
        {subtitle && <p class="hero-subtitle" style={`order: ${order("subtitle")}`}>{subtitle}</p>}
        {description && <p class="hero-subtitle" style={`order: ${order("description")}`}>{description}</p>}

        <div class="cta-group" style={`order: ${order("buttons")}`}>
            {
                cta_primary && (
                    <a href={cta_primary_link || "#"} class="btn btn-primary">
                        {cta_primary}
                    </a>
                )
            }
            {
                cta_secondary && (
                    <a href={cta_secondary_link || "#"} class="btn-text-link">
                        {cta_secondary}
                    </a>
                )
            }
        </div>
    </div>
</section>

<style>
    .hero-section {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 1.25rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        overflow: clip;
    }

    .hero-section--wide {
        max-width: 1440px;
    }

    .hero-section--full {
        max-width: none;
        padding-inline: 0;
    }

    .hero-graphic {
        width: 100%;
        display: flex;
        justify-content: center;
        position: relative;
        overflow: hidden;
        border-radius: 0;
    }

    .hero-graphic img {
        width: 100%;
        max-width: 100%;
        max-height: 70vh;
        aspect-ratio: auto;
        object-fit: cover;
        object-position: center center;
        margin-inline: auto;
        border-radius: inherit;
        display: block;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
        width: min(100%, 64rem);
        position: relative;
        z-index: 2;
    }

    .hero-section--contained .hero-graphic img {
        width: auto;
        max-width: 90vw;
    }

    .hero-title {
        font-size: 3rem;
        color: var(--color-primary);
        text-transform: uppercase;
        line-height: 0.9;
        margin: 0;
    }

    .hero-subtitle {
        max-width: 60ch;
        width: 100%;
        margin-inline: auto;
        margin-block: 0;
        color: var(--color-primary);
        font-size: 1rem;
        line-height: 1.5;
    }

    .cta-group {
        margin-top: 0.4rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .btn-text-link {
        color: var(--color-primary);
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: underline;
        font-size: 0.9rem;
    }

    @media (min-width: 48rem) {
        .hero-title {
            font-size: 4.75rem;
        }

        .hero-subtitle {
            font-size: 1.2rem;
        }

        .cta-group {
            flex-direction: row;
            justify-content: center;
        }
    }

    @media (min-width: 64rem) {
        .hero-section {
            padding: 5rem 2rem;
            gap: 2rem;
        }

        .hero-title {
            font-size: 6.75rem;
        }

    }

    @media (min-width: 80rem) {
        .hero-title {
            font-size: 8rem;
        }
    }
</style>
