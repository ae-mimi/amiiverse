---
import { urlFor } from "../../lib/sanity/image";
import { cropPresetToAspectRatio, mediaWidthClass } from "../../lib/utils/mediaLayout";

const {
    title,
    subtitle,
    description,
    image,
    mediaWidth = "contained",
    imageCropPreset = "natural",
    contentOrder = ["image", "title", "subtitle", "description", "buttons"],
    cta_primary,
    cta_primary_link,
    cta_secondary,
    cta_secondary_link,
} = Astro.props;

const aspectRatio = cropPresetToAspectRatio(imageCropPreset);
const order = (key: string) => {
    const index = Array.isArray(contentOrder) ? contentOrder.indexOf(key) : -1;
    return index === -1 ? 99 : index + 1;
};
---

<section class={mediaWidthClass("hero-section", mediaWidth)}>
    <!-- Main Graphic -->
    {
        image && (
            <div class="hero-graphic" style={`order: ${order("image")}`}>
                <img src={urlFor(image)} alt={title} style={aspectRatio ? `--media-aspect-ratio: ${aspectRatio}` : undefined} />
            </div>
        )
    }

    {title && <h1 class="hero-title" style={`order: ${order("title")}`}>{title}</h1>}
    {subtitle && <p class="hero-subtitle" style={`order: ${order("subtitle")}`}>{subtitle}</p>}
    {description && <p class="hero-subtitle" style={`order: ${order("description")}`}>{description}</p>}

    <div class="cta-group" style={`order: ${order("buttons")}`}>
        {
            cta_primary && (
                <a href={cta_primary_link || "#"} class="btn btn-primary">
                    {cta_primary}
                </a>
            )
        }
        {
            cta_secondary && (
                <a href={cta_secondary_link || "#"} class="btn-text-link">
                    {cta_secondary}
                </a>
            )
        }
    </div>
</section>

<style>
    .hero-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg) var(--space-md);
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-section--wide {
        max-width: 1440px;
    }

    .hero-section--full {
        max-width: none;
        padding-inline: 0;
    }

    .hero-graphic {
        margin-bottom: var(--space-md);
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .hero-graphic img {
        max-height: 70vh;
        max-width: 100%;
        width: 100%;
        aspect-ratio: var(--media-aspect-ratio, auto);
        object-fit: cover;
        margin-inline: auto;
    }

    .hero-section--contained .hero-graphic img {
        width: auto;
        max-width: 90vw;
    }

    .hero-title {
        font-size: clamp(3rem, 10vw, 8rem); /* Massive scaling for 4K */
        color: var(--color-primary);
        text-transform: uppercase;
        line-height: 0.9;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        max-width: 60ch;
        width: 90%; /* Ensure it doesn't touch edges on small screens */
        margin-inline: auto;
        margin-bottom: 0.5rem;
        color: var(--color-primary);
        font-size: clamp(1rem, 1.5vw, 1.5rem); /* Fluid subtitle */
        line-height: 1.5;
    }

    .cta-group {
        margin-top: var(--space-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .btn-text-link {
        color: var(--color-primary);
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: underline;
        font-size: clamp(0.8rem, 1vw, 1.2rem); /* Fluid link text */
    }
</style>
