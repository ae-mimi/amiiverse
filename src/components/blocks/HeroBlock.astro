---
import { urlFor } from "../../utils/sanity";

const {
    title,
    subtitle,
    description,
    image,
    cta_primary,
    cta_primary_link,
    cta_secondary,
    cta_secondary_link,
} = Astro.props;
---

<section class="hero-section container text-center">
    <!-- Main Graphic -->
    {
        image && (
            <div class="hero-graphic">
                <img src={urlFor(image)} alt={title} />
            </div>
        )
    }

    {title && <h1 class="hero-title">{title}</h1>}
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {description && <p class="hero-subtitle">{description}</p>}

    <div class="cta-group">
        {
            cta_primary && (
                <a href={cta_primary_link || "#"} class="btn btn-primary">
                    {cta_primary}
                </a>
            )
        }
        {
            cta_secondary && (
                <a href={cta_secondary_link || "#"} class="btn-text-link">
                    {cta_secondary}
                </a>
            )
        }
    </div>
</section>

<style>
    .hero-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg) var(--space-md);
    }

    .hero-graphic {
        margin-bottom: var(--space-md);
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .hero-graphic img {
        max-height: 60vh; /* Increased from 50vh */
        max-width: 90vw; /* Added fluid width constraint */
        width: auto;
        margin-inline: auto;
    }

    .hero-title {
        font-size: clamp(3rem, 10vw, 8rem); /* Massive scaling for 4K */
        color: var(--color-navy-500);
        text-transform: uppercase;
        line-height: 0.9;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        max-width: 60ch;
        width: 90%; /* Ensure it doesn't touch edges on small screens */
        margin-inline: auto;
        margin-bottom: 0.5rem;
        color: var(--color-navy-500);
        font-size: clamp(1rem, 1.5vw, 1.5rem); /* Fluid subtitle */
        line-height: 1.5;
    }

    .cta-group {
        margin-top: var(--space-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .btn-text-link {
        color: var(--color-navy-500);
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: underline;
        font-size: clamp(0.8rem, 1vw, 1.2rem); /* Fluid link text */
    }
</style>
