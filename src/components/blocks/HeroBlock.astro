---
import { urlFor } from "../../lib/sanity/image";
import {
    cropPresetToAspectRatio,
    imageEditStyleVars,
    mediaWidthClass,
    resolveImageSource,
} from "../../lib/utils/mediaLayout";

const {
    title,
    subtitle,
    description,
    image,
    mediaWidth = "contained",
    imageCropPreset = "natural",
    contentOrder = ["image", "title", "subtitle", "description", "buttons"],
    cta_primary,
    cta_primary_link,
    cta_secondary,
    cta_secondary_link,
} = Astro.props;

const aspectRatio = cropPresetToAspectRatio(imageCropPreset);
const imageDisplayStyle = Astro.props.imageDisplayStyle || "boxed";
const displayImage = resolveImageSource(
    image,
    Astro.props.backgroundRemovedImage,
    Astro.props.useBackgroundRemovedImage,
);
const imageStyles = [
    aspectRatio ? `--media-aspect-ratio: ${aspectRatio}` : "",
    displayImage ? `--media-background-image: url(${urlFor(displayImage)})` : "",
    imageEditStyleVars(Astro.props),
].filter(Boolean).join("; ");
const order = (key: string) => {
    const index = Array.isArray(contentOrder) ? contentOrder.indexOf(key) : -1;
    return index === -1 ? 99 : index + 1;
};
---

<section class={`${mediaWidthClass("hero-section", mediaWidth)} hero-section--display-${imageDisplayStyle}`}>
    <!-- Main Graphic -->
    {
        displayImage && (
            <div class="hero-graphic" style={`order: ${order("image")}`}>
                <img src={urlFor(displayImage)} alt={title} style={imageStyles || undefined} />
                <span class="hero-graphic__overlay" aria-hidden="true"></span>
                <span class="hero-graphic__vignette" aria-hidden="true"></span>
                {Astro.props.imageMarkupText && (
                    <span class="hero-graphic__markup">{Astro.props.imageMarkupText}</span>
                )}
            </div>
        )
    }

    {title && <h1 class="hero-title" style={`order: ${order("title")}`}>{title}</h1>}
    {subtitle && <p class="hero-subtitle" style={`order: ${order("subtitle")}`}>{subtitle}</p>}
    {description && <p class="hero-subtitle" style={`order: ${order("description")}`}>{description}</p>}

    <div class="cta-group" style={`order: ${order("buttons")}`}>
        {
            cta_primary && (
                <a href={cta_primary_link || "#"} class="btn btn-primary">
                    {cta_primary}
                </a>
            )
        }
        {
            cta_secondary && (
                <a href={cta_secondary_link || "#"} class="btn-text-link">
                    {cta_secondary}
                </a>
            )
        }
    </div>
</section>

<style>
    .hero-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg) var(--space-md);
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding-inline: 1.5rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-section--wide {
        max-width: 1440px;
    }

    .hero-section--full {
        max-width: none;
        padding-inline: 0;
    }

    .hero-section--display-fullScreen {
        min-height: 100dvh;
        justify-content: center;
    }

    .hero-section--display-fullWidthBleed,
    .hero-section--display-fixedBackground {
        max-width: none;
        padding-inline: 0;
    }

    .hero-section--display-fixedBackground .hero-graphic img {
        opacity: 0;
    }

    .hero-section--display-fixedBackground .hero-graphic {
        min-height: min(78vh, 860px);
        background-image: var(--media-background-image);
        background-size: cover;
        background-position: var(--image-object-position, center center);
        background-attachment: fixed;
    }

    .hero-graphic {
        margin-bottom: var(--space-md);
        width: 100%;
        display: flex;
        justify-content: center;
        position: relative;
        overflow: hidden;
        border-radius: var(--image-frame-radius, 0);
        border: var(--image-frame-border-width, 0) solid var(--image-frame-border-color, transparent);
        padding: var(--image-frame-padding, 0);
        background: var(--image-frame-background, transparent);
        box-shadow: var(--image-frame-shadow, none);
    }
    .hero-graphic img {
        max-height: 70vh;
        max-width: 100%;
        width: 100%;
        aspect-ratio: var(--media-aspect-ratio, auto);
        object-fit: cover;
        object-position: var(--image-object-position, center center);
        transform: var(--image-transform, none);
        filter: var(--image-filter, none);
        margin-inline: auto;
        border-radius: inherit;
        display: block;
    }
    .hero-graphic__overlay,
    .hero-graphic__vignette {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }
    .hero-graphic__overlay {
        background: var(--image-overlay-color, #000);
        opacity: var(--image-overlay-opacity, 0);
    }
    .hero-graphic__vignette {
        opacity: var(--image-vignette-opacity, 0);
        background: radial-gradient(circle, transparent 48%, rgba(0, 0, 0, 0.74) 100%);
    }
    .hero-graphic__markup {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        z-index: 2;
        border-radius: 999px;
        background: rgba(0, 0, 0, 0.62);
        color: #fff;
        padding: 0.45rem 0.75rem;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .hero-section--contained .hero-graphic img {
        width: auto;
        max-width: 90vw;
    }

    .hero-title {
        font-size: clamp(3rem, 10vw, 8rem); /* Massive scaling for 4K */
        color: var(--color-primary);
        text-transform: uppercase;
        line-height: 0.9;
        margin-bottom: 1rem;
    }

    .hero-subtitle {
        max-width: 60ch;
        width: 90%; /* Ensure it doesn't touch edges on small screens */
        margin-inline: auto;
        margin-bottom: 0.5rem;
        color: var(--color-primary);
        font-size: clamp(1rem, 1.5vw, 1.5rem); /* Fluid subtitle */
        line-height: 1.5;
    }

    .cta-group {
        margin-top: var(--space-md);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .btn-text-link {
        color: var(--color-primary);
        font-weight: 900;
        text-transform: uppercase;
        text-decoration: underline;
        font-size: clamp(0.8rem, 1vw, 1.2rem); /* Fluid link text */
    }
</style>
