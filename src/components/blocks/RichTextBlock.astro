---
import { marked } from "marked";
const { body } = Astro.props;
const html = marked.parse(body || "");
---

<section class="container rich-text-section">
    <div class="prose" set:html={html} />
</section>

<style>
    .rich-text-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-md);
        color: var(--color-primary);
    }
    /* Add basic prose styling if needed, or rely on global CSS */
    .prose :global(h1),
    .prose :global(h2),
    .prose :global(h3) {
        font-family: var(--font-heading);
        font-weight: 900;
        margin-bottom: 1rem;
    }
    .prose :global(p) {
        margin-bottom: 1rem;
        line-height: 1.5;
    }
</style>
