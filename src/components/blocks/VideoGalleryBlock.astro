---
/**
 * VideoGalleryBlock — Displays videos in a grid or carousel layout.
 */
import type { VideoGallerySection } from "../../lib/sanity/types";

interface Props extends VideoGallerySection {}

const {
    title,
    videos: passedVideos = [],
    epkProfile,
    layout = "grid",
    showCopyActions = true,
} = Astro.props;
const videos = passedVideos.length
    ? passedVideos
    : epkProfile?.featuredVideos || [];

function getYoutubeEmbedUrl(url: string | undefined): string {
    if (!url) return "";
    if (url.includes("/embed/")) return url;
    return url
        .replace("watch?v=", "embed/")
        .replace("youtu.be/", "youtube.com/embed/");
}

function getYoutubeWatchUrl(url: string | undefined): string {
    if (!url) return "#";
    const shortMatch = url.match(/youtu\.be\/([^?&]+)/);
    if (shortMatch?.[1]) return `https://www.youtube.com/watch?v=${shortMatch[1]}`;
    const embedMatch = url.match(/youtube\.com\/embed\/([^?&]+)/);
    if (embedMatch?.[1]) return `https://www.youtube.com/watch?v=${embedMatch[1]}`;
    return url;
}

function getEmbedCode(video: NonNullable<Props["videos"]>[number]): string {
    const embedUrl = video.embedUrl || getYoutubeEmbedUrl(video.youtubeUrl);
    return `<iframe width="560" height="315" src="${embedUrl}" title="${video.title}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
}
---

<section class="video-gallery" aria-label={title || "Videos"}>
    <div class="video-gallery__inner">
        {title && <h2 class="video-gallery__title">{title}</h2>}

        {
            videos.length === 0 ? (
                <p class="video-gallery__empty">No videos yet.</p>
            ) : (
                <div
                    class={`video-gallery__items video-gallery__items--${layout}`}
                >
                    {videos.map((v) => (
                        <div class="video-card">
                            <div class="video-card__embed">
                                <iframe
                                    src={v.embedUrl || getYoutubeEmbedUrl(v.youtubeUrl)}
                                    title={v.title}
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen
                                    loading="lazy"
                                />
                            </div>
                            <div class="video-card__info">
                                <h3 class="video-card__title">{v.title}</h3>
                                {v.videoType && (
                                    <span class="video-card__type">
                                        {v.videoType
                                            .replace(/([A-Z])/g, " $1")
                                            .trim()}
                                    </span>
                                )}
                                {v.description && (
                                    <p class="video-card__description">
                                        {v.description}
                                    </p>
                                )}
                                {showCopyActions && (
                                    <div class="video-card__actions">
                                        <a
                                            href={getYoutubeWatchUrl(v.youtubeUrl)}
                                            class="video-card__action"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Watch on YouTube
                                        </a>
                                        <button
                                            type="button"
                                            class="video-card__action"
                                            data-copy-value={getYoutubeWatchUrl(v.youtubeUrl)}
                                        >
                                            Copy Link
                                        </button>
                                        <button
                                            type="button"
                                            class="video-card__action"
                                            data-copy-value={getEmbedCode(v)}
                                        >
                                            Copy Embed
                                        </button>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            )
        }
    </div>
</section>

{
    showCopyActions && (
        <script>
            document.addEventListener("click", async (event) => {
                const target = event.target;
                if (!(target instanceof HTMLElement)) return;
                const button = target.closest("[data-copy-value]");
                if (!(button instanceof HTMLButtonElement)) return;
                const value = button.dataset.copyValue || "";
                if (!value) return;
                try {
                    await navigator.clipboard.writeText(value);
                    const original = button.textContent || "Copy";
                    button.textContent = "Copied";
                    window.setTimeout(() => {
                        button.textContent = original;
                    }, 1600);
                } catch {
                    button.textContent = "Copy failed";
                }
            });
        </script>
    )
}

<style>
    .video-gallery {
        padding: clamp(2rem, 5vw, 4rem) 0;
    }
    .video-gallery__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .video-gallery__title {
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 800;
        margin-bottom: 2rem;
        text-align: center;
    }
    .video-gallery__empty {
        text-align: center;
        opacity: 0.6;
        padding: 3rem 0;
    }
    .video-gallery__items--grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }
    .video-gallery__items--carousel {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 1rem;
    }
    .video-gallery__items--carousel .video-card {
        min-width: 320px;
        scroll-snap-align: start;
        flex-shrink: 0;
    }
    .video-card__embed {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        border-radius: 0.75rem;
        overflow: hidden;
    }
    .video-card__embed iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }
    .video-card__info {
        padding: 0.75rem 0;
    }
    .video-card__title {
        font-size: 1rem;
        font-weight: 600;
        margin: 0;
    }
    .video-card__type {
        font-size: 0.75rem;
        text-transform: capitalize;
        opacity: 0.5;
    }
    .video-card__description {
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        line-height: 1.5;
        opacity: 0.75;
    }
    .video-card__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.85rem;
    }
    .video-card__action {
        border: 1px solid color-mix(in srgb, var(--color-primary), transparent 72%);
        border-radius: 999px;
        background: transparent;
        color: var(--color-primary);
        padding: 0.45rem 0.75rem;
        text-decoration: none;
        font-size: 0.78rem;
        font-weight: 700;
    }
    .video-card__action:hover {
        background: var(--color-primary);
        color: var(--color-secondary);
    }
</style>
