---
import ContactForm from "../forms/ContactForm.astro";

const {
    title = "SAY HELLO",
    subtitle = "Have a question, idea, or opportunity? Send us a message.",
} = Astro.props;
---

<section class="contact-form-block">
    <div class="container">
        <ContactForm title={title} subtitle={subtitle} />
    </div>
</section>
<style>
    .contact-form-block {
        padding: 60px 20px;
        background-color: var(--bg-page);
        display: flex;
        justify-content: center;
    }
    .container {
        width: 100%;
        max-width: 800px;
        display: flex;
        justify-content: center;
    }
</style>
