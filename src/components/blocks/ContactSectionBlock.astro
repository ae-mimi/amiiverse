---
import ContactForm from "../forms/ContactForm.astro";
import { Icon } from "astro-icon/components";
import { fetchGlobalSettings } from "../../utils/global";
import InfoCard from "../ui/InfoCard.astro";

const {
    title,
    subtitle,
    management_email,
    press_email,
    bookings_email,
    inquiries_email,
    show_socials = true,
} = Astro.props;

const settings = await fetchGlobalSettings();
const socials = settings.socials || [];
---

<div class="content-wrapper">
    <div class="content-container">
        <div class="grid-layout">
            <!-- Left Column: Form -->
            <div class="form-column">
                <ContactForm title={title} subtitle={subtitle} />
            </div>

            <!-- Right Column: Info Cards -->
            <div class="info-column">
                <!-- Contact Us Card -->
                <InfoCard title="CONTACT US">
                    <p>
                        <strong>Management</strong><br /><a
                            href={`mailto:${management_email}`}
                            >{management_email}</a
                        >
                    </p>
                    <p>
                        <strong>PR/Press</strong><br /><a
                            href={`mailto:${press_email}`}>{press_email}</a
                        >
                    </p>
                </InfoCard>

                <!-- Bookings Card -->
                <InfoCard title="BOOKINGS">
                    <p>
                        <strong>Bookings</strong><br /><a
                            href={`mailto:${bookings_email}`}
                            >{bookings_email}</a
                        >
                    </p>
                    <p>
                        <strong>Inquiries</strong><br /><a
                            href={`mailto:${inquiries_email}`}
                            >{inquiries_email}</a
                        >
                    </p>
                </InfoCard>

                <!-- Links Card -->
                {
                    show_socials && (
                        <InfoCard title="LINKS" class="links-card">
                            <div class="links-grid">
                                <div class="links-text-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="social-link"
                                        >
                                            {social.platform}
                                        </a>
                                    ))}
                                </div>
                                <div class="links-icon-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="icon-link"
                                            aria-label={social.platform}
                                        >
                                            <Icon
                                                name={`simple-icons:${social.icon}`}
                                                class={`social-icon icon-${social.icon}`}
                                            />
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </InfoCard>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    .content-wrapper {
        width: 100%;
        height: auto; /* Ensure it fits content */
        padding: 24px 16px; /* User specified exact padding to match Newsletter */
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        background-color: var(--bg-page);
    }

    .content-container {
        width: 100%;
        height: auto; /* Ensure it fits content */
        max-width: 2560px; /* Match global cap */
        padding-inline: 0px;
        border-top: 2px solid var(--color-primary);
        display: flex;
        justify-content: center;
        background-color: var(--bg-card);
    }

    .grid-layout {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: stretch; /* Use stretch to equal height */
        height: auto; /* Ensure it fits content */
        padding-block: 67px;
        gap: clamp(40px, 5vw, 100px); /* Fluid layout gap */
        width: 100%;
        max-width: 2560px; /* Match global cap */
        flex-wrap: wrap;
    }

    .form-column {
        flex: 1 1 auto; /* Allow growth */
        width: 100%;
        height: auto; /* Ensure it fits content */
        max-width: clamp(
            600px,
            45vw,
            1400px
        ); /* Increased cap for 4K screens */
    }

    .info-column {
        display: flex;
        flex-direction: column;
        gap: clamp(25px, 2vw, 40px); /* Fluid column gap */
        width: clamp(222px, 20vw, 450px); /* Fluid info column */
        flex-shrink: 0;
    }

    .links-grid {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
        justify-content: center;
    }

    .links-text-col {
        display: flex;
        flex-direction: column;
        gap: 0px;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 17px;
        line-height: 26px;
        text-align: left;
    }

    .links-icon-col {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .icon-link {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        width: 26px;
        color: var(--color-primary);
    }

    .social-icon {
        width: auto;
        height: 17px;
        transition: transform 0.2s;
    }

    .icon-youtube {
        height: 19px; /* Slightly taller than 17px */
        transform: scale(1.1);
    }

    .icon-link:hover {
        opacity: 0.8;
    }

    @media (max-width: 900px) {
        .grid-layout {
            flex-direction: column;
            align-items: center;
            gap: 40px;
        }

        .info-column {
            width: 100%;
            max-width: 534px;
            flex-direction: column;
            align-items: stretch;
        }

        .info-card {
            width: 100%;
            height: auto;
        }
    }
</style>
