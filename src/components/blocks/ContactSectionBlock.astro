---
import { Icon } from "astro-icon/components";
import { fetchGlobalSettings } from "../../lib/siteSettings";
import InfoCard from "../ui/InfoCard.astro";

const {
    title,
    subtitle,
    management_email,
    press_email,
    bookings_email,
    inquiries_email,
    show_socials = true,
} = Astro.props;

const settings = await fetchGlobalSettings();
const socials = settings.socials || [];
---

<div class="content-wrapper">
    <div class="content-container">
        <div class="section-header">
            {title && <h2 class="section-title">{title}</h2>}
            {subtitle && <p class="section-subtitle">{subtitle}</p>}
        </div>

        <div class="grid-layout">
            <div class="info-column">
                <!-- Contact Us Card -->
                <InfoCard title="CONTACT US">
                    <p>
                        <strong>Management</strong><br /><a
                            href={`mailto:${management_email}`}
                            >{management_email}</a
                        >
                    </p>
                    <p>
                        <strong>PR/Press</strong><br /><a
                            href={`mailto:${press_email}`}>{press_email}</a
                        >
                    </p>
                </InfoCard>

                <!-- Bookings Card -->
                <InfoCard title="BOOKINGS">
                    <p>
                        <strong>Bookings</strong><br /><a
                            href={`mailto:${bookings_email}`}
                            >{bookings_email}</a
                        >
                    </p>
                    <p>
                        <strong>Inquiries</strong><br /><a
                            href={`mailto:${inquiries_email}`}
                            >{inquiries_email}</a
                        >
                    </p>
                </InfoCard>

                <!-- Links Card -->
                {
                    show_socials && (
                        <InfoCard title="LINKS" class="links-card">
                            <div class="links-grid">
                                <div class="links-text-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="social-link"
                                        >
                                            {social.platform}
                                        </a>
                                    ))}
                                </div>
                                <div class="links-icon-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="icon-link"
                                            aria-label={social.platform}
                                        >
                                            <Icon
                                                name={`simple-icons:${social.icon}`}
                                                class={`social-icon icon-${social.icon}`}
                                            />
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </InfoCard>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    .content-wrapper {
        width: 100%;
        height: auto; /* Ensure it fits content */
        padding: 24px 16px; /* User specified exact padding to match Newsletter */
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        background-color: var(--bg-page);
    }

    .content-container {
        width: 100%;
        height: auto; /* Ensure it fits content */
        max-width: 2560px; /* Match global cap */
        padding-inline: 0px;
        display: flex;
        justify-content: center;
        background-color: var(--bg-card);
    }

    .grid-layout {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: stretch;
        height: auto;
        padding-block: 40px 67px;
        gap: clamp(24px, 3vw, 40px);
        width: 100%;
        max-width: 1280px;
        flex-wrap: wrap;
    }

    .section-header {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        text-align: center;
        padding-top: 40px;
    }

    .section-title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(32px, 3vw, 48px);
        line-height: 1.1;
        color: var(--text-main);
    }

    .section-subtitle {
        margin: 12px auto 0;
        max-width: 720px;
        font-family: var(--font-body);
        font-size: clamp(14px, 1vw, 18px);
        line-height: 1.5;
        color: var(--color-accent);
    }

    .info-column {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: clamp(20px, 2vw, 32px);
        width: 100%;
    }

    .links-grid {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
        justify-content: center;
    }

    .links-text-col {
        display: flex;
        flex-direction: column;
        gap: 0px;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 17px;
        line-height: 26px;
        text-align: left;
    }

    .links-icon-col {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .icon-link {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        width: 26px;
        color: var(--color-primary);
    }

    .social-icon {
        width: auto;
        height: 17px;
        transition: transform 0.2s;
    }

    .icon-youtube {
        height: 19px; /* Slightly taller than 17px */
        transform: scale(1.1);
    }

    .icon-link:hover {
        opacity: 0.8;
    }

    @media (max-width: 900px) {
        .grid-layout {
            align-items: center;
            gap: 40px;
        }

        .info-column {
            width: 100%;
            max-width: 700px;
        }

        .info-card {
            width: 100%;
            height: auto;
        }
    }
</style>
