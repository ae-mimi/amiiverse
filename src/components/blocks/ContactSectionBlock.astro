---
import ContactForm from "../ContactForm.astro";
import { Icon } from "astro-icon/components";
import { getGlobalSettings } from "../../utils/global";

const {
    title,
    subtitle,
    management_email,
    press_email,
    bookings_email,
    inquiries_email,
    show_socials = true,
} = Astro.props;

const settings = getGlobalSettings();
const socials = settings.socials || [];
---

<div class="content-wrapper">
    <div class="content-container">
        <div class="grid-layout">
            <!-- Left Column: Form -->
            <div class="form-column">
                <ContactForm title={title} subtitle={subtitle} />
            </div>

            <!-- Right Column: Info Cards -->
            <div class="info-column">
                <!-- Contact Us Card -->
                <div class="info-card">
                    <h3 class="card-title">CONTACT US</h3>
                    <div class="card-content">
                        <p>
                            <strong>Management</strong><br /><a
                                href={`mailto:${management_email}`}
                                >{management_email}</a
                            >
                        </p>
                        <p>
                            <strong>PR/Press</strong><br /><a
                                href={`mailto:${press_email}`}>{press_email}</a
                            >
                        </p>
                    </div>
                </div>

                <!-- Bookings Card -->
                <div class="info-card">
                    <h3 class="card-title">BOOKINGS</h3>
                    <div class="card-content">
                        <p>
                            <strong>Bookings</strong><br /><a
                                href={`mailto:${bookings_email}`}
                                >{bookings_email}</a
                            >
                        </p>
                        <p>
                            <strong>Inquiries</strong><br /><a
                                href={`mailto:${inquiries_email}`}
                                >{inquiries_email}</a
                            >
                        </p>
                    </div>
                </div>

                <!-- Links Card -->
                {
                    show_socials && (
                        <div class="info-card links-card">
                            <h3 class="card-title">LINKS</h3>
                            <div class="links-grid">
                                <div class="links-text-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="social-link"
                                        >
                                            {social.platform}
                                        </a>
                                    ))}
                                </div>
                                <div class="links-icon-col">
                                    {socials.map((social) => (
                                        <a
                                            href={social.url}
                                            target="_blank"
                                            class="icon-link"
                                            aria-label={social.platform}
                                        >
                                            <Icon
                                                name={`simple-icons:${social.icon}`}
                                                class="social-icon"
                                            />
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</div>

<style>
    .content-wrapper {
        width: 100%;
        padding-inline: 27px;
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        background-color: var(--bg-page);
    }

    .content-container {
        width: 100%;
        max-width: 1280px;
        padding-inline: 0px;
        border-top: 2px solid var(--color-navy-500);
        display: flex;
        justify-content: center;
        background-color: var(--color-yellow-500);
    }

    .grid-layout {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        padding-block: 67px;
        gap: 84px;
        width: 100%;
        max-width: 1280px;
        flex-wrap: wrap;
    }

    .form-column {
        flex: 0 0 auto;
        width: 100%;
        max-width: 640px;
    }

    .info-column {
        display: flex;
        flex-direction: column;
        gap: 25px;
        width: 222px;
        flex-shrink: 0;
    }

    .info-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 17px 25px;
        gap: 17px;
        width: 100%;
        height: 181px;
        background-color: color-mix(
            in srgb,
            var(--color-yellow-500),
            black 10%
        ) !important;
        border-radius: 17px;
        box-sizing: border-box;
    }

    .info-card.links-card {
        height: auto;
        min-height: 182px;
    }

    .card-title {
        font-family: var(--font-heading);
        font-style: normal;
        font-weight: 400;
        font-size: 19px;
        line-height: 26px;
        color: var(--color-navy-500);
        margin: 0;
        text-align: center;
        width: 100%;
    }

    .card-content {
        font-family: var(--font-body);
        font-style: normal;
        font-weight: 700;
        font-size: 17px;
        line-height: 26px;
        text-align: center;
        color: var(--color-navy-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .card-content p {
        margin: 0;
    }

    .card-content a,
    .social-link {
        color: var(--color-navy-500);
        text-decoration: none;
    }

    .card-content a:hover,
    .social-link:hover {
        text-decoration: underline;
    }

    .links-grid {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
        justify-content: center;
    }

    .links-text-col {
        display: flex;
        flex-direction: column;
        gap: 0px;
        font-family: var(--font-body);
        font-weight: 700;
        font-size: 17px;
        line-height: 26px;
        text-align: left;
    }

    .links-icon-col {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .icon-link {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 26px;
        width: 26px;
        color: var(--color-navy-500);
    }

    .social-icon {
        width: 17px;
        height: 17px;
    }

    .icon-link:hover {
        opacity: 0.8;
    }

    @media (max-width: 900px) {
        .grid-layout {
            flex-direction: column;
            align-items: center;
            gap: 40px;
        }

        .info-column {
            width: 100%;
            max-width: 534px;
            flex-direction: column;
            align-items: stretch;
        }

        .info-card {
            width: 100%;
            height: auto;
            min-height: 181px;
        }
    }
</style>
