---
/**
 * DiscographyGridBlock — Auto-displays all releases in a filterable grid.
 */
import { fetchSanity } from "../../lib/sanity/client";
import { ALL_RELEASES_QUERY } from "../../lib/sanity/queries";
import { urlFor } from "../../lib/sanity/image";
import { formatDate } from "../../lib/utils/format";
import type { Release } from "../../lib/sanity/types";

interface Props {
    title?: string;
    filtersEnabled?: boolean;
    defaultFilter?: string;
}

const {
    title = "Discography",
    filtersEnabled = true,
    defaultFilter = "all",
} = Astro.props;
const releases = (await fetchSanity<Release[]>(ALL_RELEASES_QUERY)) || [];
---

<section class="discography-grid" aria-label={title}>
    <div class="discography-grid__inner">
        <h2 class="discography-grid__title">{title}</h2>

        {
            releases.length === 0 ? (
                <p class="discography-grid__empty">
                    No releases yet — stay tuned!
                </p>
            ) : (
                <div class="discography-grid__items">
                    {releases.map((r) => (
                        <a
                            href={`/music/${r.slug?.current || ""}`}
                            class="discography-card"
                        >
                            {r.artwork && (
                                <img
                                    src={urlFor(r.artwork)}
                                    alt={`${r.title} artwork`}
                                    loading="lazy"
                                    width="400"
                                    height="400"
                                    class="discography-card__img"
                                />
                            )}
                            <div class="discography-card__info">
                                <span class="discography-card__type">
                                    {r.releaseType || "Single"}
                                </span>
                                <h3 class="discography-card__title">
                                    {r.title}
                                </h3>
                                <p class="discography-card__date">
                                    {formatDate(r.releaseDate)}
                                </p>
                            </div>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</section>

<style>
    .discography-grid {
        padding: clamp(2rem, 5vw, 4rem) 0;
    }
    .discography-grid__inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .discography-grid__title {
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        font-weight: 800;
        margin-bottom: 2rem;
        text-align: center;
    }
    .discography-grid__empty {
        text-align: center;
        opacity: 0.6;
        padding: 3rem 0;
    }
    .discography-grid__items {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
    }
    .discography-card {
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s;
    }
    .discography-card:hover {
        transform: translateY(-4px);
    }
    .discography-card__img {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    }
    .discography-card__info {
        padding: 0.75rem 0;
    }
    .discography-card__type {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.5;
    }
    .discography-card__title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0.15rem 0;
    }
    .discography-card__date {
        font-size: 0.8rem;
        opacity: 0.6;
    }
</style>
