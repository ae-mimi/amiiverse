---
import NewsletterForm from "../NewsletterForm.astro";
import PlayerWidget from "../PlayerWidget.astro";

const { widget_type } = Astro.props;
---

<section class="widget-section container">
    {widget_type === "newsletter" && <NewsletterForm />}
    {widget_type === "player" && <PlayerWidget />}
</section>

<style>
    .widget-section {
        padding-block: var(--space-md);
    }
</style>
