---
import { urlFor } from "../../lib/sanity/image";
import {
    cropPresetToAspectRatio,
    imageEditStyleVars,
    resolveImageSource,
} from "../../lib/utils/mediaLayout";

const {
    heading,
    content,
    image,
    epkProfile,
    bioVariant = "short",
    imageCropPreset = "natural",
} = Astro.props;

const profileBio =
    bioVariant === "long" ? epkProfile?.longBio : epkProfile?.shortBio;
const body = content || profileBio;
const aspectRatio = cropPresetToAspectRatio(imageCropPreset);
const displayImage = resolveImageSource(
    image,
    Astro.props.backgroundRemovedImage,
    Astro.props.useBackgroundRemovedImage,
);
const imageStyles = [
    aspectRatio ? `--media-aspect-ratio: ${aspectRatio}` : "",
    imageEditStyleVars(Astro.props),
].filter(Boolean).join("; ");
---

<section class="intro-section container text-center">
    {
        displayImage && (
            <div class="oval-graphic">
                <img src={urlFor(displayImage)} alt={heading} style={imageStyles || undefined} />
            </div>
        )
    }

    {
        heading && (
            <h2
                class="section-heading"
                set:html={heading.replace(/\*/g, '<span class="star">★</span>')}
            />
        )
    }

    {body && <p>{body}</p>}
</section>

<style>
    .intro-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-xl);
    }

    .section-heading {
        font-size: clamp(2.5rem, 5vw, 6rem); /* Fluid heading */
        color: var(--color-primary);
        margin-block: 1rem;
        line-height: 1.1;
    }

    .section-heading p {
        font-size: clamp(1rem, 1.5vw, 1.8rem); /* Fluid paragraph text */
        max-width: 70ch;
        margin-inline: auto;
    }

    .oval-graphic {
        width: 100%;
        max-width: clamp(300px, 30vw, 600px); /* Fluid graphic size */
        margin-inline: auto;
        border-radius: var(--image-frame-radius, 50%);
        overflow: hidden;
        border: var(--image-frame-border-width, 4px) solid var(--image-frame-border-color, var(--color-primary));
        padding: var(--image-frame-padding, 0);
        background: var(--image-frame-background, transparent);
        box-shadow: var(--image-frame-shadow, none);
    }

    .oval-graphic img {
        width: 100%;
        aspect-ratio: var(--media-aspect-ratio, 1 / 1);
        object-fit: cover;
        object-position: var(--image-object-position, center center);
        transform: var(--image-transform, none);
        filter: var(--image-filter, none);
        border-radius: inherit;
        display: block;
    }
</style>
