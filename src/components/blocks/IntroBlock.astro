---
const { heading, content, image } = Astro.props;
---

<section class="intro-section container text-center">
    {
        image && (
            <div class="oval-graphic">
                <img src={image} alt={heading} />
            </div>
        )
    }

    {
        heading && (
            <h2
                class="section-heading"
                set:html={heading.replace(/\*/g, '<span class="star">★</span>')}
            />
        )
    }

    {content && <p>{content}</p>}
</section>

<style>
    .intro-section {
        padding-block: var(--space-xl);
    }

    .section-heading {
        font-family: var(--font-heading);
        font-size: 2.5rem;
        font-weight: 900;
        color: var(--color-navy-500);
        margin-block: 1rem;
    }

    .oval-graphic {
        width: 100%;
        max-width: 400px;
        margin-inline: auto;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--color-navy-500);
    }
</style>
