---
import { urlFor } from "../../lib/sanity/image";
const { heading, content, image } = Astro.props;
---

<section class="intro-section container text-center">
    {
        image && (
            <div class="oval-graphic">
                <img src={urlFor(image)} alt={heading} />
            </div>
        )
    }

    {
        heading && (
            <h2
                class="section-heading"
                set:html={heading.replace(/\*/g, '<span class="star">★</span>')}
            />
        )
    }

    {content && <p>{content}</p>}
</section>

<style>
    .intro-section {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-xl);
    }

    .section-heading {
        font-size: clamp(2.5rem, 5vw, 6rem); /* Fluid heading */
        color: var(--color-primary);
        margin-block: 1rem;
        line-height: 1.1;
    }

    .section-heading p {
        font-size: clamp(1rem, 1.5vw, 1.8rem); /* Fluid paragraph text */
        max-width: 70ch;
        margin-inline: auto;
    }

    .oval-graphic {
        width: 100%;
        max-width: clamp(300px, 30vw, 600px); /* Fluid graphic size */
        margin-inline: auto;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid var(--color-primary);
    }
</style>
