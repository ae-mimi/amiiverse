---
import { urlFor } from "../../lib/sanity/image";
import { mediaWidthClass } from "../../lib/utils/mediaLayout";

const {
    heading,
    description,
    button_text,
    button_link,
    bg_image,
    mediaWidth = "full",
} = Astro.props;
const bgUrl = bg_image ? urlFor(bg_image) : null;
---

<section
    class={mediaWidthClass("cta-banner-block", mediaWidth)}
    style={bgUrl ? `background-image: url(${bgUrl});` : undefined}
>
    <div class="cta-overlay"></div>
    <div class="container cta-content">
        <h2 class="cta-heading">{heading}</h2>
        {description && <p class="cta-description">{description}</p>}
        {
            button_text && button_link && (
                <a href={button_link} class="cta-button">
                    {button_text}
                </a>
            )
        }
    </div>
</section>

<style>
    .cta-banner-block {
        position: relative;
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
        padding-block: var(--space-xl, 4rem);
        text-align: center;
        background-size: cover;
        background-position: center center;
        background-color: var(--color-text);
        background-attachment: scroll;
        border-radius: 0;
        overflow: hidden;
    }

    .cta-banner-block--wide {
        max-width: 1440px;
    }

    .cta-banner-block--full {
        max-width: none;
    }

    .cta-overlay {
        position: absolute;
        inset: 0;
        background: #000;
        opacity: 0.5;
        pointer-events: none;
    }

    .cta-banner-block:not([style*="background-image"]) .cta-overlay {
        background: none;
    }

    .cta-content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-sm);
    }

    .cta-heading {
        font-family: var(--font-heading, sans-serif);
        font-size: clamp(1.75rem, 4vw, 3rem);
        margin: 0;
        color: var(--color-bg);
    }

    .cta-description {
        font-size: clamp(1rem, 1.5vw, 1.25rem);
        max-width: 600px;
        margin: 0;
        opacity: 0.85;
        color: var(--color-bg);
    }

    .cta-button {
        display: inline-block;
        margin-top: var(--space-sm);
        padding: 14px 36px;
        border-radius: var(--btn-radius, 999px);
        background: var(--color-bg);
        color: var(--color-text);
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }
</style>
