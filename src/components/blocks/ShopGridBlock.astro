---
import ShopGridControls from "../shop/catalog/ShopGridControls.astro";
import ShopProductGrid from "../shop/catalog/ShopProductGrid.astro";

interface ShopProduct {
    id: string;
    product_id?: string;
    variant_id?: string;
    slug: string;
    title: string;
    price_ngn: number;
    product_type: "physical" | "digital";
    cover_image_url: string;
}

let initialItems: ShopProduct[] = [];

try {
    const apiUrl = new URL("/api/shop/products", Astro.url);
    apiUrl.searchParams.set("sort", "newest");

    const response = await fetch(apiUrl.toString());
    if (response.ok) {
        const data = (await response.json()) as { products?: ShopProduct[] };
        initialItems = Array.isArray(data.products) ? data.products : [];
    }
} catch (error) {
    console.error("[ShopGridBlock] Failed to load initial products", error);
}
---

<section class="shopSection" data-shop-grid-root>
    <h1 class="shopHeading">Shop</h1>
    <ShopGridControls />
    <ShopProductGrid items={initialItems} />
</section>

<script>
    import { initShopGrid } from "../../lib/client/shopGrid";

    initShopGrid();
    document.addEventListener("astro:page-load", initShopGrid);
</script>
