---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import ShopCard from "../ui/ShopCard.astro";

const { title, limit } = Astro.props;

// Fetch shop items from Sanity
const shopItems = await getSanityContent(`*[_type == "shop"]`);
const items = shopItems || [];

// Sort or filter if needed (Sanity order() in query is better, but simple array slice works for limit)
const displayedItems = limit ? items.slice(0, limit) : items;
---

<section class="shop-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="grid">
            {
                displayedItems.map((item: any) => (
                    <ShopCard
                        url={item.url}
                        title={item.title}
                        price={item.price}
                        image={urlFor(item.image)}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .shop-grid-block {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
        gap: clamp(30px, 3vw, 60px); /* Fluid gap */
        justify-items: center;
    }
</style>
