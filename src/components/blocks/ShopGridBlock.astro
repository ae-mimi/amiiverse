---
import { getSanityContent, urlFor } from "../../utils/sanity";
import ShopCard from "../ui/ShopCard.astro";

const { title, limit } = Astro.props;

// Fetch shop items from Sanity
const shopItems = await getSanityContent(`*[_type == "shop"]`);
const items = shopItems || [];

// Sort or filter if needed (Sanity order() in query is better, but simple array slice works for limit)
const displayedItems = limit ? items.slice(0, limit) : items;
---

<section class="shop-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="grid">
            {
                displayedItems.map((item: any) => (
                    <ShopCard
                        url={item.url}
                        title={item.title}
                        price={item.price}
                        image={urlFor(item.image)}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .shop-grid-block {
        padding: 60px 20px;
        background-color: var(--bg-page);
    }
    .container {
        max-width: 1440px;
        margin: 0 auto;
    }
    .section-title {
        font-family: var(--font-heading);
        font-size: 40px;
        color: var(--text-main);
        text-align: center;
        margin-bottom: 40px;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
        gap: 30px;
    }
</style>
