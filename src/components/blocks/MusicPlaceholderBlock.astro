<section class="music-placeholder">
    <div class="placeholder-content">
        <h1 class="music-title">MUSIC</h1>
        <p class="coming-soon">Music coming soon...</p>
    </div>
</section>

<style>
    .music-placeholder {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: var(--space-lg) var(--space-md);
        width: 100%;
        max-width: 2560px; /* Match global cap */
        margin: 0 auto;
        /* Height from Figma is 213px, but we might want it to be flexible or min-height */
        height: auto; /* Ensure it fits content */
    }

    .placeholder-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 34px;
        width: 100%;
    }

    .music-title {
        font-family: "Starbim", sans-serif;
        font-style: normal;
        font-weight: 400;
        font-size: clamp(48px, 6vw, 140px); /* Fluid Title */
        line-height: 1.1;
        display: flex;
        align-items: center;
        text-align: center;
        color: #15499d;
        margin: 0;
    }

    .coming-soon {
        font-family: "Archivo", sans-serif;
        font-style: normal;
        font-weight: 400;
        font-size: clamp(16px, 1.5vw, 32px); /* Fluid Subtitle */
        line-height: 1.5;
        display: flex;
        align-items: center;
        text-align: center;
        color: #666666;
        margin: 0;
    }

    /* Responsiveness */
    @media (max-width: 768px) {
        .music-title {
            /* clamp handles this mostly, but good to be safe */
        }
    }
</style>
