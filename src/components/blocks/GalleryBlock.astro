---
import { urlFor } from "../../lib/sanity/image";

const { title, images, columns = 3 } = Astro.props;
---

<section class="gallery-block">
    <div class="container">
        {title && <h2 class="gallery-title">{title}</h2>}
        <div class="gallery-grid" style={`--cols: ${columns}`}>
            {
                images?.map((img: any) => (
                    <figure class="gallery-item">
                        <img
                            src={urlFor(img)}
                            alt={img.alt || ""}
                            loading="lazy"
                            decoding="async"
                        />
                        {img.caption && <figcaption>{img.caption}</figcaption>}
                    </figure>
                ))
            }
        </div>
    </div>
</section>

<style>
    .gallery-block {
        padding-block: var(--space-lg);
    }

    .gallery-title {
        font-family: var(--font-heading, "Starbim", sans-serif);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        text-align: center;
        margin-bottom: var(--space-md);
        color: var(--text-main);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(var(--cols, 3), 1fr);
        gap: var(--space-sm);
    }

    .gallery-item {
        margin: 0;
        overflow: hidden;
        border-radius: 8px;
    }

    .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        aspect-ratio: 1;
        transition: transform 0.3s ease;
        display: block;
    }

    .gallery-item:hover img {
        transform: scale(1.05);
    }

    .gallery-item figcaption {
        padding: var(--space-xs) var(--space-sm);
        font-size: 0.85rem;
        opacity: 0.7;
        color: var(--text-main);
    }

    @media (max-width: 768px) {
        .gallery-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .gallery-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
