---
import { urlFor } from "../../lib/sanity/image";
import { cropPresetToAspectRatio, imageEditStyleVars } from "../../lib/utils/mediaLayout";

const {
    title,
    images,
    columns = 3,
    mediaWidth = "contained",
    imageCropPreset = "square",
    teaserLimit,
    showGalleryLink = false,
    galleryLinkText = "View the gallery",
} = Astro.props;
const allImages = images || [];
const visibleImages = typeof teaserLimit === "number" && teaserLimit > 0
    ? allImages.slice(0, teaserLimit)
    : allImages;
const hasMore = allImages.length > visibleImages.length;
const aspectRatio = cropPresetToAspectRatio(imageCropPreset) || "1 / 1";
const imageStyles = imageEditStyleVars(Astro.props);
---

<section class={`gallery-block gallery-block--${mediaWidth}`}>
    <div class="container gallery-block__inner">
        {title && <h2 class="gallery-title">{title}</h2>}
        <div
            class="gallery-grid"
            style={`--cols: ${columns}; --gallery-aspect-ratio: ${aspectRatio}; ${imageStyles}`}
        >
            {
                visibleImages?.map((img: any) => (
                    <figure class="gallery-item">
                        <img
                            src={urlFor(img)}
                            alt={img.alt || ""}
                            loading="lazy"
                            decoding="async"
                        />
                        {img.caption && <figcaption>{img.caption}</figcaption>}
                    </figure>
                ))
            }
            {showGalleryLink && hasMore && (
                <a href="/gallery" class="gallery-more">
                    <span>{galleryLinkText}</span>
                </a>
            )}
        </div>
    </div>
</section>

<style>
    .gallery-block {
        padding-block: var(--space-lg);
    }

    .gallery-block__inner {
        max-width: 1200px;
    }

    .gallery-block--wide .gallery-block__inner {
        max-width: 1440px;
    }

    .gallery-block--full .gallery-block__inner {
        max-width: none;
        padding-inline: 0;
    }

    .gallery-title {
        font-family: var(--font-heading, sans-serif);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        text-align: center;
        margin-bottom: var(--space-md);
        color: var(--text-main);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-sm);
    }

    .gallery-item {
        margin: 0;
        overflow: hidden;
        border-radius: 8px;
        border-radius: var(--image-frame-radius, 8px);
        border: var(--image-frame-border-width, 0) solid var(--image-frame-border-color, transparent);
        padding: var(--image-frame-padding, 0);
        background: var(--image-frame-background, transparent);
        box-shadow: var(--image-frame-shadow, none);
    }

    .gallery-item img {
        width: 100%;
        height: auto;
        object-fit: cover;
        object-position: var(--image-object-position, center center);
        aspect-ratio: var(--gallery-aspect-ratio, 1 / 1);
        transform: var(--image-transform, none);
        filter: var(--image-filter, none);
        border-radius: inherit;
        transition: transform 0.3s ease;
        display: block;
    }

    .gallery-item:hover img {
        transform: var(--image-transform, none) scale(1.05);
    }

    .gallery-item figcaption {
        padding: var(--space-xs) var(--space-sm);
        font-size: 0.85rem;
        opacity: 0.7;
        color: var(--text-main);
    }

    .gallery-more {
        min-height: 12rem;
        border: 2px solid var(--color-primary);
        border-radius: var(--image-frame-radius, 8px);
        color: var(--color-primary);
        display: grid;
        place-items: center;
        padding: 1.5rem;
        text-align: center;
        text-decoration: none;
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 3vw, 2rem);
        background: color-mix(in srgb, var(--color-primary), transparent 94%);
    }

    .gallery-more:hover {
        background: var(--color-primary);
        color: var(--color-secondary);
    }

    @media (min-width: 640px) {
        .gallery-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 980px) {
        .gallery-grid {
            grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
        }
    }
</style>
