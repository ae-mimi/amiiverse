---
import { urlFor } from "../../lib/sanity/image";
import { cropPresetToAspectRatio } from "../../lib/utils/mediaLayout";

const {
    title,
    images,
    columns = 3,
    mediaWidth = "contained",
    imageCropPreset = "square",
} = Astro.props;
const aspectRatio = cropPresetToAspectRatio(imageCropPreset) || "1 / 1";
---

<section class={`gallery-block gallery-block--${mediaWidth}`}>
    <div class="container gallery-block__inner">
        {title && <h2 class="gallery-title">{title}</h2>}
        <div
            class="gallery-grid"
            style={`--cols: ${columns}; --gallery-aspect-ratio: ${aspectRatio}`}
        >
            {
                images?.map((img: any) => (
                    <figure class="gallery-item">
                        <img
                            src={urlFor(img)}
                            alt={img.alt || ""}
                            loading="lazy"
                            decoding="async"
                        />
                        {img.caption && <figcaption>{img.caption}</figcaption>}
                    </figure>
                ))
            }
        </div>
    </div>
</section>

<style>
    .gallery-block {
        padding-block: var(--space-lg);
    }

    .gallery-block__inner {
        max-width: 1200px;
    }

    .gallery-block--wide .gallery-block__inner {
        max-width: 1440px;
    }

    .gallery-block--full .gallery-block__inner {
        max-width: none;
        padding-inline: 0;
    }

    .gallery-title {
        font-family: var(--font-heading, sans-serif);
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        text-align: center;
        margin-bottom: var(--space-md);
        color: var(--text-main);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-sm);
    }

    .gallery-item {
        margin: 0;
        overflow: hidden;
        border-radius: 8px;
    }

    .gallery-item img {
        width: 100%;
        height: auto;
        object-fit: cover;
        aspect-ratio: var(--gallery-aspect-ratio, 1 / 1);
        transition: transform 0.3s ease;
        display: block;
    }

    .gallery-item:hover img {
        transform: scale(1.05);
    }

    .gallery-item figcaption {
        padding: var(--space-xs) var(--space-sm);
        font-size: 0.85rem;
        opacity: 0.7;
        color: var(--text-main);
    }

    @media (min-width: 640px) {
        .gallery-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 980px) {
        .gallery-grid {
            grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
        }
    }
</style>
