---
/**
 * NewsletterSignupBlock — CMS-driven mailing-list form (name + email).
 * Posts to /api/subscribe. All labels and copy are editable from Sanity.
 */
interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
    successRedirect?: string;
}

const {
    title = "JOIN THE AMII-GOS",
    subtitle = "Get early access, updates, and behind-the-scenes",
    buttonText = "JOIN US",
    successRedirect = "/newsletter-success",
} = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<section id="join-the-queue" class="newsletter-signup" aria-label={title}>
    <div class="newsletter-signup__card">
        <div class="newsletter-signup__header">
            <h2 class="newsletter-signup__title">{title}</h2>
            {subtitle && <p class="newsletter-signup__subtitle">{subtitle}</p>}
        </div>

        <form
            class="newsletter-signup__form"
            data-success-redirect={successRedirect}
        >
            <div class="newsletter-signup__field">
                <label for="newsletter-name">NAME</label>
                <input
                    type="text"
                    id="newsletter-name"
                    name="name"
                    class="input-shape-rounded"
                    autocomplete="name"
                />
            </div>

            <div class="newsletter-signup__field">
                <label for="newsletter-email">EMAIL</label>
                <input
                    type="email"
                    id="newsletter-email"
                    name="email"
                    class="input-shape-rounded"
                    required
                    autocomplete="email"
                />
            </div>

            <label class="newsletter-signup__consent">
                <input type="checkbox" name="consent" required />
                <span>I agree to receive email updates and can unsubscribe anytime.</span>
            </label>

            {
                turnstileSiteKey && (
                    <div
                        class="cf-turnstile"
                        data-sitekey={turnstileSiteKey}
                        data-theme="light"
                    ></div>
                )
            }

            <p class="newsletter-signup__meta">
                By subscribing, you consent to fan-list emails and privacy-safe analytics.
            </p>

            <p class="newsletter-signup__status" aria-live="polite" hidden></p>

            <button type="submit" class="newsletter-signup__btn"
                >{buttonText}</button
            >
        </form>
    </div>
</section>

{
    turnstileSiteKey && (
        <script
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
        ></script>
    )
}

<script>
    const forms = document.querySelectorAll(".newsletter-signup__form");

    forms.forEach((form) => {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formEl = e.target as HTMLFormElement;
            const emailInput = formEl.querySelector(
                'input[name="email"]',
            ) as HTMLInputElement;
            const consentInput = formEl.querySelector(
                'input[name="consent"]',
            ) as HTMLInputElement;
            const statusEl = formEl.querySelector(
                ".newsletter-signup__status",
            ) as HTMLParagraphElement;
            const turnstileInput = formEl.querySelector(
                'input[name="cf-turnstile-response"]',
            ) as HTMLInputElement | null;
            const button = formEl.querySelector("button") as HTMLButtonElement;
            const originalText = button.innerText;
            const redirect =
                formEl.dataset.successRedirect || "/newsletter-success";

            if (!emailInput || !consentInput || !button || !statusEl) return;

            if (!consentInput.checked) {
                statusEl.hidden = false;
                statusEl.dataset.state = "error";
                statusEl.textContent =
                    "Please consent to email updates before subscribing.";
                return;
            }

            if (
                formEl.querySelector(".cf-turnstile") &&
                !turnstileInput?.value
            ) {
                statusEl.hidden = false;
                statusEl.dataset.state = "error";
                statusEl.textContent = "Please complete the captcha.";
                return;
            }

            button.disabled = true;
            button.innerText = "...";
            statusEl.textContent = "";
            statusEl.hidden = true;
            statusEl.dataset.state = "";

            const formData = new FormData();
            formData.append("email", emailInput.value);
            formData.append("consent", String(consentInput.checked));
            if (turnstileInput?.value) {
                formData.append("turnstileToken", turnstileInput.value);
            }

            const nameInput = formEl.querySelector(
                'input[name="name"]',
            ) as HTMLInputElement;
            if (nameInput?.value) formData.append("name", nameInput.value);

            // Track source if user came from an anchor link
            const params = new URLSearchParams(window.location.search);
            const source =
                params.get("source") ||
                (window.location.hash === "#join-the-queue" ? "queue" : "");
            if (source) formData.append("source", source);

            try {
                const response = await fetch("/api/subscribe", {
                    method: "POST",
                    body: formData,
                });

                const result = await response.json();

                if (response.ok) {
                    if (result.status === "queued") {
                        statusEl.hidden = false;
                        statusEl.dataset.state = "warning";
                        statusEl.textContent =
                            result.message ||
                            "Saved locally, but email sync is still pending.";
                        button.disabled = false;
                        button.innerText = originalText;
                        return;
                    }
                    statusEl.hidden = false;
                    statusEl.dataset.state = "success";
                    statusEl.textContent =
                        result.status === "duplicate"
                            ? "This email is already on the list."
                            : "Subscription received. Check your inbox to confirm.";
                    button.disabled = false;
                    button.innerText = originalText;

                    window.setTimeout(() => {
                        window.location.href = redirect;
                    }, 1200);
                } else {
                    statusEl.hidden = false;
                    statusEl.dataset.state = "error";
                    statusEl.textContent =
                        result.message || "Subscription failed.";
                    button.disabled = false;
                    button.innerText = originalText;
                }
            } catch (error) {
                console.error("Error:", error);
                statusEl.hidden = false;
                statusEl.dataset.state = "error";
                statusEl.textContent = "Network error. Please try again.";
                button.disabled = false;
                button.innerText = originalText;
            }
        });
    });
</script>

<style>
    .newsletter-signup {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: clamp(48px, 5vw, 80px) 0;
    }

    .newsletter-signup__card {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: clamp(48px, 5vw, 80px);
        gap: clamp(16px, 2vw, 32px);
        width: 100%;
        max-width: clamp(640px, 40vw, 1000px);
        background: var(--bg-card);
        border: 1px solid var(--text-main);
        box-shadow: var(--shadow-sm);
        border-radius: var(--radius-card);
    }

    .newsletter-signup__header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 4px;
    }

    .newsletter-signup__title {
        margin: 0;
        font-family: var(--font-heading, sans-serif);
        font-weight: var(--weight-black);
        font-size: clamp(36px, 3vw, 72px);
        line-height: 1.1;
        color: var(--text-main);
    }

    .newsletter-signup__subtitle {
        margin: 0;
        font-family: var(--font-body, sans-serif);
        font-weight: var(--weight-regular);
        font-size: clamp(12px, 1vw, 20px);
        line-height: 1.5;
        color: var(--text-accent);
    }

    .newsletter-signup__form {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(16px, 1.5vw, 24px);
        width: 100%;
        max-width: 80%;
    }

    .newsletter-signup__field {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .newsletter-signup__field label {
        font-family: var(--font-body);
        font-size: clamp(13px, 1vw, 16px);
        color: var(--input-text);
        font-weight: var(--weight-regular);
        line-height: 1.4;
        text-align: left;
    }

    .newsletter-signup__field input {
        width: 100%;
        height: clamp(46px, 4vw, 64px);
        font-family: var(--font-body);
        font-size: clamp(16px, 1.2vw, 20px);
        box-sizing: border-box;
        --field-padding-block: 10px;
        --field-padding-inline: 10px;
    }

    .newsletter-signup__btn {
        display: flex;
        justify-content: center;
        align-items: center;
        width: clamp(130px, 10vw, 200px);
        height: clamp(55px, 4vw, 70px);
        background: var(--btn-bg-primary);
        border-radius: var(--radius-pill);
        border: none;
        cursor: pointer;
        margin-top: 10px;
        padding: 17px 29px;
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: 15px;
        letter-spacing: 2px;
        color: var(--btn-text-primary);
        text-transform: uppercase;
        white-space: nowrap;
        transition: transform 0.1s;
    }

    .newsletter-signup__btn:hover {
        transform: scale(1.02);
    }
    .newsletter-signup__btn:active {
        transform: scale(0.98);
    }

    .newsletter-signup__consent {
        width: 100%;
        display: grid;
        grid-template-columns: 20px 1fr;
        gap: 8px;
        align-items: start;
        font-family: var(--font-body);
        font-size: clamp(13px, 1vw, 16px);
        color: var(--text-main);
    }

    .newsletter-signup__consent input {
        width: 16px;
        height: 16px;
        margin-top: 2px;
    }

    .newsletter-signup__meta {
        margin: 0;
        width: 100%;
        font-family: var(--font-body);
        font-size: clamp(11px, 0.95vw, 14px);
        line-height: 1.45;
        color: var(--text-accent);
    }

    .newsletter-signup__status {
        margin: 0;
        width: 100%;
        font-family: var(--font-body);
        font-size: clamp(13px, 1vw, 16px);
        line-height: 1.45;
        padding: 12px 14px;
        border: 1px solid var(--text-main);
        border-radius: 16px;
        background: color-mix(in srgb, var(--bg-card) 86%, white 14%);
        color: var(--text-main);
    }

    .newsletter-signup__status[data-state="success"] {
        border-color: color-mix(in srgb, var(--color-accent) 45%, var(--text-main) 55%);
        color: var(--text-main);
    }

    .newsletter-signup__status[data-state="warning"] {
        border-color: color-mix(in srgb, #d49000 55%, var(--text-main) 45%);
        color: var(--text-main);
    }

    .newsletter-signup__status[data-state="error"] {
        border-color: color-mix(in srgb, #b63b3b 65%, var(--text-main) 35%);
        color: var(--text-main);
    }

    @media (max-width: 768px) {
        .newsletter-signup__card {
            width: 90%;
            padding: 24px;
        }
    }
</style>
