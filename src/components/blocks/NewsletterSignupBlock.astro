---
/**
 * NewsletterSignupBlock — CMS-driven mailing-list form (name + email).
 * Posts to /api/subscribe. All labels and copy are editable from Sanity.
 */
interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
    successRedirect?: string;
}

const {
    title = "JOIN THE AMII-GOS",
    subtitle = "Get early access, updates, and behind-the-scenes",
    buttonText = "JOIN US",
    successRedirect = "/newsletter-success",
} = Astro.props;
---

<section id="join-the-queue" class="newsletter-signup" aria-label={title}>
    <div class="newsletter-signup__card">
        <div class="newsletter-signup__header">
            <h2 class="newsletter-signup__title">{title}</h2>
            {subtitle && <p class="newsletter-signup__subtitle">{subtitle}</p>}
        </div>

        <form
            class="newsletter-signup__form"
            data-success-redirect={successRedirect}
        >
            <div class="newsletter-signup__field">
                <label for="newsletter-name">NAME</label>
                <input
                    type="text"
                    id="newsletter-name"
                    name="name"
                    autocomplete="name"
                />
            </div>

            <div class="newsletter-signup__field">
                <label for="newsletter-email">EMAIL</label>
                <input
                    type="email"
                    id="newsletter-email"
                    name="email"
                    required
                    autocomplete="email"
                />
            </div>

            <button type="submit" class="newsletter-signup__btn"
                >{buttonText}</button
            >
        </form>
    </div>
</section>

<script>
    const forms = document.querySelectorAll(".newsletter-signup__form");

    forms.forEach((form) => {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formEl = e.target as HTMLFormElement;
            const emailInput = formEl.querySelector(
                'input[name="email"]',
            ) as HTMLInputElement;
            const button = formEl.querySelector("button") as HTMLButtonElement;
            const originalText = button.innerText;
            const redirect =
                formEl.dataset.successRedirect || "/newsletter-success";

            if (!emailInput || !button) return;

            button.disabled = true;
            button.innerText = "...";

            const formData = new FormData();
            formData.append("email", emailInput.value);

            const nameInput = formEl.querySelector(
                'input[name="name"]',
            ) as HTMLInputElement;
            if (nameInput?.value) formData.append("name", nameInput.value);

            // Track source if user came from an anchor link
            const params = new URLSearchParams(window.location.search);
            const source =
                params.get("source") ||
                (window.location.hash === "#join-the-queue" ? "queue" : "");
            if (source) formData.append("source", source);

            try {
                const response = await fetch("/api/subscribe", {
                    method: "POST",
                    body: formData,
                });

                const result = await response.json();

                if (response.ok) {
                    window.location.href = redirect;
                } else {
                    alert(result.message || "Subscription failed.");
                    button.disabled = false;
                    button.innerText = originalText;
                }
            } catch (error) {
                console.error("Error:", error);
                alert("Network error.");
                button.disabled = false;
                button.innerText = originalText;
            }
        });
    });
</script>

<style>
    .newsletter-signup {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: clamp(48px, 5vw, 80px) 0;
    }

    .newsletter-signup__card {
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: clamp(48px, 5vw, 80px);
        gap: clamp(16px, 2vw, 32px);
        width: 100%;
        max-width: clamp(640px, 40vw, 1000px);
        background: var(--bg-card);
        border: 1px solid var(--text-main);
        box-shadow: var(--shadow-sm);
        border-radius: var(--radius-card);
    }

    .newsletter-signup__header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 4px;
    }

    .newsletter-signup__title {
        margin: 0;
        font-family: var(--font-heading), sans-serif;
        font-weight: var(--weight-black);
        font-size: clamp(36px, 3vw, 72px);
        line-height: 1.1;
        color: var(--text-main);
    }

    .newsletter-signup__subtitle {
        margin: 0;
        font-family: var(--font-body), sans-serif;
        font-weight: var(--weight-regular);
        font-size: clamp(12px, 1vw, 20px);
        line-height: 1.5;
        color: var(--text-accent);
    }

    .newsletter-signup__form {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: clamp(16px, 1.5vw, 24px);
        width: 100%;
        max-width: 80%;
    }

    .newsletter-signup__field {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .newsletter-signup__field label {
        font-family: var(--font-body);
        font-size: clamp(12px, 1vw, 18px);
        color: var(--text-main);
        font-weight: var(--weight-regular);
    }

    .newsletter-signup__field input {
        width: 100%;
        height: clamp(44px, 4vw, 64px);
        background: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: var(--radius-sm);
        padding: 0 1rem;
        font-family: var(--font-body);
        font-size: clamp(16px, 1.2vw, 24px);
        color: var(--input-text);
        outline: none;
        box-sizing: border-box;
        transition: border-width 0.1s;
    }

    .newsletter-signup__field input:focus {
        border-width: 2px;
    }

    .newsletter-signup__btn {
        display: flex;
        justify-content: center;
        align-items: center;
        width: clamp(130px, 10vw, 200px);
        height: clamp(55px, 4vw, 70px);
        background: var(--btn-bg-primary);
        border-radius: var(--radius-pill);
        border: none;
        cursor: pointer;
        margin-top: 10px;
        padding: 17px 29px;
        font-family: var(--font-body);
        font-weight: var(--weight-semibold);
        font-size: 15px;
        letter-spacing: 2px;
        color: var(--btn-text-primary);
        text-transform: uppercase;
        white-space: nowrap;
        transition: transform 0.1s;
    }

    .newsletter-signup__btn:hover {
        transform: scale(1.02);
    }
    .newsletter-signup__btn:active {
        transform: scale(0.98);
    }

    @media (max-width: 768px) {
        .newsletter-signup__card {
            width: 90%;
            padding: 24px;
        }
    }
</style>
