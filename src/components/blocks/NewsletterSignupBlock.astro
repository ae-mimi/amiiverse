---
import NewsletterForm from "../forms/newsletter/NewsletterForm.astro";

interface Props {
    title?: string;
    subtitle?: string;
    buttonText?: string;
    successRedirect?: string;
}

const {
    title = "JOIN THE AMII-GOS",
    subtitle = "Get early access, updates, and behind-the-scenes",
    buttonText = "JOIN US",
    successRedirect = "/newsletter-queue",
} = Astro.props;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<NewsletterForm
    title={title}
    subtitle={subtitle}
    buttonText={buttonText}
    successRedirect={successRedirect}
    turnstileSiteKey={turnstileSiteKey}
/>
