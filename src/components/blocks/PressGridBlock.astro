---
import { fetchSanity as getSanityContent } from "../../lib/sanity/client";
import { ALL_PRESS_QUERY } from "../../lib/sanity/queries";
import PressItem from "../ui/PressItem.astro";

const { title } = Astro.props;
const pressItems = await getSanityContent(ALL_PRESS_QUERY);
const sortedPress = pressItems || [];
---

<section class="press-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="press-list">
            {sortedPress.map((item: any) => <PressItem item={item} />)}
        </div>
    </div>
</section>

<style>
    .press-grid-block {
        height: auto; /* Ensure it fits content */
        padding-block: var(--space-lg);
        background-color: var(--bg-page);
    }

    .press-list {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }
</style>
