---
import { getCollection } from "astro:content";

const { title } = Astro.props;
const pressItems = await getCollection("press");
const sortedPress = pressItems.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<section class="press-grid-block">
    <div class="container">
        {title && <h2 class="section-title">{title}</h2>}
        <div class="press-list">
            {
                sortedPress.map((item) => (
                    <div class="press-item">
                        <h3 class="press-title">{item.data.title}</h3>
                        <p class="press-date">
                            {item.data.date.toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </p>
                        {item.data.file && (
                            <a
                                href={item.data.file}
                                target="_blank"
                                class="press-link"
                            >
                                READ MORE
                            </a>
                        )}
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .press-grid-block {
        padding: 60px 20px;
        background-color: var(--bg-page);
    }
    .container {
        max-width: 800px;
        margin: 0 auto;
    }
    .section-title {
        font-family: var(--font-heading);
        font-size: 40px;
        color: var(--text-main);
        text-align: center;
        margin-bottom: 40px;
    }
    .press-list {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }
    .press-item {
        border-bottom: 1px solid var(--text-main);
        padding-bottom: 30px;
    }
    .press-item:last-child {
        border-bottom: none;
    }
    .press-title {
        font-family: var(--font-heading);
        font-size: 24px;
        color: var(--text-main);
        margin: 0 0 10px 0;
    }
    .press-date {
        font-family: var(--font-body);
        color: var(--text-main);
        opacity: 0.7;
        margin-bottom: 15px;
    }
    .press-link {
        font-family: var(--font-body);
        font-weight: bold;
        color: var(--text-main);
        text-decoration: underline;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
</style>
