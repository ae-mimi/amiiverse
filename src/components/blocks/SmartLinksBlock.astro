---
/**
 * SmartLinksBlock — Shows streaming platform links for a release.
 */
import { getActivePlatforms } from "../../lib/utils/platforms";
import type { SmartLinksSection } from "../../lib/sanity/types";

interface Props extends SmartLinksSection {}

const { release } = Astro.props;

if (!release) return null;

const platforms = getActivePlatforms(release.platformLinks as any);
---

<section class="smart-links" aria-label={`Listen to ${release.title}`}>
    <div class="smart-links__inner">
        <h2 class="smart-links__title">{release.title}</h2>

        {
            release.smartLinkUrl && (
                <a
                    href={release.smartLinkUrl}
                    class="smart-links__universal"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Listen Now →
                </a>
            )
        }

        {
            platforms.length > 0 && (
                <div
                    class="smart-links__grid"
                    role="list"
                    aria-label="Available on"
                >
                    {platforms.map((p) => (
                        <a
                            href={p.url}
                            class="smart-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            role="listitem"
                            aria-label={p.label}
                        >
                            <span class="smart-link__label">{p.label}</span>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</section>

<style>
    .smart-links {
        padding: clamp(2rem, 5vw, 4rem) 0;
        text-align: center;
    }
    .smart-links__inner {
        max-width: 600px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .smart-links__title {
        font-size: clamp(1.25rem, 2.5vw, 2rem);
        font-weight: 800;
        margin-bottom: 1rem;
    }
    .smart-links__universal {
        display: inline-block;
        padding: 0.75rem 2rem;
        background: var(--color-accent, #e44598);
        color: #fff;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 1.5rem;
        transition: opacity 0.2s;
    }
    .smart-links__universal:hover {
        opacity: 0.85;
    }
    .smart-links__grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .smart-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 0.85rem;
        border: 1px solid rgba(0, 0, 0, 0.1);
        border-radius: 0.5rem;
        text-decoration: none;
        color: inherit;
        transition: background 0.2s;
    }
    .smart-link:hover {
        background: rgba(0, 0, 0, 0.04);
    }
    .smart-link__label {
        font-weight: 600;
        font-size: 0.95rem;
    }
</style>
