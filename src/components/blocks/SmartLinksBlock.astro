---
/**
 * SmartLinksBlock — Shows streaming platform links for a release.
 */
import { getActivePlatforms } from "../../lib/utils/platforms";
import type { SmartLinksSection } from "../../lib/sanity/types";

interface Props extends SmartLinksSection {}

const { release } = Astro.props;

if (!release) return null;

const platforms = getActivePlatforms(release.platformLinks as any);
const buttonStyle = Astro.props.buttonStyle || "filled";
const buttonShape = Astro.props.buttonShape || "rounded";
const showUniversalLink = Astro.props.showUniversalLink !== false;
const universalLinkLabel = Astro.props.universalLinkLabel || "Listen Now";
---

<section
    class={`smart-links smart-links--${buttonStyle} smart-links--${buttonShape}`}
    aria-label={`Listen to ${release.title}`}
>
    <div class="smart-links__inner">
        <h2 class="smart-links__title">{release.title}</h2>

        {
            showUniversalLink && release.smartLinkUrl && (
                <a
                    href={release.smartLinkUrl}
                    class="smart-links__universal"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {universalLinkLabel}
                </a>
            )
        }

        {
            platforms.length > 0 && (
                <div
                    class="smart-links__grid"
                    role="list"
                    aria-label="Available on"
                >
                    {platforms.map((p) => (
                        <a
                            href={p.url}
                            class="smart-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            role="listitem"
                            aria-label={p.label}
                        >
                            <span class="smart-link__label">{p.label}</span>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</section>

<style>
    .smart-links {
        padding: clamp(2rem, 5vw, 4rem) 0;
        text-align: center;
    }
    .smart-links__inner {
        max-width: 600px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }
    .smart-links__title {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800;
        margin: 0 0 1.5rem;
        color: var(--color-primary);
        text-transform: uppercase;
    }
    .smart-links__universal {
        display: inline-block;
        padding: 0.9rem 2.2rem;
        background: var(--color-primary);
        color: var(--color-secondary);
        border: 2px solid var(--color-primary);
        border-radius: var(--smart-link-radius);
        text-decoration: none;
        font-family: var(--font-body);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 1.5rem;
        transition:
            transform 0.2s ease,
            background 0.2s ease,
            color 0.2s ease;
    }
    .smart-links__universal:hover {
        transform: translateY(-2px);
    }
    .smart-links__grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .smart-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        min-height: 4rem;
        padding: 0.95rem 1.25rem;
        border: 2px solid var(--smart-link-border);
        border-radius: var(--smart-link-radius);
        background: var(--smart-link-bg);
        text-decoration: none;
        color: var(--smart-link-color);
        transition:
            transform 0.2s ease,
            background 0.2s ease,
            color 0.2s ease,
            border-color 0.2s ease;
    }
    .smart-link:hover {
        transform: translateY(-2px);
        background: var(--smart-link-hover-bg);
        color: var(--smart-link-hover-color);
        border-color: var(--smart-link-hover-border);
    }
    .smart-link__label {
        font-weight: 900;
        font-size: 1rem;
    }

    .smart-links--filled {
        --smart-link-bg: var(--color-primary);
        --smart-link-color: var(--color-secondary);
        --smart-link-border: var(--color-primary);
        --smart-link-hover-bg: color-mix(in srgb, var(--color-primary), black 10%);
        --smart-link-hover-color: var(--color-secondary);
        --smart-link-hover-border: color-mix(in srgb, var(--color-primary), black 10%);
    }

    .smart-links--outline {
        --smart-link-bg: transparent;
        --smart-link-color: var(--color-primary);
        --smart-link-border: color-mix(in srgb, var(--color-primary), transparent 35%);
        --smart-link-hover-bg: var(--color-primary);
        --smart-link-hover-color: var(--color-secondary);
        --smart-link-hover-border: var(--color-primary);
    }

    .smart-links--soft {
        --smart-link-bg: color-mix(in srgb, var(--color-primary), transparent 92%);
        --smart-link-color: var(--color-primary);
        --smart-link-border: color-mix(in srgb, var(--color-primary), transparent 72%);
        --smart-link-hover-bg: color-mix(in srgb, var(--color-primary), transparent 84%);
        --smart-link-hover-color: var(--color-primary);
        --smart-link-hover-border: color-mix(in srgb, var(--color-primary), transparent 48%);
    }

    .smart-links--rounded {
        --smart-link-radius: 0.75rem;
    }

    .smart-links--pill {
        --smart-link-radius: 999px;
    }

    .smart-links--square {
        --smart-link-radius: 0;
    }
</style>
