---
import Navigation from "./Navigation.astro";
import HeaderSocials from "./HeaderSocials.astro";

interface Props {
    links: Array<Record<string, any>>;
    socials?: Array<Record<string, any>>;
}

const { links, socials = [] } = Astro.props;
---

<div id="mobile-menu-overlay" aria-hidden="true" inert>
    <Navigation
        links={links}
        layout="column"
        theme="default"
        class="mobile-nav"
    />

    <HeaderSocials socials={socials} class="mobile-socials" />
</div>
