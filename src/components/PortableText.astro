---
interface Props {
    value: any[];
}

const { value } = Astro.props;

/**
 * Basic Portable Text to HTML converter for simple blocks.
 */
function toHTML(blocks: any[]) {
    if (!blocks || !Array.isArray(blocks)) return "";

    return blocks
        .map((block) => {
            if (block._type !== "block" || !block.children) {
                return "";
            }

            const text = block.children
                .map((child: any) => {
                    let content = child.text || "";
                    if (child.marks?.includes("strong"))
                        content = `<strong>${content}</strong>`;
                    if (child.marks?.includes("em"))
                        content = `<em>${content}</em>`;
                    return content;
                })
                .join("");

            const style = block.style || "normal";
            if (style === "h1") return `<h1>${text}</h1>`;
            if (style === "h2") return `<h2>${text}</h2>`;
            if (style === "h3") return `<h3>${text}</h3>`;
            if (style === "blockquote")
                return `<blockquote>${text}</blockquote>`;

            return `<p>${text}</p>`;
        })
        .join("");
}

const html = toHTML(value);
---

<div class="portable-text" set:html={html} />

<style is:global>
    .portable-text p {
        margin-bottom: 1.25em;
    }
    .portable-text strong {
        font-weight: 700;
    }
    .portable-text em {
        font-style: italic;
    }
    .portable-text h1,
    .portable-text h2,
    .portable-text h3 {
        font-family: var(--font-heading);
        margin-top: 1.5em;
        margin-bottom: 0.5em;
    }
</style>
