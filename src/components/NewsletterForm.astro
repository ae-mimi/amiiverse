---

<section
    id="newsletter"
    class="form-section"
    style="width: 100%; max-width: 1280px; margin: 0 auto; border-top: 2px solid var(--text-main); display: flex; justify-content: center; padding: 64px 0;"
>
    <!-- Form Card: Style forced inline to ensure layout stability -->
    <div
        class="form-card"
        style="box-sizing: border-box; display: flex; flex-direction: column; align-items: center; padding: 48px; gap: 16px; width: 100%; max-width: 640px; background: var(--bg-card); border: 1px solid var(--text-main); box-shadow: var(--shadow-sm); border-radius: var(--radius-card); position: relative;"
    >
        <!-- Headline -->
        <div
            class="form-header"
            style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;"
        >
            <h2
                class="form-title"
                style="margin: 0; font-family: var(--font-heading), sans-serif; font-weight: var(--weight-black); font-size: 36px; line-height: 40px; color: var(--text-main);"
            >
                JOIN THE AMII-GOS
            </h2>
            <p
                class="form-subtitle"
                style="margin: 0; font-family: var(--font-body), sans-serif; font-weight: var(--weight-regular); font-size: 12px; line-height: 19px; color: var(--text-accent);"
            >
                Get early access, updates, and behind-the-scenes
            </p>
        </div>

        <!-- Form -->
        <form
            class="signup-form"
            onsubmit="event.preventDefault();"
            style="display: flex; flex-direction: column; align-items: center; gap: 16px; width: 100%; max-width: 544px;"
        >
            <!-- Name Input -->
            <div
                class="input-group"
                style="width: 100%; display: flex; flex-direction: column; gap: 4px;"
            >
                <label
                    for="name"
                    style="font-family: var(--font-body); font-size: 12px; color: var(--text-main); font-weight: var(--weight-regular);"
                    >NAME</label
                >
                <input
                    type="text"
                    id="name"
                    name="NAME"
                    style="width: 100%; height: 44px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-sm); padding: 0 1rem; font-family: var(--font-body); font-size: 16px; color: var(--input-text); outline: none; box-sizing: border-box;"
                />
            </div>

            <!-- Email Input -->
            <div
                class="input-group"
                style="width: 100%; display: flex; flex-direction: column; gap: 4px;"
            >
                <label
                    for="email"
                    style="font-family: var(--font-body); font-size: 12px; color: var(--text-main); font-weight: var(--weight-regular);"
                    >EMAIL</label
                >
                <input
                    type="email"
                    id="email"
                    name="EMAIL"
                    style="width: 100%; height: 44px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: var(--radius-sm); padding: 0 1rem; font-family: var(--font-body); font-size: 16px; color: var(--input-text); outline: none; box-sizing: border-box;"
                />
            </div>

            <!-- Button -->
            <button
                type="submit"
                class="submit-btn"
                style="display: flex; justify-content: center; align-items: center; width: 130px; height: 55px; background: var(--btn-bg-primary); border-radius: var(--radius-pill); border: none; cursor: pointer; margin-top: 10px; padding: 17px 29px; font-family: var(--font-body); font-weight: var(--weight-semibold); font-size: 15px; letter-spacing: 2px; color: var(--btn-text-primary); text-transform: uppercase; white-space: nowrap;"
            >
                JOIN US
            </button>
        </form>
    </div>
</section>

<!-- Scoped styles for interactions/media queries that are harder to inline -->
<style>
    .submit-btn:hover {
        transform: scale(1.02);
    }
    .submit-btn:active {
        transform: scale(0.98);
    }
    .input-group input:focus {
        border-width: 2px;
    }

    @media (max-width: 768px) {
        .form-card {
            width: 90% !important;
            padding: 24px !important;
            min-height: auto !important;
        }
    }
</style>
