---
const links = [
    { label: "HOME", href: "/" },
    { label: "MUSIC", href: "/music" },
    { label: "ABOUT", href: "/about" },
    { label: "PRESS", href: "/press" },
    { label: "CONTACT", href: "/contact" },
    { label: "FOLLOW", href: "/follow", isBold: true },
];
---

<footer class="site-footer">
    <div class="footer-container">
        <!-- Desktop Grid: Left (Logo) | Center (Socials) | Right (Nav) -->
        <div class="footer-content">
            <!-- Logo Section -->
            <div class="logo-section">
                <a href="/" aria-label="Amii Home">
                    <svg
                        width="120"
                        height="72"
                        viewBox="0 0 120 72"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <ellipse
                            cx="60"
                            cy="36"
                            rx="58"
                            ry="34"
                            stroke="#FDF38A"
                            stroke-width="1.5"></ellipse>
                        <ellipse
                            cx="60"
                            cy="36"
                            rx="52"
                            ry="28"
                            stroke="#FDF38A"
                            stroke-width="0.5"
                            stroke-opacity="0.5"></ellipse>
                        <text
                            x="50%"
                            y="55%"
                            dominant-baseline="middle"
                            text-anchor="middle"
                            fill="#FDF38A"
                            font-family="'Archivo', sans-serif"
                            font-weight="400"
                            font-size="34"
                            letter-spacing="-2"
                            >ami<tspan dx="-2" dy="-8" font-size="20">★</tspan
                            >i</text
                        >
                    </svg>
                </a>
            </div>

            <!-- Socials Section -->
            <div class="socials-section">
                <a href="#" aria-label="TikTok">
                    <svg
                        width="21"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="icon-md"
                        ><path
                            d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 12.01a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.46z"
                        ></path></svg
                    >
                </a>
                <a href="#" aria-label="Instagram">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        class="icon-md"
                        ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                        ></rect><path
                            d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                        ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                        ></line></svg
                    >
                </a>
                <a href="#" aria-label="Spotify">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="icon-md"
                        ><path
                            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.59 14.42c-.18.3-.56.41-.86.23-2.35-1.44-5.3-1.76-8.79-.96-.34.08-.68-.13-.76-.47-.07-.33.14-.67.48-.75 3.86-.88 7.18-.5 9.87 1.14.3.17.4.55.22.85zm1.22-2.71c-.22.36-.67.48-1.04.26-2.69-1.66-6.8-2.14-9.97-1.17-.41.12-.85-.11-.97-.52-.12-.42.11-.85.53-.98 3.65-1.1 8.27-.58 11.37 1.33.37.23.49.68.27 1.04zm.1-2.77c-3.23-1.92-8.56-2.1-11.64-1.16-.49.15-1.01-.13-1.16-.62-.15-.49.13-1.01.62-1.16 3.56-1.08 9.47-.88 13.19 1.33.45.27.6.86.33 1.31-.26.46-.85.6-1.31.33z"
                        ></path></svg
                    >
                </a>
                <a href="#" aria-label="YouTube">
                    <svg
                        width="34"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        class="icon-md"
                        ><path
                            d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33zM9.75 15.02l5.75-3.27-5.75-3.27v6.54z"
                        ></path></svg
                    >
                </a>
            </div>

            <!-- Nav Section -->
            <nav class="nav-section">
                <ul>
                    {
                        links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class={link.isBold ? "bold" : ""}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <!-- Bottom: Copyright -->
        <div class="copyright">
            <p>Copyright ©amii 2026</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background-color: #15499d;
        color: #fdf38a; /* Default color fallback */
        padding: 64px 32px;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .footer-container {
        width: 100%;
        max-width: 1216px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 64px;
    }

    /* Default Mobile: Stacked */
    .footer-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
    }

    .logo-section,
    .socials-section,
    .nav-section {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .socials-section {
        gap: 10px;
    }

    .socials-section a {
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px; /* Touch target */
        min-height: 44px; /* Touch target */
    }

    .icon-md {
        height: var(--icon-md); /* 24px */
        width: auto; /* Allow width to vary for YouTube/TikTok aspects, or set fixed if strictly needed */
    }

    .nav-section ul {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 48px;
        row-gap: 32px;
        list-style: none;
        text-align: center;
    }

    .nav-section a {
        font-family: "Archivo", sans-serif;
        font-size: 12px;
        letter-spacing: 2px;
        color: #fdf38a;
        text-decoration: none;
        font-weight: 400;
    }
    .nav-section a.bold {
        font-weight: 700;
    }

    .copyright p {
        font-family: "Archivo", sans-serif;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #fef9c4;
        text-align: center;
    }

    /* Desktop Grid Layout */
    @media (min-width: 1024px) {
        .footer-content {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center; /* Vertically center everything in the row */
            gap: 0;
        }

        .logo-section {
            justify-content: flex-start;
            padding-left: 10%; /* Estimated offset */
        }

        .socials-section {
            justify-content: center;
        }

        .nav-section {
            justify-content: flex-end;
            padding-right: 9%; /* Estimated offset */
        }

        .nav-section ul {
            text-align: right;
            /* Nav items grid on desktop? 
              Figma CSS showed explicit positioning for each item.
              But visual grid 2x3 implies consistent layout.
              We'll keep the grid but align it right. 
           */
        }
    }
</style>
