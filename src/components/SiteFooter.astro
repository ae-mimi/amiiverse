---
import { Icon } from "astro-icon/components";

const links = [
    { label: "HOME", href: "/" },
    { label: "MUSIC", href: "/music" },
    { label: "ABOUT", href: "/about" },
    { label: "PRESS", href: "/press" },
    { label: "CONTACT", href: "/contact" },
    { label: "FOLLOW", href: "/follow", isBold: true },
];
---

<footer class="site-footer">
    <div class="footer-container">
        <!-- Desktop Grid: Left (Logo) | Center (Socials) | Right (Nav) -->
        <div class="footer-content">
            <!-- Logo Section -->
            <div class="logo-section">
                <a href="/" aria-label="Amii Home">
                    <svg
                        width="120"
                        height="72"
                        viewBox="0 0 120 72"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <ellipse
                            cx="60"
                            cy="36"
                            rx="58"
                            ry="34"
                            stroke="#FDF38A"
                            stroke-width="1.5"></ellipse>
                        <ellipse
                            cx="60"
                            cy="36"
                            rx="52"
                            ry="28"
                            stroke="#FDF38A"
                            stroke-width="0.5"
                            stroke-opacity="0.5"></ellipse>
                        <text
                            x="50%"
                            y="55%"
                            dominant-baseline="middle"
                            text-anchor="middle"
                            fill="#FDF38A"
                            font-family="'Archivo', sans-serif"
                            font-weight="400"
                            font-size="34"
                            letter-spacing="-2"
                            >ami<tspan dx="-2" dy="-8" font-size="20">★</tspan
                            >i</text
                        >
                    </svg>
                </a>
            </div>

            <!-- Socials Section -->
            <div class="socials-section">
                <a href="#" aria-label="TikTok">
                    <Icon name="simple-icons:tiktok" class="icon-md" />
                </a>
                <a href="#" aria-label="Instagram">
                    <Icon name="simple-icons:instagram" class="icon-md" />
                </a>
                <a href="#" aria-label="Spotify">
                    <Icon name="simple-icons:spotify" class="icon-md" />
                </a>
                <a href="#" aria-label="YouTube">
                    <Icon name="simple-icons:youtube" class="icon-md" />
                </a>
            </div>

            <!-- Nav Section -->
            <nav class="nav-section">
                <ul>
                    {
                        links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class={link.isBold ? "bold" : ""}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>

        <!-- Bottom: Copyright -->
        <div class="copyright">
            <p>Copyright ©amii 2026</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background-color: #15499d;
        color: #fdf38a; /* Default color fallback */
        padding: 64px 32px;
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .footer-container {
        width: 100%;
        max-width: 1216px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 64px;
    }

    /* Default Mobile: Stacked */
    .footer-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 40px;
    }

    .logo-section,
    .socials-section,
    .nav-section {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .socials-section {
        gap: 10px;
    }

    .socials-section a {
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px; /* Touch target */
        min-height: 44px; /* Touch target */
    }

    .icon-md {
        height: var(--icon-md); /* 24px */
        width: auto; /* Allow width to vary for YouTube/TikTok aspects, or set fixed if strictly needed */
    }

    .nav-section ul {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 48px;
        row-gap: 32px;
        list-style: none;
        text-align: center;
    }

    .nav-section a {
        font-family: "Archivo", sans-serif;
        font-size: 12px;
        letter-spacing: 2px;
        color: #fdf38a;
        text-decoration: none;
        font-weight: 400;
    }
    .nav-section a.bold {
        font-weight: 700;
    }

    .copyright p {
        font-family: "Archivo", sans-serif;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 2px;
        color: #fef9c4;
        text-align: center;
    }

    /* Desktop Grid Layout */
    @media (min-width: 1024px) {
        .footer-content {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center; /* Vertically center everything in the row */
            gap: 0;
        }

        .logo-section {
            justify-content: flex-start;
            padding-left: 10%; /* Estimated offset */
        }

        .socials-section {
            justify-content: center;
        }

        .nav-section {
            justify-content: flex-end;
            padding-right: 9%; /* Estimated offset */
        }

        .nav-section ul {
            text-align: right;
            /* Nav items grid on desktop? 
              Figma CSS showed explicit positioning for each item.
              But visual grid 2x3 implies consistent layout.
              We'll keep the grid but align it right. 
           */
        }
    }
</style>
