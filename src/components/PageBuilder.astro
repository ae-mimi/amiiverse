---
/**
 * PageBuilder — renders an array of sections from Sanity page data.
 * Each section._type maps to a specific Astro component.
 */

// ── Existing block components ───────────────────────────
import HeroBlock from "./blocks/HeroBlock.astro";
import IntroBlock from "./blocks/IntroBlock.astro";
import WidgetBlock from "./blocks/WidgetBlock.astro";
import RichTextBlock from "./blocks/RichTextBlock.astro";
import PredebutHeroBlock from "./blocks/PredebutHeroBlock.astro";
import PageHeroBlock from "./blocks/PageHeroBlock.astro";
import MusicGridBlock from "./blocks/MusicGridBlock.astro";
import PressGridBlock from "./blocks/PressGridBlock.astro";
import MembersGridBlock from "./blocks/MembersGridBlock.astro";
import ContactFormBlock from "./blocks/ContactFormBlock.astro";
import ContactSectionBlock from "./blocks/ContactSectionBlock.astro";
import ProfileHeaderBlock from "./blocks/ProfileHeaderBlock.astro";
import LinkStackBlock from "./blocks/LinkStackBlock.astro";
import VideoEmbedBlock from "./blocks/VideoEmbedBlock.astro";
import GalleryBlock from "./blocks/GalleryBlock.astro";
import EventsBlock from "./blocks/EventsBlock.astro";
import CountdownBlock from "./blocks/CountdownBlock.astro";
import CTABannerBlock from "./blocks/CTABannerBlock.astro";
import FAQBlock from "./blocks/FAQBlock.astro";
import TestimonialsBlock from "./blocks/TestimonialsBlock.astro";
import SpacerBlock from "./blocks/SpacerBlock.astro";
import DividerBlock from "./blocks/DividerBlock.astro";
import MarqueeBlock from "./blocks/MarqueeBlock.astro";
import LyricHighlightBlock from "./blocks/LyricHighlightBlock.astro";

// ── New block components ────────────────────────────────
import ReleaseSpotlightBlock from "./blocks/ReleaseSpotlightBlock.astro";
import DiscographyGridBlock from "./blocks/DiscographyGridBlock.astro";
import VideoGalleryBlock from "./blocks/VideoGalleryBlock.astro";
import TourDatesBlock from "./blocks/TourDatesBlock.astro";
import EmailSignupBlock from "./blocks/EmailSignupBlock.astro";
import FanWallBlock from "./blocks/FanWallBlock.astro";
import DownloadsCenterBlock from "./blocks/DownloadsCenterBlock.astro";
import TimelineBlock from "./blocks/TimelineBlock.astro";
import MediaTextBlock from "./blocks/MediaTextBlock.astro";
import SmartLinksBlock from "./blocks/SmartLinksBlock.astro";
import CreditsBlock from "./blocks/CreditsBlock.astro";
import ShortsWallBlock from "./blocks/ShortsWallBlock.astro";
import NewsFeedBlock from "./blocks/NewsFeedBlock.astro";
import PressCoverageBlock from "./blocks/PressCoverageBlock.astro";
import PollBlock from "./blocks/PollBlock.astro";
import NewsletterSignupBlock from "./blocks/NewsletterSignupBlock.astro";
import ShopGridBlock from "./blocks/ShopGridBlock.astro";

import type { PageSection } from "../lib/sanity/types";

interface Props {
    sections: PageSection[];
}

const { sections } = Astro.props;

const blockRegistry = {
    hero: HeroBlock,
    predebut_hero: PredebutHeroBlock,
    page_hero: PageHeroBlock,
    intro: IntroBlock,
    media_text: MediaTextBlock,
    rich_text: RichTextBlock,
    gallery_block: GalleryBlock,
    video_embed: VideoEmbedBlock,
    cta_banner: CTABannerBlock,
    countdown: CountdownBlock,
    faq: FAQBlock,
    testimonials: TestimonialsBlock,
    release_spotlight: ReleaseSpotlightBlock,
    discography_grid: DiscographyGridBlock,
    smart_links: SmartLinksBlock,
    credits_block: CreditsBlock,
    video_gallery: VideoGalleryBlock,
    shorts_wall: ShortsWallBlock,
    news_feed: NewsFeedBlock,
    tour_dates: TourDatesBlock,
    events: EventsBlock,
    music_grid: MusicGridBlock,
    members_grid: MembersGridBlock,
    shop_grid: ShopGridBlock,
    product_grid: ShopGridBlock,
    press_grid: PressGridBlock,
    press_quotes: PressCoverageBlock,
    downloads_center: DownloadsCenterBlock,
    fan_wall: FanWallBlock,
    poll_block: PollBlock,
    timeline: TimelineBlock,
    widget: WidgetBlock,
    email_signup: EmailSignupBlock,
    newsletter_signup: NewsletterSignupBlock,
    contact_form: ContactFormBlock,
    contact_section: ContactSectionBlock,
    profile_header: ProfileHeaderBlock,
    link_stack: LinkStackBlock,
    spacer: SpacerBlock,
    divider: DividerBlock,
    marquee: MarqueeBlock,
    lyric_highlight: LyricHighlightBlock,
} as const;
---

{
    sections?.map((section: PageSection) => {
        const key = section._type as keyof typeof blockRegistry;
        const Component = blockRegistry[key];

        if (Component) {
            return <Component {...(section as any)} />;
        }

        const s = section as any;
        console.warn(`[PageBuilder] Unknown section type: "${s._type}"`);
        return (
            <div class="unknown-section" data-type={s._type}>
                <p style="padding:2rem;text-align:center;color:var(--text-muted);font-size:0.875rem;">
                    Section type "{s._type}" is not yet implemented.
                </p>
            </div>
        );
    })
}
