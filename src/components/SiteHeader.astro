---
import { Icon } from "astro-icon/components";

import { getGlobalSettings } from "../utils/global";
const settings = getGlobalSettings();
const links = settings.nav || [];

// Retain conditional logic if needed, or rely purely on the CMS list.
// If the user wants "FOLLOW" in the main nav, they can add it via CMS.
// However, if strict compat is needed:
if (settings.enable_follow_link && !links.find((l) => l.href === "/follow")) {
    // Optional: Auto-inject if missing? Or just trust the user?
    // Let's trust the CMS list for the main nav.
}

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
---

<header class="site-header">
    <div class="header-inner">
        <!-- Left: Logo -->
        <a href="/" class="logo-link" aria-label="Amii Home">
            <img
                class="header-logo-img"
                src={settings.site_info?.logo_navy ||
                    "/assets/uploads/amii-logo_op-navy.webp"}
                alt={settings.site_info?.title || "Amii Logo"}
                loading="eager"
                width="98"
                height="59"
            />
            <style
                define:vars={{
                    logoNavy: `url(${settings.site_info?.logo_navy})`,
                    logoYellow: `url(${settings.site_info?.logo_yellow})`,
                }}
            ></style>
        </a>

        <!-- Center: Navbar -->
        <nav class="main-nav">
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class={
                                    normalizePath(currentPath) ===
                                    normalizePath(link.href)
                                        ? "active"
                                        : ""
                                }
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <!-- Right: Actions -->
        <div class="header-actions">
            <!-- Social Icons (Desktop) -->
            <div class="header-socials">
                {
                    settings.socials?.map((social) => (
                        <a
                            href={social.url}
                            aria-label={social.platform}
                            target="_blank"
                        >
                            <Icon
                                name={`simple-icons:${social.icon}`}
                                class="icon-social"
                            />
                        </a>
                    ))
                }
            </div>

            <!-- Mobile Menu Toggle (Contains both icons for perfect alignment) -->
            <button id="menu-toggle" aria-label="Toggle Menu">
                <div class="icon-container">
                    <Icon name="lucide:menu" class="icon-menu" />
                    <Icon name="lucide:x" class="icon-close" />
                </div>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Overlay -->
    <div id="mobile-menu-overlay">
        <!-- Close Button Removed (Reused Toggle) -->

        <nav class="mobile-nav">
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a href={link.href}>{link.label}</a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        {
            settings.enable_follow_link && (
                <a href="/follow" class="mobile-follow-btn">
                    FOLLOW
                </a>
            )
        }

        <div class="mobile-socials">
            {
                settings.socials?.map((social) => (
                    <a
                        href={social.url}
                        aria-label={social.platform}
                        target="_blank"
                    >
                        <Icon name={`simple-icons:${social.icon}`} />
                    </a>
                ))
            }
        </div>
    </div>
</header>

<style>
    /* Header Container - "Header Light Mode" layer */
    /* Header Container - "Header Light Mode" layer */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        min-height: 84px; /* Changed from fixed height */
        background-color: var(--bg-header);
        padding: 24px 34px 0 34px; /* Added top padding */
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        z-index: 1000;
        transition: transform 0.3s ease; /* Fallback for non-GSAP */
        /* Border removed per user request */
    }

    .header-inner {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: flex-start; /* Aligned top to match padding */
    }

    .main-nav ul {
        display: flex;
        gap: 40px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .logo-link {
        display: block;
        line-height: 0;
    }

    .header-logo-img {
        width: 98px;
        height: auto;
        display: block;
        /* Sun Mode Default */
        content: url("/assets/uploads/amii-logo_op-navy.webp");
    }

    /* Dark Mode Toggle for Logo */
    :global([data-theme="deep-dive"]) .header-logo-img {
        content: url("/assets/uploads/amii-logo_op-yellow.webp");
    }

    .main-nav a {
        font-family: var(--font-body);
        font-style: normal;
        font-weight: var(--weight-regular);
        font-size: var(--text-xs);
        line-height: 16px;
        letter-spacing: 2px;
        color: var(--text-nav);
        text-decoration: none;
        text-transform: uppercase;
        font-stretch: 100%;
        transition: opacity 0.2s;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .header-socials {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 1024px) {
        .header-socials {
            display: none;
        }
    }

    .header-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 44px; /* Touch target */
        height: 44px;
        color: var(--text-nav);
        transition:
