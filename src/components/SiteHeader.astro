        height: 44px;
        color: var(--text-main);
        transition: transform 0.2s;
    }

    .mobile-socials a:hover {
        transform: scale(1.1);
    }

    .header-inner {
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center; /* Changed to center for better vertical alignment */
        position: relative; /* Context for absolute centering */
    }

    .main-nav {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

    .main-nav ul {
        display: flex;
        gap: 40px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .logo-link {
        display: block;
        line-height: 0;
    }

    .header-logo-img {
        width: 98px;
        height: auto;
        display: block;
        /* Sun Mode Default */
        content: var(--logoNavy);
    }

    /* Dark Mode Toggle for Logo */
    :global([data-theme="deep-dive"]) .header-logo-img {
        content: var(--logoYellow);
    }

    .main-nav a {
        font-family: "Archivo";
        font-style: normal;
        font-weight: 400; /* Default Regular */
        font-size: 12px; /* Spec says 12px */
        line-height: 16px;
        letter-spacing: 2px;
        color: var(--color-navy-500); /* Was #15499d */
