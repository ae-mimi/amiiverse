    }

    /* Mobile Menu Toggle */
    #menu-toggle {
        display: none; /* Hidden on desktop */
    }

    /* Responsive Mobile */
    @media (max-width: 768px) {
        .site-header {
            height: auto; /* Hug content per request */
            min-height: 54px; /* Minimum visual bulk */
            padding: 16px 8px; /* Added padding-y (16px) */
            background-color: var(--color-yellow-500); /* Was #fdf38a */
            border-bottom: none;
        }

        .main-nav {
