    /* Handled by Global Swap */
</style>

<script>
    import { gsap } from "gsap";

    // Theme Toggle Logic Removed

    const menuToggle = document.getElementById("menu-toggle");
    // const menuClose = document.getElementById("menu-close");
    const mobileMenu = document.getElementById("mobile-menu-overlay");
    const mobileLinks = document.querySelectorAll(".mobile-nav li");
    const mobileFollow = document.querySelector(".mobile-follow-btn");
    const mobileSocials = document.querySelector(".mobile-socials");

    const iconMenu = document.querySelector(".icon-menu");
    const iconClose = document.querySelector(".icon-close");

    let isMenuOpen = false;

    if (menuToggle && mobileMenu) {
        // Create GSAP Timeline
        const tl = gsap.timeline({ paused: true, reversed: true });

        // Animation Definition
        tl.to(mobileMenu, {
            duration: 0.4,
            opacity: 1,
            pointerEvents: "all",
            ease: "power2.inOut",
            display: "flex", // Ensure it's visible for animation
        })
            .to(
                iconMenu,
                {
                    opacity: 0,
                    rotation: 90,
                    duration: 0.2,
                },
                "<",
            )
            .to(
                iconClose,
                {
                    opacity: 1,
                    rotation: 0,
                    duration: 0.2,
                },
                "<",
            )
            .from(
                [mobileLinks, mobileFollow, mobileSocials],
                {
                    y: 20,
                    opacity: 0,
                    duration: 0.4,
                    stagger: 0.05,
                    ease: "power2.out",
                },
                "-=0.2",
            );

        // Toggle Logic
        menuToggle.addEventListener("click", () => {
            if (!isMenuOpen) {
                tl.play();
                document.body.style.overflow = "hidden"; // Prevent scrolling
                isMenuOpen = true;
                menuToggle.setAttribute("aria-label", "Close Menu");
            } else {
                tl.reverse();
                document.body.style.overflow = ""; // Restore scrolling
                isMenuOpen = false;
                menuToggle.setAttribute("aria-label", "Open Menu");
            }
        });
    }

    // Smart Sticky Header Logic
    const header = document.querySelector(".site-header");
    let lastScrollY = window.scrollY;
    let isHeaderHidden = false;

    if (header) {
        // Initial check to set filler height or body padding if needed
        // For now, we rely on the header being overlay or having a spacer.
        // Since we are changing to fixed, we might need a spacer div in the layout or body padding.
        // However, the design seems to have a lot of top padding on pages anyway.
        // Let's just handle the show/hide.

        const handleScroll = () => {
            const currentScrollY = window.scrollY;

            // Show header if scrolling up or at the very top
            if (currentScrollY < lastScrollY || currentScrollY < 50) {
                if (isHeaderHidden) {
                    gsap.to(header, {
                        y: "0%",
                        duration: 0.3,
                        ease: "power2.out",
                    });
                    isHeaderHidden = false;
                }
            }
            // Hide header if scrolling down and past the top threshold
            else if (currentScrollY > lastScrollY && currentScrollY > 100) {
                if (!isHeaderHidden) {
                    gsap.to(header, {
                        y: "-100%",
                        duration: 0.3,
                        ease: "power2.in",
                    });
                    isHeaderHidden = false; // logic correction: hiding means we want to animate out
                    // Actually, let's track state better.
                    // If we want to hide, we animate blindly? No.
                    isHeaderHidden = true;
                }
            }

            lastScrollY = currentScrollY;
        };

        window.addEventListener("scroll", handleScroll, { passive: true });
    }
</script>
