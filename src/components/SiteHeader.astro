        }

        .header-actions {
            gap: 16px;
        }

        /* 3. Hamburger/Close Toggle */
        #menu-toggle {
            display: block;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            color: var(--color-navy-500); /* Was #15499d */
        }
    }

    /* Mobile Overlay Styles (Global) */
    #mobile-menu-overlay {
