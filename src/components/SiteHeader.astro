        display: flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 1024px) {
        .header-socials {
            display: none;
        }
    }

    .header-socials a {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 44px; /* Touch target */
        height: 44px;
        color: var(--color-navy-500); /* Was #15499d */
        transition:
            transform 0.2s,
            opacity 0.2s;
    }

    .icon-social {
        width: 20px;
        height: 20px;
        transition: transform 0.2s;
    }

    .icon-social:hover {
        transform: scale(1.1);
    }

    .icon-container {
        position: relative;
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-menu,
    .icon-close {
        width: 24px;
        height: 24px;
        position: absolute;
        top: 0;
        left: 0;
        transition: opacity 0.3s ease;
    }

