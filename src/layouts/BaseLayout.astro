---
import "../styles/global.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import Analytics from "../components/seo/Analytics.astro";
import JSONLD from "../components/seo/JSONLD.astro";
import ThemeManager from "../components/ui/ThemeManager.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description = "Welcome to the amiiverse." } = Astro.props;
import { fetchGlobalSettings } from "../utils/global";
const settings = await fetchGlobalSettings();
---

<!doctype html>
<html lang="en" data-theme="sun">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <ThemeManager />

        <!-- Dynamic Favicons (SSR Failure/Default) -->
        {
            settings.favicons?.ico && (
                <link
                    rel="icon"
                    type="image/x-icon"
                    href={settings.favicons.ico}
                />
            )
        }
        {
            settings.favicons?.svg && (
                <link
                    rel="icon"
                    type="image/svg+xml"
                    href={settings.favicons.svg}
                />
            )
        }
        {
            settings.favicons?.png96 && (
                <link
                    rel="icon"
                    type="image/png"
                    sizes="96x96"
                    href={settings.favicons.png96}
                />
            )
        }
        {
            settings.favicons?.apple && (
                <link
                    rel="apple-touch-icon"
                    sizes="180x180"
                    href={settings.favicons.apple}
                />
            )
        }

        <link rel="manifest" href="/manifest.json" />

        <meta name="generator" content={Astro.generator} />
        <title>{title} | amiiverse</title>

        <!-- Open Graph / SEO -->
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:site_name" content="amiiverse" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />

        <!-- Keywords (AI/SEO) -->
        {
            settings.keywords && (
                <meta name="keywords" content={settings.keywords.join(", ")} />
            )
        }

        <!-- Structured Data -->
        <JSONLD />

        <Analytics />
    </head>
    <body>
        <SiteHeader />
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>

<style>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding-top: var(
            --header-height,
            100px
        ); /* Account for fixed header + spacing */
    }
</style>
