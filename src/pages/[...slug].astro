---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBuilder from "../components/PageBuilder.astro";
import { getSanityContent, PAGE_QUERY } from "../utils/sanity";

const { slug } = Astro.params;
const currentSlug = slug === undefined ? "home" : slug;

const page = await getSanityContent(PAGE_QUERY, { slug: currentSlug });

if (!page) {
    return Astro.redirect("/404");
}

const blocks = page.blocks || [];
const title = page.title;
---

<BaseLayout title={title}>
    <div class="page-container">
        <PageBuilder blocks={blocks} />
    </div>
</BaseLayout>
