---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";

const members = [
    {
        name: "Member 1",
        role: "Vocal",
        fact: "Loves cats",
        image: "/assets/placeholder-member1.jpg",
    },
    {
        name: "Member 2",
        role: "Dance",
        fact: "Hates cilantro",
        image: "/assets/placeholder-member2.jpg",
    },
    {
        name: "Member 3",
        role: "Rap",
        fact: "Gamer",
        image: "/assets/placeholder-member3.jpg",
    },
];
---

<BaseLayout title="About" description="Get to know Amii.">
    <!-- Hero / Intro Section -->
    <section class="about-hero container">
        <div class="hero-image-wrapper">
            <!-- Oval Image Mask -->
            <div class="oval-mask">
                <img
                    src="/assets/placeholder-group.jpg"
                    alt="Amii Group Photo"
                />
            </div>
        </div>

        <div class="hero-content text-center">
            <h1 class="page-title">
                WE ARE <span class="star-icon">★</span> AMII
            </h1>
            <p class="intro-text">
                amii is a girl group built on friendship, growth, and real
                connection. Our music is honest, playful, and rooted in shared
                experiences.
                <br />
                Ordinary People is the beginning.
            </p>
        </div>
    </section>

    <!-- Memories / Gallery Section -->
    <section class="memories-section container">
        <h2 class="section-title text-center">ORDINARY PEOPLE MEMORIES</h2>

        <div class="memories-grid">
            <!-- 3 Photos as per design -->
            <div class="memory-item">
                <img src="/assets/placeholder-memory1.jpg" alt="Memory 1" />
            </div>
            <div class="memory-item">
                <img src="/assets/placeholder-memory2.jpg" alt="Memory 2" />
            </div>
            <div class="memory-item">
                <img src="/assets/placeholder-memory3.jpg" alt="Memory 3" />
            </div>
        </div>
    </section>

    <NewsletterForm />
</BaseLayout>

<style>
    .about-hero {
        padding-block: var(--space-lg);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
    }

    .hero-image-wrapper {
        width: 100%;
        max-width: 800px;
        aspect-ratio: 16/9; /* Or whatever fits the oval */
        position: relative;
    }

    .oval-mask {
        width: 100%;
        height: 100%;
        background-color: #ccc; /* Placeholder */
        border-radius: 50%; /* Oval */
        overflow: hidden;
        border: 4px solid var(--color-navy-500);
        /* Since aspect ratio is rectangle, radius 50% makes it an oval. */
    }

    .oval-mask img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .page-title {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: clamp(2.5rem, 6vw, 4rem);
        color: var(--color-blue-500); /* Specific blue title in design? */
        /* "WE ARE AMII" looks blue in the design ref? Or Navy? */
        /* Let's stick to Navy or Blue loop variable. I'll use text-current for now to be safe, or Blue as accent. */
        color: var(--color-navy-500);
        margin-bottom: var(--space-sm);
    }

    .star-icon {
        color: var(--color-blue-500); /* Small star in title */
    }

    .intro-text {
        max-width: 60ch;
        font-size: clamp(1rem, 1.5vw, 1.25rem);
        line-height: 1.6;
        font-weight: 500;
    }

    .memories-section {
        padding-bottom: var(--space-xl);
    }

    .section-title {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(
            --color-navy-500
        ); /* "ORDINARY PEOPLE MEMORIES" is blue/navy */
        margin-bottom: var(--space-md);
    }

    .memories-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: var(--space-sm);
    }

    .memory-item img {
        width: 100%;
        height: auto;
        border-radius: var(
            --radius-card
        ); /* Maybe smaller radius for photos? */
        border: 2px solid var(--color-navy-500);
    }
</style>
