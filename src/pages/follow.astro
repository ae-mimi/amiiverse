---
import BaseLayout from "../layouts/BaseLayout.astro";

const links = [
    {
        label: 'STREAM "ORDINARY PEOPLE"',
        url: "#",
        icon: "🎵",
        type: "primary",
    },
    { label: "WATCH THE MUSIC VIDEO", url: "#", icon: "📺", type: "secondary" },
    { label: "TIKTOK", url: "#", icon: "📱", type: "default" },
    { label: "INSTAGRAM", url: "#", icon: "📸", type: "default" },
    {
        label: "JOIN THE AMII-GOS",
        url: "/contact",
        icon: "💌",
        type: "default",
    },
];
---

<BaseLayout title="Follow Amii">
    <div class="container follow-container">
        <div class="profile text-center">
            <div class="avatar">
                <img src="/assets/placeholder-group-square.jpg" alt="Amii" />
            </div>
            <h1 class="handle">@amiiverse</h1>
            <p class="bio">Ordinary People doing extraordinary things.</p>
        </div>

        <div class="links-stack">
            {
                links.map((link) => (
                    <a href={link.url} class={`link-btn type-${link.type}`}>
                        <span class="icon">{link.icon}</span>
                        <span class="label">{link.label}</span>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .follow-container {
        padding-block: var(--space-lg);
        max-width: 600px; /* Mobile focused width */
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        margin-inline: auto;
        margin-bottom: 1rem;
        border: 3px solid var(--color-navy-500);
    }
    .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .handle {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .links-stack {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 2rem;
    }

    .link-btn {
        display: flex;
        align-items: center;
        justify-content: center; /* Centered or space-between? Centered usually for linktree */
        gap: 1rem;
        padding: 1.25rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 900;
        border: 3px solid var(--color-navy-500);
        transition:
            transform 0.2s,
            box-shadow 0.2s;
        color: var(--color-navy-500);
        background: transparent;
    }

    .link-btn:hover {
        transform: scale(1.02);
        box-shadow: 4px 4px 0 var(--color-navy-500);
    }

    .type-primary {
        background-color: var(--color-navy-500);
        color: var(--color-yellow-500);
    }

    .type-secondary {
        background-color: var(--color-pink-500);
        border-color: var(--color-pink-500);
        color: white; /* Or Navy? */
        color: var(--color-navy-500);
    }
</style>
