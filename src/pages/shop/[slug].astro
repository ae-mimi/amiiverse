---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGallery from "../../components/shop/ProductGallery.astro";
import ProductInfo from "../../components/shop/ProductInfo.astro";

export const prerender = false;

interface ShopProduct {
    id: string;
    slug: string;
    title: string;
    description: string;
    product_type: "physical" | "digital";
    cover_image_url: string;
    is_active: number;
}

interface ProductVariant {
    id: string;
    title?: string;
    price_ngn: number;
    price_minor: number;
    currency: "NGN" | "USD" | "GBP";
    options?: Record<string, string>;
    stock?: { available: number; is_in_stock: boolean };
}

const { slug } = Astro.params;
let product: ShopProduct | null = null;
let variants: ProductVariant[] = [];

if (slug) {
    try {
        const apiUrl = new URL("/api/shop/product", Astro.url);
        apiUrl.searchParams.set("slug", slug);

        const response = await fetch(apiUrl.toString());
        if (response.ok) {
            const data = (await response.json()) as {
                product?: ShopProduct;
                variants?: ProductVariant[];
            };
            if (data.product) {
                product = data.product;
                variants = Array.isArray(data.variants) ? data.variants : [];
            }
        }
    } catch (error) {
        console.error("[shop/[slug]] Failed to load product from D1 API", error);
    }
}

const hasProduct = Boolean(product);
const allImages = product?.cover_image_url ? [product.cover_image_url] : [];
const firstVariant = variants.find((variant) => variant?.id) ?? null;
const price = Number(firstVariant?.price_ngn ?? 0);
const productType = product?.product_type ?? "physical";
const productId = product?.id ?? "";
const variantId = firstVariant?.id ?? "";
const stock = Number(firstVariant?.stock?.available ?? 0);
const totalVariants = variants.filter((variant) => variant?.id).length;

// Map Sanity content to Accordion Data
const accordionData: Record<string, string> = {};

if (product?.description) {
    accordionData["Product Description"] = String(product.description);
}

accordionData["Shipping & Delivery"] =
    "Delivery takes 2-5 working days within Nigeria. International shipping varies by location.";
accordionData["Refund Policy"] =
    "Items can be returned within 7 days of delivery if they are in original condition. Digital assets are non-refundable.";
---

<BaseLayout
   title={hasProduct ? product!.title : "Shop Product"}
   description={String(product?.description || "Shop item")}
>
   {
      hasProduct ? (
         <main class="productPage pdpShell">
            <nav class="productBreadcrumb pdpContainer mb-4" aria-label="Breadcrumb">
               <a href="/shop" class="text-secondary text-sm">Shop</a>
               <span class="mx-2 opacity-5">/</span>
               <a
                  href="/shop"
                  class="uppercase text-secondary text-sm"
                  >{productType || "Physical"}</a
               >
               <span class="mx-2 opacity-5">/</span>
               <span class="current text-sm font-weight-bold">{product!.title}</span>
            </nav>

            <div class="pdpContainer">
               <section class="pdpHero">
                  <div class="pdpGalleryColumn">
                     <ProductGallery images={allImages} title={product!.title} />
                  </div>

                  <div class="pdpInfoColumn">
                     <ProductInfo
                        title={product!.title}
                        description={product!.description}
                        price={price}
                        productType={productType}
                        productId={productId}
                        variantId={variantId}
                        stock={stock}
                        variants={variants}
                        totalVariants={totalVariants}
                        image={allImages[0] || ""}
                        accordionData={accordionData}
                    />
                  </div>
               </section>
            </div>
         </main>
      ) : (
         <main class="productPage py-5">
            <div class="container">
               <p>No products available.</p>
            </div>
         </main>
      )
   }
</BaseLayout>

<style>
   .pdpShell {
      padding: 2rem 0 5rem;
   }
   .pdpContainer {
      width: min(1240px, calc(100% - 2rem));
      margin: 0 auto;
   }
   .productBreadcrumb a {
      text-decoration: none;
   }
   .productBreadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      color: var(--color-text-muted);
   }
   .productBreadcrumb .current {
      color: var(--color-primary);
   }
   .productBreadcrumb .uppercase {
      text-transform: uppercase;
   }
   .productPage {
      min-height: 80vh;
      background-color: var(--color-bg);
   }
   .pdpHero {
      display: grid;
      gap: 2rem;
      align-items: start;
   }
   .pdpGalleryColumn,
   .pdpInfoColumn {
      min-width: 0;
   }
   @media (min-width: 1024px) {
      .pdpHero {
         grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
         gap: 2.25rem;
      }
      .pdpInfoColumn {
         position: sticky;
         top: 1.5rem;
      }
   }
   .opacity-5 {
      opacity: 0.5;
   }
   .mx-2 {
      margin-left: 0.5rem;
      margin-right: 0.5rem;
   }
   .digital-note {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-primary);
   }
</style>
