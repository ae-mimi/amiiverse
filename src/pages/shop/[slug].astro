---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchSanity } from "../../lib/sanity/client";
import { urlFor } from "../../lib/sanity/image";
import ProductGallery from "../../components/shop/ProductGallery.astro";
import ProductInfo from "../../components/shop/ProductInfo.astro";
import { toPlainText } from "@portabletext/toolkit";

export const prerender = false;

const { slug } = Astro.params;

const product = await fetchSanity(
   `*[_type == "product" && slug.current == $slug][0]{
      ...,
      "productId": _id
  }`,
   { slug },
);

if (!product) {
   return Astro.redirect("/404");
}

const allImages = [product.coverImage, ...(product.galleryImages || [])].filter(
   Boolean,
);

// Map Sanity content to Accordion Data
const accordionData: Record<string, string> = {};

if (product.description) {
   accordionData["Product Description"] = toPlainText(product.description);
}

// Add fallback or extra info if available in schema
accordionData["Shipping & Delivery"] =
   "Delivery takes 2-5 working days within Nigeria. International shipping varies by location.";
accordionData["Refund Policy"] =
   "Items can be returned within 7 days of delivery if they are in original condition. Digital assets are non-refundable.";

const stock = product.stock;
const price = product.price;
---

<BaseLayout
   title={product.title}
   description={product.shortDescription || "Shop item"}
>
   <main class="productPage py-5">
      <!-- Breadcrumbs -->
      <nav class="productBreadcrumb container mb-4" aria-label="Breadcrumb">
         <a href="/shop" class="text-secondary text-sm">Shop</a>
         <span class="mx-2 opacity-5">/</span>
         <a
            href={`/shop?filter=${product.productType || "physical"}`}
            class="uppercase text-secondary text-sm"
            >{product.productType || "Physical"}</a
         >
         <span class="mx-2 opacity-5">/</span>
         <span class="current text-sm font-weight-bold">{product.title}</span>
      </nav>

      <div class="container">
         <div class="row g-5">
            <!-- LEFT: Gallery -->
            <div class="col-12 col-lg-7">
               <ProductGallery images={allImages} title={product.title} />
            </div>

            <!-- RIGHT: Buy Panel + Details -->
            <div class="col-12 col-lg-5">
               <ProductInfo
                  title={product.title}
                  price={price}
                  productType={product.productType || "physical"}
                  stock={stock}
                  productId={product.productId}
                  image={urlFor(allImages[0])}
                  accordionData={accordionData}
               />
            </div>
         </div>
      </div>
   </main>
</BaseLayout>

<style>
   .productBreadcrumb a {
      text-decoration: none;
   }
   .productBreadcrumb .uppercase {
      text-transform: uppercase;
   }
   .productPage {
      min-height: 80vh;
      background-color: var(--color-bg);
   }
   .opacity-5 {
      opacity: 0.5;
   }
   .mx-2 {
      margin-left: 0.5rem;
      margin-right: 0.5rem;
   }
</style>
