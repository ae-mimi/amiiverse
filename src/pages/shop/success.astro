---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityWriteClient } from "../../lib/sanity/client";
import { Icon } from "astro-icon/components";

const reference = Astro.url.searchParams.get("reference");
const PAYSTACK_SECRET_KEY = import.meta.env.PAYSTACK_SECRET_KEY;

let orderStatus = "loading";
let orderData = null;

if (reference) {
    try {
        // 1. Verify transaction with Paystack
        const response = await fetch(
            `https://api.paystack.co/transaction/verify/${reference}`,
            {
                headers: {
                    Authorization: `Bearer ${PAYSTACK_SECRET_KEY}`,
                },
            },
        );

        const data = await response.json();

        if (data.status && data.data.status === "success") {
            orderStatus = "paid";

            // 2. Update Sanity Order
            const orders = await sanityWriteClient.fetch(
                `*[_type == "order" && reference == $reference]{
                  ...,
                  "productType": productSnapshot.productType
                }`,
                { reference },
            );

            if (orders.length > 0) {
                orderData = orders[0];
                if (orderData.status !== "paid") {
                    await sanityWriteClient
                        .patch(orderData._id)
                        .set({
                            status: "paid",
                            paystackResponse: {
                                data: JSON.stringify(data.data),
                            },
                        })
                        .commit();
                }
            }
        } else {
            orderStatus = "failed";
            const orders = await sanityWriteClient.fetch(
                `*[_type == "order" && reference == $reference]`,
                { reference },
            );
            if (orders.length > 0) {
                await sanityWriteClient
                    .patch(orders[0]._id)
                    .set({ status: "failed" })
                    .commit();
            }
        }
    } catch (error) {
        console.error("[Verification Error]:", error);
        orderStatus = "error";
    }
} else {
    orderStatus = "no_reference";
}

const isDigital = orderData?.productType === "digital";
---

<BaseLayout title="Order Status">
    <main class="success-page">
        <div class="container py-xl text-center">
            {
                orderStatus === "paid" && (
                    <div class="status-card success">
                        <div class="icon-wrapper success">
                            <Icon
                                name="lucide:check-circle"
                                class="status-icon"
                            />
                        </div>
                        <h1 class="uppercase">Payment Successful</h1>
                        <p class="status-message">
                            Your order has been confirmed. A confirmation email
                            has been sent to <strong>{orderData?.email}</strong>
                            .
                        </p>

                        {orderData && (
                            <div
                                class="order-summary mt-lg"
                                id="printable-summary"
                            >
                                <div class="summary-header">
                                    <h3>Order Summary</h3>
                                    <button
                                        class="print-btn"
                                        onclick="window.print()"
                                    >
                                        <Icon name="lucide:printer" />
                                        <span>Print Receipt</span>
                                    </button>
                                </div>
                                <div class="summary-details">
                                    <div class="detail-row">
                                        <span>Product</span>
                                        <strong>
                                            {orderData.productSnapshot.title}
                                        </strong>
                                    </div>
                                    <div class="detail-row">
                                        <span>Amount Paid</span>
                                        <strong>
                                            ₦{orderData.amount.toLocaleString()}
                                        </strong>
                                    </div>
                                    <div class="detail-row">
                                        <span>Reference</span>
                                        <code class="ref-code">
                                            {reference}
                                        </code>
                                    </div>
                                </div>
                            </div>
                        )}

                        <div class="actions-group mt-lg">
                            {isDigital && (
                                <a
                                    href={`/api/paystack/download?reference=${reference}`}
                                    class="btn-action download"
                                    download
                                >
                                    <Icon name="lucide:download" />
                                    DOWNLOAD PURCHASE
                                </a>
                            )}
                            <a href="/shop" class="btn-action secondary">
                                <Icon name="lucide:shopping-bag" />
                                BACK TO SHOP
                            </a>
                        </div>

                        <p class="email-notice">
                            Please check your spam folder if you don't see the
                            confirmation email within 5 minutes.
                        </p>
                    </div>
                )
            }

            {
                orderStatus === "failed" && (
                    <div class="status-card failed">
                        <div class="icon-wrapper failed">
                            <Icon name="lucide:x-circle" class="status-icon" />
                        </div>
                        <h1 class="uppercase">Payment Failed</h1>
                        <p>
                            We couldn't process your payment. No funds were
                            captured.
                        </p>
                        <div class="actions-group mt-lg">
                            <a href="/shop" class="btn-action primary">
                                TRY AGAIN
                            </a>
                        </div>
                    </div>
                )
            }

            {
                orderStatus === "error" && (
                    <div class="status-card error">
                        <div class="icon-wrapper error">
                            <Icon
                                name="lucide:alert-triangle"
                                class="status-icon"
                            />
                        </div>
                        <h1 class="uppercase">Verification Error</h1>
                        <p>
                            Something went wrong while verifying your payment.
                            Please contact support with your reference:
                            <code class="ref-code">{reference}</code>
                        </p>
                    </div>
                )
            }

            {
                orderStatus === "no_reference" && (
                    <div class="status-card">
                        <h1 class="uppercase">Invalid session</h1>
                        <p>
                            No payment reference found. If you just completed a
                            purchase, please check your email.
                        </p>
                        <div class="actions-group mt-lg">
                            <a href="/shop" class="btn-action secondary">
                                GO TO SHOP
                            </a>
                        </div>
                    </div>
                )
            }
        </div>
    </main>
</BaseLayout>

<style>
    .success-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        background-color: var(--bg-page);
    }

    .status-card {
        background: rgba(255, 255, 255, 0.02);
        padding: clamp(2rem, 5vw, 4rem);
        border-radius: var(--radius-card);
        max-width: 650px;
        margin: 0 auto;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .icon-wrapper {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
    }

    .icon-wrapper.success {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
    }
    .icon-wrapper.failed {
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }
    .icon-wrapper.error {
        background: rgba(245, 158, 11, 0.1);
        color: #f59e0b;
    }

    .status-icon {
        width: 48px;
        height: 48px;
    }

    h1 {
        font-size: 2rem;
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
        color: var(--color-primary);
    }

    .status-message {
        font-size: 1.1rem;
        opacity: 0.8;
        max-width: 45ch;
        margin: 0 auto 2.5rem;
    }

    .order-summary {
        background: rgba(255, 255, 255, 0.03);
        padding: 2rem;
        border-radius: 16px;
        text-align: left;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .summary-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .summary-header h3 {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin: 0;
        opacity: 0.6;
    }

    .print-btn {
        background: none;
        border: none;
        color: var(--color-primary);
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 700;
        cursor: pointer;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .print-btn:hover {
        opacity: 1;
    }
    .print-btn [data-icon] {
        width: 16px;
    }

    .summary-details {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.95rem;
    }

    .detail-row span {
        opacity: 0.5;
    }

    .ref-code {
        font-family: monospace;
        background: rgba(255, 255, 255, 0.05);
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.85rem;
    }

    .actions-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 1.25rem;
        border-radius: var(--radius-pill);
        font-family: var(--font-heading);
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-action.primary,
    .btn-action.download {
        background: var(--color-primary);
        color: var(--color-bg);
    }

    .btn-action.secondary {
        background: rgba(255, 255, 255, 0.05);
        color: var(--color-text);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn-action:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .email-notice {
        font-size: 0.8rem;
        opacity: 0.4;
        margin-top: 2rem;
    }

    .py-xl {
        padding-block: 6rem;
    }

    /* Print Overrides */
    @media print {
        body * {
            visibility: hidden;
        }
        #printable-summary,
        #printable-summary * {
            visibility: visible;
        }
        #printable-summary {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: white !important;
            color: black !important;
            border: 1px solid #ccc !important;
        }
        .print-btn {
            display: none;
        }
        .ref-code {
            background: #eee !important;
            color: black !important;
        }
    }
</style>
