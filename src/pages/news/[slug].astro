---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { fetchSanity } from "../../lib/sanity/client";
import { POST_QUERY } from "../../lib/sanity/queries";
import { urlFor } from "../../lib/sanity/image";
import { formatDate } from "../../lib/utils/format";
import type { Post } from "../../lib/sanity/types";

const { slug } = Astro.params;
const post = await fetchSanity<Post>(POST_QUERY, { slug });

if (!post) {
    Astro.response.status = 404;
}
---

<BaseLayout title={post?.title || "News Not Found"}>
    {
        post ? (
            <article class="news-post">
                <header class="news-post__header">
                    {post.category && <p class="news-post__category">{post.category.replace(/([A-Z])/g, " $1")}</p>}
                    <h1>{post.title}</h1>
                    {post.publishedAt && <time>{formatDate(post.publishedAt)}</time>}
                    {post.excerpt && <p class="news-post__excerpt">{post.excerpt}</p>}
                </header>

                {post.coverImage && (
                    <img class="news-post__image" src={urlFor(post.coverImage)} alt={post.title} />
                )}

                {post.content && (
                    <div class="news-post__body">
                        {post.content.split("\n").filter(Boolean).map((paragraph) => (
                            <p>{paragraph}</p>
                        ))}
                    </div>
                )}
            </article>
        ) : (
            <main class="news-post news-post--missing">
                <h1>News Not Found</h1>
                <a href="/">Back Home</a>
            </main>
        )
    }
</BaseLayout>

<style>
    .news-post {
        max-width: 860px;
        margin: 0 auto;
        padding: clamp(3rem, 8vw, 7rem) 1.5rem;
    }

    .news-post__header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .news-post__category,
    .news-post time {
        display: block;
        margin-bottom: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 800;
    }

    .news-post h1 {
        margin: 0 0 1rem;
        font-family: var(--font-heading);
        font-size: clamp(3rem, 8vw, 6rem);
        color: var(--text-main);
        line-height: 0.95;
    }

    .news-post__excerpt {
        max-width: 64ch;
        margin: 1rem auto 0;
        color: var(--text-muted);
        line-height: 1.6;
    }

    .news-post__image {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 1rem;
        margin-bottom: 2rem;
    }

    .news-post__body {
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        line-height: 1.8;
    }

    .news-post__body p {
        margin: 0 0 1.2rem;
    }

    .news-post--missing a {
        color: var(--color-primary);
        font-weight: 800;
    }
</style>
