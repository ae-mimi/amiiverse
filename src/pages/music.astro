---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlayerWidget from "../components/PlayerWidget.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
---

<BaseLayout title="Music" description="Stream Ordinary People by Amii.">
    <div class="container music-container text-center">
        <h1 class="page-title">MUSIC</h1>

        <div class="hero-release">
            <h2 class="release-title">ORDINARY PEOPLE</h2>
            <h3 class="cta-text">STREAM NOW!</h3>

            <div class="platform-buttons">
                <a href="#" class="btn btn-primary">Listen on Spotify</a>
                <a href="#" class="btn btn-outline">See All Platforms</a>
            </div>

            <div class="player-wrapper">
                <PlayerWidget />
            </div>
        </div>

        <section class="other-releases">
            <h2 class="section-title">OTHER RELEASES</h2>
            <p>More music coming soon...</p>
            <div class="social-icons">
                <!-- Repeat social icons logic or import footer component? -->
                <!-- Reuse socials -->
                <span>TikTok</span>
                <span>Spotify</span>
                <span>YouTube</span>
            </div>
        </section>

        <NewsletterForm />
    </div>
</BaseLayout>

<style>
    .music-container {
        padding-block: var(--space-lg);
    }

    .page-title {
        font-family: var(
            --font-heading
        ); /* Standard layout doesn't usually show H1 "MUSIC" big, usually the release title. */
        /* But Image 3 shows "MUSIC" at top */
        font-weight: 900;
        color: var(--color-navy-500);
        margin-bottom: var(--space-md);
    }

    .release-title {
        font-family: var(--font-heading);
        font-size: clamp(3rem, 10vw, 6rem);
        font-weight: 900;
        color: var(--color-pink-500); /* Bubble letter style in image? */
        text-shadow: 3px 3px 0 var(--color-navy-500); /* Graphic effect simulation */
        line-height: 0.9;
        margin-bottom: var(--space-sm);
    }

    .cta-text {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 2rem;
        color: var(--color-navy-500);
        margin-bottom: var(--space-md);
    }

    .platform-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-bottom: var(--space-lg);
        flex-wrap: wrap;
    }

    .btn-outline {
        border: 2px solid var(--color-navy-500);
        color: var(--color-navy-500);
        text-decoration: none;
        padding: 0.75em 2em;
        border-radius: var(--radius-button);
        font-weight: 700;
        text-transform: uppercase;
    }

    .player-wrapper {
        margin-bottom: var(--space-xl);
    }

    .section-title {
        font-family: var(--font-heading);
        font-weight: 900;
        font-size: 2rem;
        color: var(--color-navy-500);
        margin-bottom: 1rem;
    }
</style>
