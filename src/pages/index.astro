---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBuilder from "../components/PageBuilder.astro";
import { getEntry } from "astro:content";

const homePage = await getEntry("pages", "home");
const blocks = homePage?.data.blocks || [];
---

<BaseLayout
	title={homePage?.data.title || "Home"}
	description="Welcome to Amiiverse."
>
	<div class="home-container">
		<PageBuilder blocks={blocks} />
	</div>
</BaseLayout>
